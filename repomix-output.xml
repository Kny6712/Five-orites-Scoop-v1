<!-- src/app/features/products/product-detail/product-detail.page.html -->

<ion-header>
  <ion-toolbar color="primary">
    <ion-buttons slot="start">
      <ion-back-button defaultHref="/products" text="Flavors"></ion-back-button>
    </ion-buttons>
    <ion-title>{{ product()?.variantName ?? 'Product Detail' }}</ion-title>
    <ion-buttons slot="end">
      <app-cart-button></app-cart-button>
    </ion-buttons>
  </ion-toolbar>
</ion-header>

<ion-content fullscreen>
  @if (isLoading()) {
    <ion-skeleton-text animated class="hero-skeleton"></ion-skeleton-text>
    <div class="detail-body">
      <ion-skeleton-text animated style="height: 24px; width: 70%; margin-bottom: 8px"></ion-skeleton-text>
      <ion-skeleton-text animated style="height: 140px"></ion-skeleton-text>
    </div>
  }

  @if (!isLoading() && errorMessage()) {
    <div class="error-state">
      <p>{{ errorMessage() }}</p>
    </div>
  }

  @if (!isLoading() && product()) {
    <div class="hero-wrap">
      <img
        [src]="(product()!.imageUrl | cloudinary: 1000) || '/assets/placeholder-scoop.svg'"
        [alt]="product()!.variantName"
        class="hero-image"
        onerror="this.src = '/assets/placeholder-scoop.svg'"
      />
      <div class="hero-overlay">
        <ion-badge class="set-badge-hero"> Set {{ product()!.setNumber }} · {{ product()!.setName }} </ion-badge>
      </div>
    </div>

    <div class="detail-body">
      <h1 class="detail-name">{{ product()!.variantName }}</h1>

      @if (isUnavailable()) {
        <div class="error-state" role="alert">
          <p>This flavor is no longer available and cannot be ordered.</p>
        </div>
      }
      <app-star-rating [rating]="avgRating()" [showCount]="true" [reviewCount]="reviewCount()"></app-star-rating>
      <ion-button fill="outline" size="small" class="wishlist-btn" (click)="toggleWishlist()">
        <app-icon name="heart" slot="start" class="wishlist-icon" [class.wished]="isWished()" />
        {{ isWished() ? 'Wishlisted' : 'Wishlist' }}
      </ion-button>
      <p class="detail-description">{{ product()!.description }}</p>

      <h2 class="section-title">Choose Your Size</h2>
      <div class="size-grid">
        @for (opt of sizeOptions; track opt.key) {
          <button
            class="size-tile"
            [class.selected]="selectedSize() === opt.key"
            [class.out-of-stock]="product()!.stock[opt.key] === 0"
            (click)="selectSize(opt.key)"
            [attr.aria-pressed]="selectedSize() === opt.key"
          >
            <span class="tile-size">{{ opt.label }}</span>
            <span class="tile-price">{{ product()!.pricing[opt.key] | peso }}</span>
            <span
              class="tile-stock"
              [class.stock-in-stock]="product()!.stock[opt.key] >= lowStockThreshold()"
              [class.stock-low-stock]="product()!.stock[opt.key] > 0 && product()!.stock[opt.key] < lowStockThreshold()"
              [class.stock-out-of-stock]="product()!.stock[opt.key] === 0"
            >
              {{
                product()!.stock[opt.key] === 0
                  ? 'Out of Stock'
                  : product()!.stock[opt.key] < lowStockThreshold()
                    ? 'Low Stock (' + product()!.stock[opt.key] + ')'
                    : 'In Stock'
              }}
            </span>
          </button>
        }
      </div>

      <div class="qty-row">
        <span class="qty-label">Quantity</span>
        <!-- Shared stepper, replacing a 32x32 hand-rolled pair. The ceiling is
             the live stock, so the button disables itself at the limit. -->
        <app-qty-stepper [value]="quantity()" [max]="stepperMax()" (changed)="quantity.set($event)" />
        <span class="line-total">{{ lineTotal() | peso }}</span>
      </div>

      <ion-button
        expand="block"
        class="add-to-cart-cta"
        [disabled]="!canPurchase() || isAdding()"
        (click)="addToCart()"
      >
        <app-icon name="cart" slot="start" />
        {{
          isAdding()
            ? 'Adding...'
            : isUnavailable()
              ? 'No Longer Available'
              : isOutOfStock()
                ? 'Out of Stock'
                : 'Add to Cart'
        }}
      </ion-button>

      <div class="reviews-section">
        <h2 class="section-title">Customer Reviews</h2>
        @if (reviewsError()) {
          <div class="reviews-empty">
            <app-star-rating [rating]="0" [showCount]="false"></app-star-rating>
            <p class="error-state" role="alert">{{ reviewsError() }}</p>
          </div>
        } @else if (reviews().length === 0) {
          <div class="reviews-empty">
            <app-star-rating [rating]="0" [showCount]="true" [reviewCount]="0"></app-star-rating>
            <p class="no-reviews">No reviews yet — be the first!</p>
          </div>
        } @else {
          @if (reviewsTruncated()) {
            <p class="reviews-truncated">Showing the most recent {{ reviews().length }} reviews.</p>
          }
          @for (r of pagedReviews(); track r.id) {
            <div class="review-item">
              <app-star-rating [rating]="r.rating"></app-star-rating>
              <p class="review-author">{{ r.displayName }}</p>
              <p class="review-comment">{{ r.comment }}</p>
              @if (r.userId === currentUserId()) {
                <ion-button
                  size="small"
                  fill="clear"
                  color="medium"
                  class="withdraw-review-btn"
                  type="button"
                  (click)="withdrawReview(r)"
                  [disabled]="isSubmittingReview()"
                >
                  <app-icon name="trash" slot="start" />
                  Withdraw
                </ion-button>
              }
            </div>
          }
          <!--
            Pages the RENDER only. The stars above the fold and the "(n)" beside
            them still come from summarizeRatings() over every fetched review, so
            paging cannot move an average.
          -->
          <app-pagination
            [page]="reviewsPage()"
            [total]="reviews().length"
            [pageSize]="REVIEWS_PER_PAGE"
            itemLabel="reviews"
            (pageChange)="reviewsPage.set($event)"
          />
        }
        <div class="review-form">
          <h3 class="section-title">{{ hasMyReview() ? 'Update your review' : 'Write a review' }}</h3>
          @if (hasMyReview()) {
            <p class="review-form-note">
              You already reviewed this flavor. Submitting again updates your existing review.
            </p>
          }
          <app-star-rating
            [rating]="newRating()"
            [interactive]="true"
            (ratingChange)="newRating.set($event)"
          ></app-star-rating>
          <ion-textarea
            id="review-comment"
            [(ngModel)]="newComment"
            placeholder="What did you love?"
            aria-label="Review comment"
            rows="2"
          ></ion-textarea>
          <ion-button expand="block" (click)="submitReview()" [disabled]="isSubmittingReview()">
            {{ isSubmittingReview() ? 'Submitting...' : 'Submit Review' }}
          </ion-button>
        </div>
      </div>
    </div>
  }
  <app-footer></app-footer>
</ion-content>
</file>

