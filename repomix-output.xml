// ── Filters ─────────────────────────────────────────────
.filters {
  padding: var(--space-4) var(--space-4) var(--space-2);
}

.search-wrap {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  background: var(--color-white);
  border-radius: var(--radius-pill);
  padding: 0 var(--space-4);
  box-shadow: var(--shadow-card);
  /* 48px, comfortably past the 44px touch-target guidance — this is the primary
     control on the page and people reach for it one-handed. */
  min-height: 48px;
}

.search-icon {
  --icon-size: 18px;
  color: var(--ion-color-medium);
  flex: 0 0 auto;
}

.role-chips {
  display: flex;
  gap: var(--space-2);
  margin-top: var(--space-3);
  flex-wrap: wrap;
}

.role-chip {
  min-height: 38px;
  padding: 0 var(--space-4);
  border-radius: var(--radius-pill);
  border: 1px solid var(--color-primary-ink);
  background: transparent;
  color: var(--color-primary-ink);
  font: inherit;
  font-size: 13px;
  font-weight: 700;
  cursor: pointer;
  transition:
    background-color 0.15s ease,
    color 0.15s ease;
}

.role-chip.active {
  background: var(--color-brand-primary);
  color: var(--color-ink);
}

// ── Editor ──────────────────────────────────────────────
.editor {
  margin: var(--space-3) var(--space-4) var(--space-4);
  padding: var(--space-5);
  background: var(--color-white);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-raised);
  border: 2px solid var(--color-primary-ink);
}

.editor-title {
  font-family: var(--font-display);
  font-size: 18px;
  font-weight: 600;
  margin: 0 0 var(--space-4);
  color: var(--color-ink);
}

.field {
  display: block;
  margin-bottom: var(--space-4);
  min-width: 0;
}

.field-label {
  display: block;
  font-size: 13px;
  font-weight: 700;
  color: var(--color-ink-soft);
  margin-bottom: 6px;
}

.field-hint {
  display: block;
  font-size: 12px;
  color: var(--ion-color-medium);
  margin-top: 5px;
  line-height: 1.4;
}

.field-hint.warn {
  color: var(--color-sunny-ink);
  font-weight: 700;
}

.editor-actions {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  margin-top: var(--space-4);
}

.save-btn {
  --background: var(--color-brand-primary);
  --color: var(--color-ink);
  --border-radius: var(--radius-control);
  font-weight: 700;
  flex: 1;
  min-height: 46px;
}

// ── Table ───────────────────────────────────────────────
// The row-per-user card is gone. It was 46px of avatar plus five stacked fields
// in a 46px-tall box, and the two things an admin scans this page for — who is
// an admin, and who has no phone number — were not in any consistent position
// down the list. One line each, with the role in its own column, is the fix.
.table-wrap {
  padding: var(--space-2) var(--space-4) 0;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.users-table {
  width: 100%;
  min-width: 560px;
  border-collapse: separate;
  border-spacing: 0;
  background: var(--color-white);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
  overflow: hidden;
}

.users-table thead th {
  background: var(--ion-color-light);
  padding: 9px 12px;
  text-align: left;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.4px;
  text-transform: uppercase;
  color: var(--ion-color-medium);
  white-space: nowrap;
  border-bottom: 1px solid var(--ion-color-light-shade);
}

.users-table tbody td {
  padding: 8px 12px;
  border-bottom: 1px solid var(--ion-color-light);
  vertical-align: middle;
  font-size: 13px;
  color: var(--color-ink);
}

.users-table tbody tr:last-child td {
  border-bottom: none;
}

/* The right-aligned, tabular column — here, Spent. Analytics, Tracking and
   Settings each declare this for their own numeric columns; without it the
   header sorts on the left of a column of figures and the amounts jitter as they
   are read. width: 1% is the same collapse .col-actions uses below, so the
   flexible space goes to the columns whose content actually varies. */
.num {
  text-align: right;
  width: 1%;
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}

.user-row:hover {
  background: var(--tile-powder);
}

.user-cell {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  min-width: 0;
}

/* 32px rather than 46px. A face is still recognisable at this size, and the row
   drops from ~62px to ~46px, which is the difference between 14 and 19 users on
   a phone screen. */
.user-avatar {
  width: 32px;
  height: 32px;
  flex: 0 0 auto;
  background: var(--tile-mint);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-initials {
  font-family: var(--font-display);
  font-size: 12px;
  font-weight: 700;
  color: var(--color-ink);
}

.user-name {
  font-size: 13px;
  font-weight: 700;
  color: var(--color-ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.role-badge,
.self-badge {
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.4px;
  text-transform: uppercase;
  padding: 2px 7px;
  border-radius: var(--radius-pill);
  white-space: nowrap;
  flex: 0 0 auto;
}

/* The admin badge is the one saturated thing in the table, which is correct:
   it is the answer to the question this page is usually opened to ask. */
/* ── Role tiers ──────────────────────────────────────────── */
/* Four tiers need four readable treatments, but the ESCALATING ramp is only
   right if it also escalates visibly — the point of the tiers is that a `manager`
   can tell at a glance that they are not the top of the ladder. */
.role-chip--tier {
  font-size: 12px;
}

.role-badge--owner {
  background: var(--color-ink);
  color: var(--color-white);
  border-color: var(--color-ink);
}

.role-badge--admin {
  background: var(--tone-warning-bg);
  color: var(--tone-warning-ink);
  border-color: var(--tone-warning-border);
}

.field-hint.warn {
  color: var(--tone-warning-ink);
  font-weight: 600;
}

/* ── Spend column ────────────────────────────────────────── */
.col-spent {
  white-space: nowrap;
}

.spent-amount {
  display: block;
  font-weight: 700;
  font-size: 13px;
  color: var(--color-ink);
  font-variant-numeric: tabular-nums;
}

.spent-orders {
  display: block;
  font-size: 11px;
  color: var(--ion-color-medium);
}

/* "3 orders, none delivered" is a real state and must not read as zero spend
   with no explanation — those mean different things to the person reading. */
.spent-none {
  font-size: 12px;
  color: var(--ion-color-medium);
}

/* A sort control that is a real button, so it is reachable by keyboard and
   announces the current direction. */
.sort-btn {
  appearance: none;
  background: none;
  border: none;
  padding: 2px 0;
  font: inherit;
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.4px;
  color: inherit;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 2px;
}
.sort-btn:hover {
  color: var(--color-primary-ink);
}
.sort-icon {
  --icon-size: 13px;
}

/* ── Suspension ──────────────────────────────────────────── */
/* A danger treatment that is still a BADGE, not a banner: it sits beside the
   role badge so "who is blocked" is answerable from the role column alone. */
.role-badge--suspended {
  background: var(--tone-danger-bg);
  color: var(--tone-danger-ink);
  border-color: var(--tone-danger-border);
}

.role-chip--danger {
  color: var(--color-danger);
}
.role-chip--danger.active {
  background: var(--color-danger);
  border-color: var(--color-danger);
  color: #fff;
}
.chip-icon {
  --icon-size: 13px;
  vertical-align: -2px;
  margin-right: 2px;
}

.suspend-toggle {
  display: flex;
  align-items: center;
  gap: 10px;
}
.suspend-text {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.field-hint {
  font-size: 11px;
  color: var(--ion-color-medium);
  line-height: 1.4;
}

.role-badge {
  background: var(--ion-color-light);
  color: var(--ion-color-medium);
}

/* Replaced by the tier ramp above (staff → manager → admin → owner), which is
   four treatments rather than one. */
.role-badge--staff {
  background: var(--tile-powder);
  color: var(--color-primary-ink);
}

.role-badge--manager {
  background: var(--tone-success-bg);
  color: var(--tone-success-ink);
  border-color: var(--tone-success-border);
}

.self-badge {
  background: var(--tile-mint);
  color: var(--color-mint-ink);
}

.user-email,
.user-phone,
.user-joined {
  display: block;
  font-size: 12px;
  color: var(--ion-color-medium);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 24ch;
}

.is-empty {
  /* --ion-color-medium, not --ion-color-light-shade. This placeholder is the ONLY
     thing in the cell when an account has no phone number, so "no value" is itself
     information - and light-shade (#E4EDF3) measured 1.19:1 on white, i.e. it looked
     like a rendering glitch rather than a deliberate dash. It is a BORDER token; this
     is the first place it was used as a foreground. medium is 4.93:1 here and matches
     the muted text in the sibling columns. */
  color: var(--ion-color-medium);
}

.col-actions {
  text-align: right;
  width: 1%;
  white-space: nowrap;
}

.user-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 2px;
  flex: 0 0 auto;
}

/* Real <button>s at 28px, not 40px ion-buttons. Two full-size buttons per row
   made the actions column the widest thing on the page for what is a rare
   operation; these are 30px square, icon-only, and each carries a full
   aria-label, so the accessible name is unchanged. */
.icon-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 30px;
  height: 30px;
  padding: 0;
  border: 1px solid transparent;
  border-radius: var(--radius-xs);
  background: none;
  color: var(--color-primary-ink);
  cursor: pointer;
  transition: background-color 0.15s ease;
}

.icon-btn app-icon {
  --icon-size: 16px;
}
.icon-btn:hover:not(:disabled) {
  background: var(--tile-powder);
  border-color: var(--ion-color-light-shade);
}

.icon-btn--danger {
  color: var(--tone-warning-ink);
}
.icon-btn--danger:hover:not(:disabled) {
  background: var(--tile-lemon);
}

.icon-btn:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

// ── Skeleton ─────────────────────────────────────────────
.skeleton-row {
  display: grid;
  grid-template-columns: 24% 28% 14% 12% 14%;
  gap: 12px;
  align-items: center;
  padding: 12px;
  background: var(--color-white);
  border-bottom: 1px solid var(--ion-color-light);
}
.skeleton-row:first-child {
  border-radius: var(--radius-md) var(--radius-md) 0 0;
}
.skeleton-row:last-child {
  border-bottom: none;
  border-radius: 0 0 var(--radius-md) var(--radius-md);
}

// Available to assistive tech, invisible on screen.
.visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0 0 0 0);
  white-space: nowrap;
  border: 0;
}
