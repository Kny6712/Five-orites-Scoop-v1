// src/app/features/products/products.page.scss

// ── Filter Bar ─────────────────────────────────────────
.filter-bar {
  position: sticky;
  top: 0;
  z-index: 10;
  background: var(--color-white);
  padding: 8px 0 4px;
  box-shadow: var(--shadow-card);
}

/* Capped and left-aligned. Unconstrained, this spanned the full width of every
   screen — a 1440px search field for a catalog of 64 items, with every filter
   below it pushed off the top of a laptop viewport. A search input has a
   comfortable measure and no more. */
.product-searchbar {
  --border-radius: 12px;
  --background: var(--ion-color-light);
  display: block;
  width: 100%;
  max-width: 300px;
  padding: 0 8px;
  margin: 0 8px;
}

// ── Set Chips Horizontal Scroll ──────────────────────────
.set-chips-scroll {
  display: flex;
  gap: 6px;
  overflow-x: auto;
  padding: 4px 12px 8px;
  scrollbar-width: none;

  &::-webkit-scrollbar {
    display: none;
  }
}

.set-chip {
  flex-shrink: 0;
  font-size: 13px;
  height: 30px;
  --color: var(--color-ink);

  /* The flavour this chip carries. Every `.set-chip--*` modifier below only sets
     this one property; nothing else on the chip is flavour-aware. The fallback is
     the brand primary, which is what the "All" chip uses by design and what any
     flavour missing from the map degrades to. */
  --flavor: var(--flavor-all);

  ion-label {
    color: var(--color-ink);
  }
}

/* One rule per flavour, and they only assign --flavor. Nine of these, rather than
   nine backgrounds, so that changing a chip's STATE below can never accidentally
   desynchronise one flavour from another: both the idle and the selected look
   read the same variable. */
.set-chip--chocolate {
  --flavor: var(--flavor-chocolate);
}
.set-chip--vanilla {
  --flavor: var(--flavor-vanilla);
}
.set-chip--strawberry {
  --flavor: var(--flavor-strawberry);
}
.set-chip--mango {
  --flavor: var(--flavor-mango);
}
.set-chip--ube {
  --flavor: var(--flavor-ube);
}
.set-chip--mint {
  --flavor: var(--flavor-mint);
}
.set-chip--coffee {
  --flavor: var(--flavor-coffee);
}
.set-chip--cookies-cream {
  --flavor: var(--flavor-cookies-cream);
}
.set-chip--pistachio {
  --flavor: var(--flavor-pistachio);
}

/* SELECTED. The full pastel, so the step up from idle is a clear increase in
   saturation rather than a different colour.

   `color-mix` for the idle tint rather than a second hand-written value per
   flavour: nine extra tokens would be nine more places for the two states to
   drift apart, and the tint has to stay a fixed relationship to the full colour
   or a flavour stops looking like itself when selected. Baseline support is
   Chrome 111 / Safari 16.2 / Firefox 113, comfortably inside what Ionic 7 targets. */
.set-chip-active {
  background: var(--flavor);
}

/* IDLE. A 32% tint of the same pastel, outlined in it at full strength. Two
   reasons the tint is not simply the pastel: an unselected row of nine full-
   strength pastels reads as nine loud buttons competing for a tap, and the
   selected chip needs somewhere to go.

   Contrast only improves when idle — the label is plum, and plum on a tint sits
   between plum on the full pastel (5.32-10.01:1) and plum on white (13.10:1).
   The chip stays at least 1.2:1 against the cream page in both states, which is
   asserted per flavour in check-contrast.mjs.

   1px on the outline, unlike the 2px the large --radius-md cards use: ion-chip
   is 30px tall, so its pill radius clamps to about 15px and the curve is already
   shallow. A 2px edge here would only bloat the chip. */
.set-chip-idle {
  background: color-mix(in srgb, var(--flavor) 32%, var(--color-white));
  border: 1px solid var(--flavor);
}

.filter-label {
  font-size: 14px;
  color: var(--color-ink);
  font-weight: 500;
}

// ── Consolidated filter block ────────────────────────────
/* One container for the switches and one for the three selects, where there
   were four stacked blocks before (including a fourth that held only "Type" and
   existed to borrow another block's padding). */
.filters {
  padding: 0 8px 4px;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

/* Switch rows. The label sits directly beside its own switch, with the icon
   between them, rather than the switch being flung to the far edge of a
   full-width row by slot="end" — which is what made these read as a settings
   list rather than as a pair of catalog filters. */
.switch-rows {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 6px;
}

.switch-row {
  display: flex;
  align-items: center;
  gap: 5px;
  padding: 5px 8px;
  background: var(--tile-powder);
  border-radius: var(--radius-xs);
  min-width: 0;
}

.switch-icon {
  --icon-size: 15px;
  color: var(--color-primary-ink);
  flex: 0 0 auto;
}

.switch-label {
  font-size: 12px;
  font-weight: 700;
  color: var(--color-ink);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  min-width: 0;
  cursor: pointer;
}

/* margin-left:auto is what pins the switch to the row's right edge while the
   label stays at the left — the label and its control now read as one unit
   because the row is only as wide as they need. */
.switch-toggle {
  flex: 0 0 auto;
  margin-left: auto;
  --width: 42px;
  --height: 26px;
}

/* Three selects in one compact panel. Two columns on a phone rather than one,
   so the block is ~80px tall instead of ~120px. */
.select-panel {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 5px;
  background: var(--tile-powder);
  border-radius: var(--radius-xs);
  padding: 5px 6px;
}

.select-row {
  display: flex;
  align-items: center;
  gap: 4px;
  min-width: 0;
  padding: 0 4px;
  background: var(--color-white);
  border-radius: 6px;
  min-height: 32px;
}

.select-label {
  font-size: 11px;
  font-weight: 700;
  color: var(--color-ink-soft);
  white-space: nowrap;
  flex: 0 0 auto;
}

.select-control {
  --padding-start: 0;
  --padding-end: 0;
  min-width: 0;
  flex: 1;
  font-size: 12px;
  font-weight: 700;
  color: var(--color-primary-ink);
}

@media (max-width: 420px) {
  /* Below this the two-up select grid squeezes "Max price" and its value into
     unreadable widths, so it drops to one column. */
  .select-panel {
    grid-template-columns: 1fr;
  }
}

// ── Sort ──────────────────────────────────────────────
.sort-row {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 0 12px 4px;
}

.sort-segment {
  flex: 1;
  min-width: 0;
  // Segment buttons size themselves to their label; without this the four
  // options overflow on a phone-width screen instead of shrinking.
  --min-height: 32px;

  ion-segment-button {
    min-width: 0;
    font-size: 12px;
    --indicator-height: 2px;
  }
}

.clear-row {
  display: flex;
  justify-content: flex-end;
  padding: 0 8px 2px;
}

.clear-btn {
  --color: var(--color-primary-ink);
  --border-radius: var(--radius-pill);
  font-size: 12px;
  font-weight: 700;
}
.clear-btn app-icon {
  --icon-size: 14px;
}

// ── Product Grid ─────────────────────────────────────────
.products-grid {
  padding: 12px 8px 24px;
}

ion-col {
  padding: 6px;
}

// ── Skeleton Card ─────────────────────────────────────────
.skeleton-card {
  border-radius: 16px;
  overflow: hidden;
  margin: 0;
}

/* The empty and error states are <app-empty-state> components, not local
   classes — these four blocks were left behind when that swap happened and
   styled nothing. Deleted rather than kept "in case": there is no branch of this
   template that renders them. */
</file>

