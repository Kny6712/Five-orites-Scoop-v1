<file path="src/app/admin/users/admin-users.page.html">
<ion-header>
  <ion-toolbar>
    <ion-buttons slot="start">
      <ion-menu-button aria-label="Open navigation menu"></ion-menu-button>
    </ion-buttons>
    <ion-title>Users</ion-title>
  </ion-toolbar>
</ion-header>

<ion-content fullscreen>
  @if (errorMessage()) {
    <app-alert-banner
      tone="danger"
      [message]="errorMessage()"
      [actionLabel]="loadFailed() ? 'Try again' : null"
      (action)="load()"
    />
  }

  <!--
        The spend join reads a capped slice of orders, so the Spent column is a
        lower bound past that cap. Saying nothing and letting an admin conclude
        a regular customer's spend is zero would be the one outcome worse than
        showing a partial figure.
      -->
  @if (statsTruncated()) {
    <app-alert-banner
      tone="warning"
      title="Spend column is a lower bound"
      message="'Based on the ' + ORDERS_FOR_STATS_MAX_LABEL + ' most recent orders. Older orders were not included, so a customer's lifetime spend may be higher than shown.'"
    />
  }

  @if (truncated()) {
    <!-- Said out loud rather than quietly trimmed: a directory that silently
         stops at 300 rows looks complete when it is not. -->
    <app-alert-banner
      tone="warning"
      title="List truncated"
      [message]="'Showing the first ' + users().length + ' users. Narrow the search to find anyone else.'"
    />
  }

  <!-- ── Filters ──────────────────────────────────────────────────────── -->
  <div class="filters">
    <div class="search-wrap">
      <!-- A magnifier, not a funnel: this is a text field, and a funnel icon
           beside it invites the reader to expect a filter panel. -->
      <app-icon name="search" class="search-icon" />
      <ion-input
        [ngModel]="search()"
        (ngModelChange)="onSearch($event)"
        placeholder="Search name, email or phone"
        type="search"
        aria-label="Search users"
      ></ion-input>
    </div>

    <div class="role-chips" role="group" aria-label="Filter by role">
      <button type="button" class="role-chip" [class.active]="roleFilter() === 'all'" (click)="onRoleFilter('all')">
        All ({{ users().length }})
      </button>
      <!--
        Customers only. Managers and Staff used to sit here too, and they are now
        rendered by the staff-tier row below — which now actually includes `admin`,
        where before the tier filter compared ranks the wrong way round and only
        `owner` survived. Keeping both would have produced two `Staff (1)` chips
        wired to the same filter, both showing as pressed at once.
      -->
      <button
        type="button"
        class="role-chip"
        [class.active]="roleFilter() === 'customer'"
        (click)="onRoleFilter('customer')"
      >
        Customers ({{ customerCount() }})
      </button>
    </div>

    <!--
      Every tier the signed-in user does not outrank, with live counts. One
      "Admins (3)" chip stopped meaning anything once there were four roles, and
      the question behind it — "who can do what I cannot?" — is asked per tier.
    -->
    <div class="role-chips" role="group" aria-label="Filter by staff tier">
      @for (tier of staffTiers(); track tier.role) {
        <button
          type="button"
          class="role-chip role-chip--tier"
          [class.active]="roleFilter() === tier.role"
          [attr.aria-pressed]="roleFilter() === tier.role"
          (click)="onRoleFilter(tier.role)"
        >
          {{ tier.label }} ({{ tier.count }})
        </button>
      }
    </div>

    <!--
      Suspended accounts get their own chip rather than a column, because they
      are rare and the question "who have I blocked?" is asked occasionally —
      not on every pass down the list.
    -->
    @if (suspendedCount() > 0) {
      <div class="role-chips" role="group" aria-label="Filter by account status">
        <button
          type="button"
          class="role-chip role-chip--danger"
          [class.active]="statusFilter() === 'suspended'"
          [attr.aria-pressed]="statusFilter() === 'suspended'"
          (click)="onStatusFilter('suspended')"
        >
          <app-icon name="lock" class="chip-icon" />
          Suspended ({{ suspendedCount() }})
        </button>
      </div>
    }
  </div>

  <!-- ── Editor ────────────────────────────────────────────────────────── -->
  @if (editing()) {
    <section class="editor">
      <h2 class="editor-title">Edit user</h2>

      <label class="field">
        <span class="field-label">Display name</span>
        <ion-input [(ngModel)]="editName" maxlength="60"></ion-input>
      </label>

      <label class="field">
        <span class="field-label">Phone number</span>
        <ion-input [(ngModel)]="editPhone" type="tel" inputmode="tel" placeholder="0917 123 4567"></ion-input>
      </label>

      <!--
        Staff note. Written only by an admin: the rules whitelist on the owner's
        branch means a customer cannot write this field, so it cannot be forged
        or erased from the client.
      -->
      <label class="field">
        <span class="field-label">Staff note</span>
        <ion-textarea
          [(ngModel)]="editNote"
          rows="2"
          maxlength="300"
          placeholder="Anything worth remembering about this customer…"
        ></ion-textarea>
      </label>

      <!--
        Suspension. A FLAG, not a delete — `allow delete: if false` means the
        account's order history has to survive being blocked.
      -->
      <div class="field">
        <div class="suspend-toggle">
          <div class="suspend-text">
            <span class="field-label">Account suspended</span>
            <span class="field-hint"> Blocks sign-in. Their orders are kept. </span>
          </div>
          <ion-toggle [(ngModel)]="isSuspended" aria-label="Suspend this account"></ion-toggle>
        </div>
      </div>

      @if (isSuspended) {
        <label class="field">
          <span class="field-label">Reason</span>
          <ion-input
            [(ngModel)]="suspendReason"
            maxlength="200"
            placeholder="Shown to the customer at sign-in"
          ></ion-input>
          <span class="field-hint"> Left empty, the customer is told to contact the shop instead. </span>
        </label>
      }

      <div class="field">
        <span class="field-label">Role</span>
        @if (canChangeEditRole()) {
          <ion-select [(ngModel)]="editRole" interface="popover" aria-label="Role">
            @for (opt of roleOptions; track opt.value) {
              <ion-select-option [value]="opt.value">{{ opt.label }}</ion-select-option>
            }
          </ion-select>
        } @else {
          <!--
            Shown, not offered. An `admin` CAN edit this profile but cannot change
            the role — the rules exclude `role` from `isAdminUserEdit`. A control
            that looks enabled and is rejected on save is worse than one that says
            plainly why it is off.
          -->
          <p class="field-hint">{{ editRole | titlecase }} — only an Owner can change a role.</p>
        }
      </div>

      @if (isSelf()(editUid()!)) {
        <!--
          Not merely disabled: the reason is shown. A silently inert control
          reads as a bug, and the reason (self-lockout) is not obvious.
        -->
        <p class="field-hint warn">This is your own account — you cannot change your own role.</p>
      }

      <p class="field-hint">Email is not editable here. It is the address the person signs in with.</p>

      <div class="editor-actions">
        <ion-button fill="clear" (click)="cancelEdit()">Cancel</ion-button>
        <ion-button expand="block" class="save-btn" [disabled]="busyUid() !== null" (click)="save()">
          Save changes
        </ion-button>
      </div>
    </section>
  }

  <!-- ── List ─────────────────────────────────────────────────────────── -->
  @if (isLoading()) {
    <div class="table-wrap">
      @for (s of [1, 2, 3, 4, 5]; track s) {
        <div class="skeleton-row">
          <ion-skeleton-text animated style="width: 24%; height: 14px"></ion-skeleton-text>
          <ion-skeleton-text animated style="width: 28%; height: 14px"></ion-skeleton-text>
          <ion-skeleton-text animated style="width: 14%; height: 14px"></ion-skeleton-text>
          <ion-skeleton-text animated style="width: 12%; height: 14px"></ion-skeleton-text>
          <ion-skeleton-text animated style="width: 14%; height: 14px"></ion-skeleton-text>
        </div>
      }
    </div>
  } @else if (pagedUsers().length === 0) {
    <app-empty-state
      icon="users"
      [title]="users().length === 0 ? 'No users yet' : 'No matching users'"
      [message]="
        users().length === 0
          ? 'Accounts appear here as soon as they sign up.'
          : 'Try a different name, email or role filter.'
      "
      [compact]="true"
    />
  } @else {
    <!--
      A real table.

      This was a card per user, and each card carried five separate fields
      stacked in three columns: avatar, name, two badges, email, a
      phone-and-date line, and two icon buttons. With 40 users that is 40 large
      cards where the actual data occupies maybe a third of the height.

      A table puts the comparable fields — name, role, phone, joined — on one
      line each, which makes the role question ("who has admin access?") a
      scannable column instead of a hunt for orange badges. The avatar stays
      because recognising a face is faster than reading a name, but at 32px
      rather than 46px, and the action icons drop to 16px.
    -->
    <div class="table-wrap">
      <table class="users-table">
        <caption class="visually-hidden">
          Registered users,
          {{
            filteredUsers().length
          }}
          shown
        </caption>
        <thead>
          <tr>
            <th scope="col">User</th>
            <th scope="col">Email</th>
            <th scope="col">Phone</th>
            <th scope="col">Joined</th>
            <th scope="col" class="num">
              <button
                type="button"
                class="sort-btn"
                (click)="sortBySpend(spendSort() === -1)"
                [attr.aria-label]="
                  'Sort by lifetime spend, currently ' + (spendSort() === -1 ? 'highest first' : 'lowest first')
                "
              >
                Spent
                <app-icon [name]="spendSort() === -1 ? 'chevron-down' : 'chevron-right'" class="sort-icon" />
              </button>
            </th>
            <th scope="col">Role</th>
            <th scope="col"><span class="visually-hidden">Actions</span></th>
          </tr>
        </thead>
        <tbody>
          @for (user of pagedUsers(); track user.uid) {
            <tr class="user-row">
              <td class="col-user">
                <div class="user-cell">
                  <ion-avatar class="user-avatar">
                    @if (user.photoURL) {
                      <img
                        [src]="user.photoURL | cloudinary: 64"
                        [alt]="'Photo of ' + (user.displayName || user.email)"
                      />
                    } @else {
                      <div class="avatar-initials" aria-hidden="true">{{ initials(user) }}</div>
                    }
                  </ion-avatar>
                  <span class="user-name">{{ user.displayName || 'Unnamed' }}</span>
                  @if (isSelf()(user.uid)) {
                    <span class="self-badge">You</span>
                  }
                </div>
              </td>

              <td class="col-email">
                <span class="user-email">{{ user.email }}</span>
              </td>

              <td class="col-phone" data-label="Phone">
                @if (user.phone) {
                  <span class="user-phone">{{ user.phone }}</span>
                } @else {
                  <span class="is-empty">&mdash;</span>
                }
              </td>

              <td class="col-joined" data-label="Joined">
                <span class="user-joined">{{ formatDate(user.createdAt) }}</span>
              </td>

              <!--
                Lifetime spend from DELIVERED orders, with the total order count
                beside it. The two answer different questions, so they are not
                collapsed into one number: "₱2,400 across 9 orders" tells an admin
                both what this customer is worth and how often they buy, and a
                single figure would lose whichever one it did not carry.
              -->
              <td class="num col-spent" data-label="Spent">
                @if (statsFor(user.uid).delivered > 0) {
                  <span class="spent-amount">₱{{ statsFor(user.uid).spent | number: '1.0-0' }}</span>
                  <span class="spent-orders"> {{ statsFor(user.uid).delivered }} delivered </span>
                } @else if (statsFor(user.uid).orders > 0) {
                  <span class="spent-none">
                    {{ statsFor(user.uid).orders }} order{{ statsFor(user.uid).orders === 1 ? '' : 's' }}, none
                    delivered
                  </span>
                } @else {
                  <span class="is-empty">&mdash;</span>
                }
              </td>

              <td class="col-role" data-label="Role">
                <span
                  class="role-badge"
                  [class.role-badge--staff]="user.role === 'staff'"
                  [class.role-badge--manager]="user.role === 'manager'"
                  [class.role-badge--admin]="user.role === 'admin'"
                  [class.role-badge--owner]="user.role === 'owner'"
                >
                  {{ roleLabel(user) }}
                </span>
                @if (user.isSuspended === true) {
                  <span class="role-badge role-badge--suspended">Suspended</span>
                }
              </td>

              <td class="col-actions">
                <div class="user-actions">
                  <button
                    type="button"
                    class="icon-btn"
                    (click)="startEdit(user)"
                    [attr.aria-label]="'Edit ' + (user.displayName || user.email)"
                  >
                    <app-icon name="pencil" />
                  </button>
                  @if (user.role === 'admin' || user.role === 'customer') {
                    <button
                      type="button"
                      class="icon-btn"
                      [class.icon-btn--danger]="user.role === 'admin'"
                      [disabled]="busyUid() === user.uid"
                      (click)="changeRole(user, user.role === 'admin' ? 'customer' : 'admin')"
                      [attr.aria-label]="
                        (user.role === 'admin' ? 'Remove admin access from ' : 'Make admin: ') +
                        (user.displayName || user.email)
                      "
                    >
                      <app-icon [name]="user.role === 'admin' ? 'shield-check' : 'sparkles'" />
                    </button>
                  }
                </div>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>

    <app-pagination
      [page]="page()"
      [total]="filteredUsers().length"
      [pageSize]="PAGE_SIZE"
      itemLabel="users"
      (pageChange)="onPageChange($event)"
    />
  }
  <app-footer></app-footer>
</ion-content>
</file>

<file path="src/app/admin/vouchers/admin-vouchers.page.scss">
// src/app/admin/vouchers/admin-vouchers.page.scss
// Five-orites Scoop — Admin voucher management

.new-btn {
  --font-size: 13px;
  font-weight: 700;
}

// ── Editor ───────────────────────────────────────────────
.editor {
  background: var(--color-white);
  border-left: 4px solid var(--color-primary-ink);
  border-radius: 0 var(--radius-md) var(--radius-md) 0;
  box-shadow: var(--shadow-card);
  padding: var(--space-4);
  margin: var(--space-3) var(--space-4) 0;
}

.editor-head {
  margin-bottom: var(--space-3);
}

.editor-title {
  margin: 0;
  font-family: var(--font-display);
  font-size: 18px;
  font-weight: 600;
  color: var(--color-ink);
}

.editor-sub {
  margin: 2px 0 0;
  font-size: 12px;
  line-height: 1.4;
  color: var(--ion-color-medium);
}

.field {
  display: block;
  margin-bottom: var(--space-3);
}

.field-label {
  display: block;
  font-size: 13px;
  font-weight: 700;
  color: var(--color-ink-soft);
  margin-bottom: 5px;
}

.field-hint {
  display: block;
  font-size: 11px;
  color: var(--ion-color-medium);
  margin-top: 4px;
  line-height: 1.4;
}

.field-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-3);
}

// ── Worked example ───────────────────────────────────────
/* The one genuinely new thing on this page. "10% off" is not a discount, it is
   an input — the question is what the customer pays, so that is what is
   answered, in words, live. Turned to the warning tone when the sample basket
   falls under the minimum order, because that is the case where the voucher
   silently does nothing and the admin needs to see it before saving. */
.example {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-3);
  margin-bottom: var(--space-3);
  background: var(--tile-mint);
  border: 1px solid var(--tone-success-border);
  border-radius: var(--radius-sm);
}

.example--blocked {
  background: var(--tone-warning-bg);
  border-color: var(--tone-warning-border);
}

.example-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  flex: 0 0 auto;
  border-radius: 50%;
  background: var(--color-white);
}

.example-badge app-icon {
  --icon-size: 16px;
  color: var(--color-primary-ink);
}
.example--blocked .example-badge app-icon {
  color: var(--tone-warning-ink);
}

.example-text {
  margin: 0;
  font-size: 13px;
  line-height: 1.45;
  color: var(--color-ink);
}
.example-text strong {
  font-weight: 800;
  color: var(--color-primary-ink);
}

.toggle-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
  padding: var(--space-2) 0;
}

.toggle-text {
  min-width: 0;
}
.toggle-title {
  display: block;
  font-size: 14px;
  font-weight: 700;
  color: var(--color-ink);
}
.toggle-sub {
  display: block;
  font-size: 12px;
  color: var(--ion-color-medium);
}

.editor-actions {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  margin-top: var(--space-3);
}

.save-btn {
  --background: var(--color-brand-primary);
  --color: var(--color-ink);
  --border-radius: var(--radius-sm);
  font-weight: 700;
  min-height: 46px;
}

// ── Tools ────────────────────────────────────────────────
.tools {
  padding: var(--space-3) var(--space-4) 0;
}

.voucher-search {
  --border-radius: var(--radius-sm);
  --background: var(--ion-color-light);
  padding: 0;
}

.tools-row {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  flex-wrap: wrap;
}

.count-chip {
  padding: 5px 12px;
  border: 1px solid var(--ion-color-light-shade);
  border-radius: var(--radius-pill);
  background: var(--color-white);
  color: var(--color-ink-soft);
  font: inherit;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
  font-variant-numeric: tabular-nums;
}

.count-chip--on {
  background: var(--color-brand-primary);
  border-color: var(--color-primary-ink);
  color: var(--color-ink);
}

.clear-btn {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 0;
  background: none;
  border: 0;
  font: inherit;
  font-size: 12px;
  font-weight: 700;
  color: var(--color-primary-ink);
  cursor: pointer;
}
.clear-btn app-icon {
  --icon-size: 13px;
}

// ── Ticket list ──────────────────────────────────────────
/* A voucher is a ticket, so it is drawn as one: code in mono at the top, the
   discount as a chip, and a perforated edge down the right where the actions
   live. The old version was a plain list row with a bare toggle, which made the
   page read as a settings list rather than as the coupon inventory it is. */
.list {
  padding: var(--space-3) var(--space-4) 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.ticket {
  position: relative;
  display: flex;
  align-items: center;
  gap: var(--space-3);
  background: var(--color-white);
  /* 2px, not 1px — a thin border on an 18px curve breaks up as it rasterises.
     See .danger-group in profile.page.scss for the full explanation. */
  border: 2px solid var(--ion-color-light-shade);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
  padding: var(--space-3);
  overflow: hidden;
  transition: opacity 0.15s ease;
}

.ticket--inactive {
  opacity: 0.66;
}

.ticket--skeleton {
  display: block;
  min-height: 78px;
}

.ticket-body {
  flex: 1;
  min-width: 0;
}

.ticket-head {
  display: flex;
  align-items: center;
  gap: var(--space-2);
}

/* The code is the thing an admin says over the phone and the thing a customer
   types, so it is the one element on the card in a real monospace face at a size
   that can be read aloud. */
.ticket-code {
  font-family: var(--font-mono);
  font-size: 16px;
  font-weight: 700;
  color: var(--color-ink);
  letter-spacing: 0.5px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ticket--inactive .ticket-code {
  color: var(--ion-color-medium);
}

.copy-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 24px;
  height: 24px;
  flex: 0 0 auto;
  padding: 0;
  border: 0;
  border-radius: var(--radius-xs);
  background: none;
  color: var(--color-primary-ink);
  cursor: pointer;
}
.copy-btn app-icon {
  --icon-size: 14px;
}
.copy-btn:hover {
  background: var(--tile-powder);
}

.ticket-chips {
  display: flex;
  gap: 5px;
  flex-wrap: wrap;
  margin-top: 6px;
}

.v-chip {
  padding: 3px 9px;
  border-radius: var(--radius-pill);
  background: var(--ion-color-light);
  color: var(--ion-color-medium);
  font-size: 11px;
  font-weight: 700;
  white-space: nowrap;
}

/* The discount itself gets the mint treatment: it is the reason the voucher
   exists, and it was previously plain text among plain text. */
.v-chip--value {
  background: var(--tile-mint);
  color: var(--color-mint-ink);
  font-size: 12px;
  font-weight: 800;
}

.v-chip--off {
  background: var(--ion-color-light);
  color: var(--ion-color-medium);
}

/* ── Redemption limits & window ──────────────────────────── */
.field-pair {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0 10px;
}

@media (max-width: 400px) {
  .field-pair {
    grid-template-columns: 1fr;
  }
}

/* A native date input rather than ion-datetime: a datetime picker is the wrong
   control for a day boundary, and native is keyboard- and locale-correct for
   free. */
.date-input {
  width: 100%;
  min-height: 44px;
  padding: 10px 12px;
  border: 1px solid var(--ion-color-light-shade);
  border-radius: var(--radius-xs);
  background: var(--color-white);
  color: var(--color-ink);
  font: inherit;
  font-size: 15px;
}
.date-input:focus-visible {
  outline: 3px solid var(--color-primary-ink);
  outline-offset: 2px;
}

/* ── New state chips ──────────────────────────────────────── */
/* Distinct from --value and from the plain chip: a limit reached is a warning,
   a measured result is a positive, and "no data" is neither. */
.v-chip--warn {
  background: var(--tone-warning-bg);
  color: var(--tone-warning-ink);
  border-color: var(--tone-warning-border);
}

.v-chip--good {
  background: var(--tone-success-bg);
  color: var(--tone-success-ink);
  border-color: var(--tone-success-border);
}

.v-chip--muted {
  background: var(--tile-powder);
  // ink-soft, not --ion-color-medium: measured 4.28:1 on this powder tile, a
  // whisker under the 4.5 that 11px/700 owes. ink-soft is 5.56:1.
  color: var(--color-ink-soft);
  border-color: transparent;
}

/* The perforation. Two radial cutouts rather than an SVG, so it scales with the
   card and costs nothing to download; the pseudo-elements sit over the border
   so the card looks torn rather than drawn-on. */
.ticket-perf {
  position: relative;
  align-self: stretch;
  width: 1px;
  flex: 0 0 auto;
  margin: -12px 0;
  border-left: 2px dashed var(--ion-color-light-shade);
}

.ticket-actions {
  display: flex;
  align-items: center;
  gap: var(--space-1);
  flex: 0 0 auto;
}

.icon-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  padding: 0;
  border: 1px solid transparent;
  border-radius: var(--radius-xs);
  background: none;
  color: var(--color-primary-ink);
  cursor: pointer;
}

.icon-btn app-icon {
  --icon-size: 16px;
}
.icon-btn:hover {
  background: var(--tile-powder);
  border-color: var(--ion-color-light-shade);
}

.icon-btn--danger {
  color: var(--tone-danger-ink);
}
.icon-btn--danger:hover {
  background: var(--tone-danger-bg);
  border-color: var(--tone-danger-border);
}

@media (max-width: 400px) {
  /* Below this the code, three chips and three controls cannot share a line, so
     the actions drop to their own row rather than being squeezed to nothing. */
  .ticket {
    flex-wrap: wrap;
  }
  .ticket-perf {
    display: none;
  }
  .ticket-actions {
    width: 100%;
    justify-content: flex-end;
  }
}
</file>

<file path="src/app/core/guards/auth.guard.ts">
// src/app/core/guards/auth.guard.ts
// Five-orites Scoop — Authentication Route Guard
// Author: Five-orites Scoop team (see README)

import { inject } from '@angular/core';
import { CanActivateFn, Router } from '@angular/router';
import { AuthService } from '../services/auth.service';
import { filter, map, switchMap, take } from 'rxjs/operators';

export const authGuard: CanActivateFn = () => {
  const authService = inject(AuthService);
  const router = inject(Router);

  return authService.authReady$.pipe(
    filter((ready) => ready),
    take(1),
    switchMap(() => authService.currentUser$.pipe(take(1))),
    map((user) => {
      if (user) return true;
      router.navigate(['/auth']);
      return false;
    }),
  );
};
</file>

<file path="src/app/core/logic/stock.ts">
// src/app/core/logic/stock.ts
// Five-orites Scoop — Pure stock rules
//
// Deliberately free of Angular and Firebase imports so the unit tests can
// import this module directly instead of re-implementing the rules. If the app
// and the tests ever disagree, the tests are wrong.

/**
 * Validates that `addQty` more units of a line may be added to the cart.
 * Throws a user-facing message on violation.
 *
 * @param label      Human-readable line label, e.g. "Rocky Road (pint)".
 * @param existingQty Units of this exact line already in the cart.
 * @param addQty     Units the caller wants to add. Must be >= 1.
 * @param available  Units currently in stock. Must be > 0.
 */
export function assertCanAddToCart(
  label: string,
  existingQty: number,
  addQty: number,
  available: number,
): void {
  if (addQty <= 0) throw new Error('Quantity must be at least 1.');
  if (available <= 0) throw new Error(`${label} is out of stock.`);
  if (existingQty + addQty > available) {
    throw new Error(
      `Only ${available} x ${label} available. You already have ${existingQty} in cart.`,
    );
  }
}

/** Clamps a requested quantity to what is actually available (never below 0). */
export function clampToStock(quantity: number, available: number | undefined): number {
  if (available === undefined) return quantity;
  return Math.min(quantity, Math.max(available, 0));
}

/**
 * Every size the catalog sells, in display order.
 *
 * Typed as a plain string tuple, NOT as `SizeVariant`: that type lives in
 * product.model.ts, which imports Timestamp from @angular/fire/firestore, and
 * this module is required to stay free of Angular and Firebase so the unit
 * tests can import it directly. See the note at the top of this file.
 */
export const SIZE_VARIANTS = ['cup', 'pint', 'halfGallon', 'gallon'] as const;

/**
 * Total units on hand across every size, for the "how do we look overall" read.
 *
 * Cup 20 + Pint 30 + Half Gallon 20 + Gallon 20 is 90 units, which is the number
 * an owner actually wants when scanning the inventory rather than reading four
 * separate figures per flavour.
 *
 * Iterates `SIZE_VARIANTS` rather than the keys of the incoming map, so a
 * document that somehow carries an extra size cannot inflate the total, and the
 * function cannot drift from the size list as it grows. A non-finite or missing
 * level counts as zero rather than poisoning the sum with `NaN` — which is the
 * failure mode of the inline `reduce` this replaced, and the reason the inventory
 * card and the delete-confirmation could have quoted different totals for the
 * same product.
 */
export function totalStock<T extends object>(stock: T | null | undefined): number {
  if (!stock || typeof stock !== 'object') return 0;
  // Generic over the shape rather than typed as `Record<string, number>`: a
  // `StockLevel` is a plain interface with four named keys and NO index
  // signature, so TypeScript refuses to assign it to an index-signature type even
  // though the read is perfectly safe. The narrowing below is the real guarantee.
  const levels = stock as Record<string, unknown>;
  let total = 0;
  for (const size of SIZE_VARIANTS) {
    const level = levels[size];
    total += typeof level === 'number' && Number.isFinite(level) ? level : 0;
  }
  return total;
}

/**
 * Validates and collapses the stock movements a checkout is about to apply.
 *
 * Two reasons this is not a plain `for` loop:
 *
 * 1. Quantities are attacker-controlled. The cart is rehydrated from
 *    localStorage, and a negative quantity passes a naive
 *    `available < quantity` test (`5 < -5` is false) and then *raises* stock,
 *    because the write is `stock - quantity`. Every quantity is therefore
 *    required to be a whole number of at least 1.
 * 2. Duplicate product/size pairs are summed. The transaction writes each
 *    document once, so two separate lines for the same size were charged
 *    twice while only one decrement was applied.
 */
export function normaliseStockLines<
  T extends { productId: string; size: string; quantity: number },
>(lines: readonly T[]): T[] {
  const merged = new Map<string, T>();
  for (const line of lines) {
    const quantity = line.quantity;
    if (!Number.isInteger(quantity) || quantity < 1) {
      throw new Error(`Invalid quantity for ${line.size}: must be a whole number of 1 or more.`);
    }
    const key = `${line.productId}|${line.size}`;
    const existing = merged.get(key);
    if (existing) existing.quantity += quantity;
    else merged.set(key, { ...line });
  }
  return [...merged.values()];
}
</file>

