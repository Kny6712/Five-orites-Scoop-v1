<!-- src/app/app.component.html -->
<!-- Five-orites Scoop — Split-Pane Shell + Side Menu -->

<ion-app>
  <ion-split-pane contentId="main-content" when="md">
    <!-- ═══════════════════════════════════════════
         SIDE NAVIGATION MENU
    ═══════════════════════════════════════════ -->
    <ion-menu contentId="main-content" type="overlay" class="app-menu">
      <!-- Menu Header / Branding -->
      <div class="menu-header">
        <div class="menu-logo-wrap">
          <!-- Decorative: the <h1> below carries the brand name, so naming the
               logo here would make a screen reader say "Five-orites Scoop" twice. -->
          <img src="/assets/images/logo-ice_cream.png" alt="" aria-hidden="true" class="menu-logo" />
        </div>
        <h1 class="menu-brand">Five-orites Scoop</h1>
        <p class="menu-tagline">Premium ice cream, scooped to your door</p>
      </div>

      <ion-content class="menu-content ion-padding-bottom">
        <!-- Customer / Shared Navigation -->
        <ion-list lines="none" class="nav-list">
          <ion-list-header class="nav-section-label">Menu</ion-list-header>

          @for (item of visibleCustomerNavItems(); track item.url) {
            <ion-menu-toggle auto-hide="false">
              <ion-item
                [routerLink]="item.url"
                routerLinkActive="active-nav-item"
                [routerLinkActiveOptions]="{ exact: item.url === '/dashboard' }"
                detail="false"
                class="nav-item"
                [attr.aria-label]="navItemLabel(item)"
              >
                <!-- The icon is wrapped so the count has something local to
                     anchor to. Slotting the count itself would put it at the far
                     end of the row, detached from the cart it belongs to, and
                     positioning it against the item instead would mean hard-coding
                     the icon's offset from --padding-start and the row height. -->
                <span slot="start" class="nav-icon-wrap">
                  <app-icon [name]="item.icon" class="nav-icon" />
                  @if (item.badgeCount && item.badgeCount() > 0) {
                    <span class="cart-badge" aria-hidden="true">{{ item.badgeCount() }}</span>
                  }
                </span>
                <ion-label>{{ item.title }}</ion-label>
              </ion-item>
            </ion-menu-toggle>
          }
        </ion-list>

        <!-- Admin Section — Only visible to admins -->
        @if (isAdmin()) {
          <ion-list lines="none" class="nav-list admin-nav">
            <ion-list-header class="nav-section-label admin-label">Admin Panel</ion-list-header>

            @for (item of visibleAdminNavItems(); track item.url) {
              <ion-menu-toggle auto-hide="false">
                <ion-item
                  [routerLink]="item.url"
                  routerLinkActive="active-nav-item"
                  detail="false"
                  class="nav-item"
                  [attr.aria-label]="item.title"
                >
                  <app-icon [name]="item.icon" slot="start" class="nav-icon admin-nav-icon" />
                  <ion-label>{{ item.title }}</ion-label>
                </ion-item>
              </ion-menu-toggle>
            }
          </ion-list>
        }

        <!-- Spacer to push user panel to bottom -->
        <div class="menu-spacer"></div>

        <!-- User Profile Panel -->
        @if (currentUser()) {
          <div class="user-panel">
            <!-- The identity block is a link to My Profile. It stays a SIBLING of the
                 logout button, never its parent: nesting <ion-button> inside an <a> is
                 invalid, breaks keyboard/AT semantics, and would make signing out also
                 navigate. So the panel is two independent tap targets — this one goes to
                 /profile, the icon to its right signs out. -->
            <a
              class="user-info user-link"
              [routerLink]="'/profile'"
              routerLinkActive="active-user-link"
              (click)="closeMenu()"
              aria-label="My Profile"
            >
              <ion-avatar class="user-avatar">
                @if (currentUser()?.photoURL) {
                  <img [src]="currentUser()!.photoURL" [alt]="'Profile photo of ' + currentUser()!.displayName" />
                } @else {
                  <div class="avatar-initials">{{ getUserInitials() }}</div>
                }
              </ion-avatar>
              <div class="user-meta">
                <span class="user-name">{{ currentUser()?.displayName }}</span>
                <span class="user-email">{{ currentUser()?.email }}</span>
              </div>
            </a>
            <ion-button fill="clear" class="logout-btn" (click)="logout()" aria-label="Sign out of your account">
              <app-icon name="log-out" slot="icon-only" />
            </ion-button>
          </div>
        } @else {
          <div class="guest-panel">
            <ion-button expand="block" [routerLink]="'/auth'" class="sign-in-btn"> Sign In </ion-button>
          </div>
        }
      </ion-content>
    </ion-menu>

    <!-- ═══════════════════════════════════════════
         MAIN CONTENT OUTLET
    ═══════════════════════════════════════════ -->
    <ion-router-outlet id="main-content"></ion-router-outlet>
  </ion-split-pane>
</ion-app>
</file>

