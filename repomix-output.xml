// src/theme/variables.scss
// Five-orites Scoop — Global CSS Variables & Design Tokens
//
// ── Palette rationale ────────────────────────────────────────────────────────
// Brief: soft and premium — powder blue, mint green, soft pastel accents, rounded
// corners, friendly typography. Pink is a supporting accent, never the lead.
//
// The central decision: the brand hues stay BRIGHT but the primary is now a MID
// PASTEL (powder blue), and everything printed on a brand hue is deep plum rather
// than white. White on a pastel is hopeless — measured below at 1.79:1 — so the
// "primary" contrast colour is plum and not white, exactly as before. The move
// from a saturated pink to a pastel blue is what makes the plum-on-bright-hue
// pattern keep working at all: plum on the old #FF6B8A only reached 4.74:1, and
// on #8ECAE6 it clears 7.20:1 with room to spare.
//
// Every pair below was computed, not eyeballed (see scripts/check-contrast.mjs):
//
//   plum  #3D2B45 on cream #FFF9F4 ....... 12.34:1   body text
//   plum  #3D2B45 on white #FFFFFF ....... 13.10:1   body text on a card
//   plum  #3D2B45 on powder  #8ECAE6 .....  7.20:1   primary surface    AA
//   plum  #3D2B45 on mint     #5FD9B4 .....  7.41:1   secondary surface AA
//   plum  #3D2B45 on sunny    #FFC53D .....  8.16:1   tertiary surface  AA
//   plum  #3D2B45 on blush    #F8A9BE .....  7.00:1   accent surface    AA
//   white #FFFFFF on powder  #8ECAE6 .....  1.79:1   FAILS — hence plum
//   primary-ink #1B5E7E on cream ........  6.82:1   accent text        AA
//   primary-ink #1B5E7E on white ........  7.12:1   accent text        AA
//   mint-ink    #12866A on cream ........  4.52:1
//   sunny-ink   #8A5B00  on cream ........  5.87:1
//
// The three `-ink` variants exist for the cases that need a DARK version of a
// brand hue — accent text and icons sitting on a white card or a pastel tile.
// Prefer plum on the bright hue; reach for an ink when there is no bright hue to
// print on.
//
// ── Pink is a demoted accent, not a role colour ───────────────────────────────
// The old design had strawberry #FF6B8A as the primary, which made it the
// toolbar on every page and the fill on every CTA — roughly 104 call sites. It is
// gone as a role colour. What survives is `--color-brand-blush` #F8A9BE, a soft
// pastel for small moments that genuinely want warmth: the wishlist heart and a
// "Sale" style badge.
//
// IT IS NEVER A PAGE SURFACE, and that is the rule this paragraph used to
// contradict — it listed "a promo banner" as an approved use three lines above
// saying it was never a surface. Resolved: a single-row promo strip is a small
// moment; a full section, a card the page is built from, or anything a user must
// scroll to read is not, and must use a role colour or a --tile-* token instead.
//
// The Dashboard's "Track your orders live" banner was mint
// (`--color-brand-light`) until it was deliberately recoloured to blush, which is
// the one place blush now fills a surface. It qualifies as a small moment — a
// one-row affordance, not a page region — and all three of its text pairs are
// asserted in check-contrast.mjs: plum 7.00:1, the dashed border 3.87:1 against
// the 3.0 that WCAG 1.4.11 requires of a non-text boundary, and 1.76:1 against
// the cream page so the strip does not dissolve into it.
//
// ── Semantic colours are a different story ───────────────────────────────────
// success / warning / danger are already dark, so plum text on them is
// unreadable. Those three keep white text, and their bases were picked to clear
// 4.5:1 with it. The `--tone-*` triples below are the pastelled equivalents for
// BANNERS and notices: a tinted background, a matching border, and a dark ink.
// They replaced 17 hardcoded pastel triples that had been duplicated across 11
// files, which is how the palette used to drift.

:root {
  // ── Brand Tokens ──────────────────────────────────────────
  --color-brand-primary: #8ecae6; // powder blue — the lead hue
  --color-brand-secondary: #5fd9b4; // mint green
  --color-brand-accent: #ffc53d; // sunny — highlights, stars, CTAs
  // Pink, demoted to a soft accent. Wishlists and promos only.
  --color-brand-blush: #f8a9be;

  /* `--color-brand-light` is the historical name for the mint hue and is
     referenced by ~22 call sites that predate the primary/secondary split.
     It stays as an alias so those keep working, but new code should reach for
     `--color-brand-secondary`. */
  --color-brand-light: var(--color-brand-secondary);

  // Text-safe variants of the brand hues (see header).
  --color-primary-ink: #1b5e7e;
  --color-mint-ink: #0f7358;
  --color-sunny-ink: #8a5b00;
  --color-blush-ink: #a63a5e;

  // ── Gradients ────────────────────────────────────────────
  /* Defined once, here, because there used to be eight inline gradients whose
     second stop was a hardcoded purple (#9b6ed4, #8b56c4) left over from a
     palette that no longer exists. With a powder-blue first stop they rendered
     as a blue-to-purple wash that read as a rendering bug rather than a choice.

     All three run light-to-light, so text on them is PLUM, never white — the same
     rule as the toolbar. White on these measures 1.58–1.84:1. */
  --gradient-brand: linear-gradient(135deg, #8ecae6 0%, #5fd9b4 100%);
  --gradient-brand-soft: linear-gradient(135deg, #a6d5ed 0%, #8ee3c9 100%);
  --gradient-brand-warm: linear-gradient(135deg, #8ecae6 0%, #f8a9be 100%);
  --gradient-sun: linear-gradient(135deg, #ffd470 0%, #ffb60a 100%);

  /* A DARK brand ramp, for the metric tiles that carry a large white number.
     The pastel gradients above cannot hold white text, so any tile whose value
     is set in white needs this instead. It is the primary hue walked down to
     ink, so it still reads as "brand" without inverting the type. */
  --gradient-ink-brand: linear-gradient(135deg, #17566f 0%, #1b5e7e 100%);

  // Pastel tile backgrounds for icon wells and soft chips.
  --tile-powder: #e4f1f8;
  --tile-mint: #e4f6ea;
  --tile-lemon: #fff3d6;
  --tile-blush: #fde8ee;
  --tile-periwinkle: #e8eef9;

  /* Deliberately DEEPER than --tile-lemon, and the reason is measured rather than
     aesthetic. --tile-lemon at #fff3d6 sits 1.06:1 against the cream page, which
     is no edge at all — a card in that colour reads as a slightly-off patch of
     yellow floating on the background rather than as a container. This one
     reaches 1.20:1, which is the floor this file uses for "large filled area must
     be distinguishable from what it sits on" (the same 1.2 that gates the nine
     flavour chips and the promo banner).

     Used by the Dashboard welcome banner, which was --gradient-brand. Two things
     were checked before choosing it:
       - the retro gold sticker shadow on the title gets STRONGER here, 1.26:1
         against 1.13:1 on the old powder gradient. Warm surfaces are where a gold
         decal reads best, so this improves the treatment rather than losing it.
       - it must not collide with the announcement banner directly below it,
         which is --tile-lemon. At 1.14:1 the two are close but distinguishable;
         making the welcome banner the same --tile-lemon would have made them
         identical at 1.00:1.
     Deeper than this and the gold shadow starts to disappear — #f5ce78 drops it
     to 1.05:1, the floor — so this value is near the ceiling for the effect. */
  --tile-lemon-deep: #fbe3ae;

  // The one ink colour for the whole app. Not pure black — a deep plum keeps
  // the warm cast and measures better than #000 on a cream background.
  --color-ink: #3d2b45;
  --color-ink-soft: #6b5875;
  --color-cream: #fff9f4;
  --color-white: #ffffff;

  // ── Status ───────────────────────────────────────────────
  --color-success: #17803f;
  --color-warning: #b45309;
  --color-danger: #c62828;

  // ── Toned surfaces (banners, notices, soft chips) ─────────
  /* Each triple is a background you can put text on, a border that reads as an
     edge against BOTH the white card it sits on and its own background, and an
     ink that clears 4.5:1 on that background. All three constraints are
     asserted in scripts/check-contrast.mjs — the first draft of this layer
     failed two of them, because a tint that is pleasant against cream can be
     invisible against the white card it is actually drawn on.

     These replaced 17 hardcoded pastel triples that had been duplicated across
     eleven files, which is how the palette used to drift. */
  --tone-success-bg: #ddf2e4;
  --tone-success-border: #7fc49a;
  --tone-success-ink: #14622f;

  --tone-warning-bg: #fcebc4;
  --tone-warning-border: #e0b85c;
  --tone-warning-ink: #7a4b00;

  --tone-danger-bg: #fde8ee;
  --tone-danger-border: #f5b8c8;
  --tone-danger-ink: #8f1f38;

  --tone-info-bg: #e4f1f8;
  --tone-info-border: #a8cbe8;
  --tone-info-ink: #17456f;

  // ── Ionic Ion Color Overrides ─────────────────────────────
  // Contrast is PLUM for the three brand hues (see header). Ionic reads
  // -contrast for text and icon colour on a `color="…"` surface, so this is what
  // keeps a pastel button readable.
  --ion-color-primary: #8ecae6;
  --ion-color-primary-rgb: 142, 202, 230;
  --ion-color-primary-contrast: #3d2b45;
  --ion-color-primary-contrast-rgb: 61, 43, 69;
  --ion-color-primary-shade: #64b6dd;
  --ion-color-primary-tint: #b8deef;

  --ion-color-secondary: #5fd9b4;
  --ion-color-secondary-rgb: 95, 217, 180;
  --ion-color-secondary-contrast: #3d2b45;
  --ion-color-secondary-contrast-rgb: 61, 43, 69;
  --ion-color-secondary-shade: #36cfa1;
  --ion-color-secondary-tint: #88e3c7;

  // Used by the "Out for Delivery" status badge and the team role chips.
  --ion-color-tertiary: #ffc53d;
  --ion-color-tertiary-rgb: 255, 197, 61;
  --ion-color-tertiary-contrast: #3d2b45;
  --ion-color-tertiary-contrast-rgb: 61, 43, 69;
  --ion-color-tertiary-shade: #ffb60a;
  --ion-color-tertiary-tint: #ffd470;

  // These three stay dark, so they keep WHITE text.
  --ion-color-success: #17803f;
  --ion-color-success-rgb: 23, 128, 63;
  --ion-color-success-contrast: #ffffff;
  --ion-color-success-contrast-rgb: 255, 255, 255;
  --ion-color-success-shade: #197742;
  --ion-color-success-tint: #42a06a;

  --ion-color-warning: #b45309;
  --ion-color-warning-rgb: 180, 83, 9;
  --ion-color-warning-contrast: #ffffff;
  --ion-color-warning-contrast-rgb: 255, 255, 255;
  --ion-color-warning-shade: #974608;
  --ion-color-warning-tint: #c06f30;

  --ion-color-danger: #c62828;
  --ion-color-danger-rgb: 198, 40, 40;
  --ion-color-danger-contrast: #ffffff;
  --ion-color-danger-contrast-rgb: 255, 255, 255;
  --ion-color-danger-shade: #a62222;
  --ion-color-danger-tint: #cf4a4a;

  // ── Neutral Palette ──────────────────────────────────────
  --ion-color-light: #f2f7fa;
  --ion-color-medium: #7a6b84;
  --ion-color-dark: #3d2b45;
  --ion-color-light-shade: #e4edf3;
  --ion-color-light-tint: #f6fafc;
  --ion-color-dark-shade: #33253a;
  --ion-color-dark-tint: #55445d;

  // ── Radius Scale ─────────────────────────────────────────
  // A SCALE, not one value. A single radius applied everywhere is the "SaaS card
  // kit" look the design brief is explicitly moving away from; hierarchy comes
  // from these being visibly different steps.
  --radius-xs: 8px;
  --radius-sm: 12px;
  --radius-md: 18px;
  --radius-lg: 26px;
  --radius-xl: 34px;
  --radius-pill: 999px;

  // Aliases for the two most-used surfaces, so a page can opt out of the global
  // ion-card rule with a class and have it actually take effect.
  --radius-card: var(--radius-md);
  --radius-control: var(--radius-sm);

  // ── Elevation ────────────────────────────────────────────
  // Tinted with the brand rather than neutral grey: a pure rgba(0,0,0,.08) on a
  // cream surface reads as dirt. Each step is a real step.
  //
  // These were deepened when the palette moved to pastels. On a cream page a
  // 0.07-alpha shadow is nearly invisible against a white card, so containers
  // were reading as flat — the audit found six surfaces that had given up on the
  // scale and hardcoded rgba(0,0,0,.05-.06) anyway, which is the same problem
  // with a worse value.
  --shadow-card: 0 2px 12px rgba(61, 43, 69, 0.1);
  --shadow-raised: 0 8px 24px rgba(61, 43, 69, 0.14);
  --shadow-float: 0 16px 40px rgba(61, 43, 69, 0.18);
  --shadow-inset: inset 0 2px 4px rgba(61, 43, 69, 0.12);

  // ── Spacing ──────────────────────────────────────────────
  --space-1: 4px;
  --space-2: 8px;
  --space-3: 12px;
  --space-4: 16px;
  --space-5: 24px;
  --space-6: 32px;
  --space-7: 48px;

  // ── Breakpoints ──────────────────────────────────────────
  // Raw px rather than a SCSS variable: this file is loaded as a plain global
  // stylesheet and has no `stylePreprocessorOptions.includePaths` configured, so
  // there is nowhere for a SCSS mixin to live and be shared. The `.bp-*` helper
  // classes in global.scss are the intended way to consume these.
  --bp-sm: 480px;
  --bp-md: 768px;
  --bp-lg: 1024px;
  --bp-xl: 1280px;

  // ── Layout ───────────────────────────────────────────────
  // A readable measure for body content, and the cap every page body should sit
  // inside on a tablet. About was full-bleed here while Profile capped at 640.
  --container-max: 1080px;
  --measure-max: 68ch;

  // ── Typography ───────────────────────────────────────────
  // Fredoka for display (rounded, friendly, and deliberately not a default
  // UI face); Nunito for body, which stays legible at the 12–14px sizes this
  // app uses for chips and metadata. Both are loaded in index.html.
  --font-display: 'Fredoka', 'Trebuchet MS', sans-serif;
  --font-body: 'Nunito', 'Segoe UI', system-ui, -apple-system, sans-serif;
  // Order IDs. A real token rather than the bare `monospace` keyword, which was
  // hardcoded in one file and would otherwise drift from the brand faces.
  // NOTE: JetBrains Mono was declared here but never actually requested from
  // Google Fonts, so every "mono" string silently rendered as Consolas.
  --font-mono: 'JetBrains Mono', 'Consolas', ui-monospace, monospace;

  /* The retro display face — a DECORATIVE one, not the display face.
     Lobster Two carries the script-plus-hard-shadow treatment for SIX strings:
     the About hero title, the auth page brand, the side-menu header brand, the
     Dashboard welcome title and greeting, the global `ion-title`, and the footer
     name.

     This said FOUR for a long time and was wrong twice over: it predated the
     footer and toolbar work, and then the Developers hero briefly made seven
     while it was trying out a poster face. That hero settled on a plain one-line
     motto in --font-display, so the count is six and stays six.

     The requirement is a BRAND-HUE background, because the gold offset shadow
     below is close to invisible against cream or white — 1.58:1 on white and
     1.51:1 on cream, both asserted at the very bottom of check-contrast.mjs.
     That is why it is not applied to the ~25 other --font-display call sites,
     most of which sit on white cards. Note the six do NOT share one background:
     the menu header, auth page and Dashboard banner are on --gradient-brand, but
     the About hero is --color-brand-primary under a 70% white scrim over a
     photograph, so the sticker's visibility there can only be judged by eye.

     ALWAYS pair this with `font-weight: 700` in the same rule. The bare h1/h2/h3
     defaults further down this file are 600, and Lobster Two ships only 700 — so a
     retro-faced element left at 600 is not rendered thin, it is SYNTHESISED bold by
     the browser, which smears the outlines and fills in the counters of a script
     face. That cannot be enforced from the token; it has to be repeated per rule.

     It deliberately does NOT replace --font-display. That token is read in 27
     places, several of them 15-19px (chart labels, empty-state titles), where a
     display script is illegible, and Lobster Two sets ~20% wider than Fredoka,
     which wraps or clips inside tight flex rows.

     The fallback chain ends at var(--font-display) rather than at a generic
     sans, so a blocked or failed font request degrades to Fredoka — the string
     still reads as a heading instead of falling back to the body face.

     The shadow offset is physical (down and right), so it does not mirror under
     dir="rtl". Nothing in this app sets direction today, but the 0.06em x offset
     would have to become -0.06em if it ever does. */
  --font-display-retro: 'Lobster Two', var(--font-display);

  /* The hard offset "sticker" shadow that goes with it.
     em, not px: a fixed 3px reads as a mistake at 28px and all but disappears
     at 36px, whereas 0.06em tracks the rendered size on its own. Zero blur and
     zero spread is deliberate — a soft shadow is a drop shadow, not this.

     --color-brand-accent (#ffc53d) against --color-ink (#3d2b45) measures
     8.16:1, so the glyph gets MORE contrast over its own shadow than it had
     over the plain surface, which matters on the About hero where the scrim
     only clears AA by 0.11. That advantage is specific to --color-ink: the same
     gold behind --color-sunny-ink measures 3.72:1 and behind --color-ink-soft
     4.06:1, both under the 4.5:1 that body text owes. check-contrast.mjs
     asserts those so the treatment cannot be quietly applied to a non-plum ink. */
  --display-sticker-shadow: 0.06em 0.06em 0 var(--color-brand-accent);

  /* A second scale of the same effect, for text that is NOT display-sized.

     --display-sticker-shadow is expressed in em on purpose, so the offset
     tracks the rendered size. That is right for the four display strings and
     quietly wrong for the two small ones: 0.06em is 2.16px at the About hero's
     36px, but only 1.1px at the footer's 18px or the toolbar's 19px — roughly a
     third of the visual weight, which reads as "black text" rather than as a
     decal. One token was silently doing two different jobs.

     0.09em puts the small surfaces at 1.6-1.7px, which is about the same
     absolute weight as the display strings without the heavier look. Chosen as
     the subtle end of that range deliberately.

     Both scales are safe for contrast wherever they are used, because the gold
     lands UNDER the glyph and plum on gold is 8.16:1 — better than plum on
     powder (7.20:1) or on white (13.10:1 is the card case, and 7.20:1 on the
     toolbar). The gold's own edge against the surface is the decorative part and
     is asserted at 1.05 in check-contrast.mjs: 1.13 on powder, 1.58 on white. */
  --display-sticker-shadow-small: 0.09em 0.09em 0 var(--color-brand-accent);

  /* ── Flavour pastels ───────────────────────────────────────────────────
     One pastel per catalogue flavour, so the Products page's filter chips can
     be colour-coded. Derived, not invented: every value below was measured
     twice before it was accepted —

       plum on it            >= 4.5:1, because the chip label is --color-ink at
                             13px. All nine clear it; Chocolates is the tightest
                             at 5.32:1 and Vanilla the loosest at 10.01:1.
       it on --color-cream   >= 1.2:1, so no chip dissolves into the page. This is
                             the check that actually moved values: Vanilla began
                             at #f4ecd9, which is 1.13:1 against the cream page
                             and was barely a chip at all.

     WHY THESE THREE BEIGES LOOK SEPARATE. Vanilla, Coffee and Cookies & Cream
     are all pale and warm, so they cannot be told apart on lightness — pushing
     them apart that way stops them being pastel. They are separated by CHROMA
     and HUE instead: the first two stay warm (43deg, 35deg) and Cookies & Cream
     swings to a cool near-grey at 197deg with saturation 0.11. Measured
     perceptual spread across the three is 1.08, against 0.35 for a
     lightness-based attempt.

     Option C was tried and rejected: a real mid-brown Coffee at #b5824f is only
     3.85:1 against the plum label, so it FAILS. There is no way back from that
     without a second label colour for one chip.

     Every one of these is asserted in check-contrast.mjs against both criteria. */
  --flavor-chocolate: #c4a07c;
  --flavor-vanilla: #eee2c4;
  --flavor-strawberry: #f7bcc8;
  --flavor-mango: #f8c88a;
  --flavor-ube: #d9c8ee;
  --flavor-mint: #bfe9d5;
  --flavor-coffee: #e3c396;
  --flavor-cookies-cream: #dde2e4;
  --flavor-pistachio: #d6e8b8;

  /* The "All" chip, and the fallback for any flavour missing from the map above.
     Deliberately NOT a flavour colour — "All" is the no-filter state, and powder
     is already the app's primary surface (toolbar, primary buttons, active nav
     row), so it reads as "everything" rather than as a tenth flavour. Verified
     not to collide with any of the nine: the closest by hue is mint at 48
     degrees (green against blue), then ube at 68. */
  --flavor-all: var(--color-brand-primary);

  /* The drawer's selected row — customer Menu and Admin Panel alike, plus the
     cart badge ring, which derives from the same value. One token, three
     effects, so it is named for the role rather than inlined at each site.

     The value is --flavor-ube, not a new colour. It was already in the palette
     for the Ube flavour chip, and the high-contrast block independently uses the
     same #d9c8ee for --tile-powder, so this ties the drawer to the flavour system
     rather than inventing a tenth hue.

     Neither obvious purple works, and the reason is the same for both: the idle
     rows are transparent over ion-menu's WHITE surface, so the selected fill is
     judged against white, not against the cream page — a harsher test than
     anywhere else in the app.

       --tile-periwinkle #e8eef9   1.16:1 vs white   FAIL - no edge at all
       --tile-powder     #e4f1f8   1.15:1 vs white   FAIL - the same trap
       this value        #d9c8ee   1.56:1 vs white   the floor is 1.2

     Plum on it is 8.25:1. That pairing is same-hue — the label is itself a
     desaturated purple — but the lavender is far lighter than the plum, so it
     measures comfortably rather than going muddy. The old mint gave 7.41:1, so
     the label is actually easier to read than before.

     If a future edit swaps this for a --tile-* value, check the two "REJECTED"
     rows in check-contrast.mjs before anything else. */
  --nav-active: var(--flavor-ube);

  --ion-font-family: var(--font-body);

  // ── App chrome ───────────────────────────────────────────
  --ion-background-color: var(--color-cream);
  --ion-text-color: var(--color-ink);
  --ion-toolbar-background: var(--color-brand-primary);
  // Plum, not white: the toolbar sits on a pastel, where white measures 1.79:1
  // and is unreadable.
  --ion-toolbar-color: var(--color-ink);
}

// ── Typography Scale ─────────────────────────────────────────
h1,
h2,
h3,
h4 {
  font-family: var(--font-display);
  color: var(--color-ink);
}
// Bare element selectors carry no weight against component-scoped rules, so
// headings inside cards were being overridden by `.card-title` etc. anyway.
h1 {
  font-size: 28px;
  font-weight: 600;
  line-height: 1.2;
}
h2 {
  font-size: 22px;
  font-weight: 600;
  line-height: 1.25;
}
h3 {
  font-size: 18px;
  font-weight: 600;
  line-height: 1.3;
}
h4 {
  font-size: 15px;
  font-weight: 700;
  line-height: 1.35;
}

// ── Global Component Defaults ─────────────────────────────────
/* No `!important` here. The previous version had it, which silently killed six
   box-shadows and four border-radii declared in per-page SCSS. Those
   declarations are now live, and this rule is only the default for cards that
   don't set their own. */
ion-card {
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
}

ion-button {
  --border-radius: var(--radius-control);
  font-weight: 700;
}

ion-toolbar {
  --background: var(--color-brand-primary);
  --color: var(--color-ink);
}

/* Every page's toolbar title, in the retro face.
   This is genuinely ONE rule: before it there was no `ion-title` styling in the
   project at all, and all ~19 toolbars are authored per page but styled here.
   That is the opposite of the drawer, where each page owns its own header.

   NO text-shadow, and this one is a judgement rather than a rule: powder blue is
   a brand hue so the gold would technically read (1.13:1, the weakest of the
   three), but toolbar text is small and a 0.06em offset on a 19px script is well
   under a pixel of gold. On the big display strings it reads as a decal; here it
   reads as mud. So: family only.

   font-weight 700 restated, for the same reason as every other retro string —
   Lobster Two has no 600, and an unstated weight would inherit the `h2`-style 600
   default and be synthetically emboldened.

   Size: 19px, against Ionic's default toolbar title size of roughly 17px. Raised
   because a script face needs it, but not further — this sits in a fixed-height
   56px toolbar and the real constraint is width, below.

   WIDTH IS THE ACTUAL RISK HERE, and it is not the shadow. Ionic renders the
   title into `.toolbar-title`, which is `width:100%; overflow:hidden;
   text-overflow:ellipsis; white-space:nowrap`, inside a slot CENTRED between the
   left and right button groups. It clips rather than wraps, and Lobster Two sets
   ~20% wider than the face it replaces.

   Every ion-title in the app was measured at 320/390/768px with a button group
   either side: none ellipsise and none collide at 19px. The titles carrying the
   risk are the long ones, and the full list of 14 characters or more is:

     17  Inventory Manager    admin/inventory/inventory.page.html
     16  Order Fulfillment    admin/orders/admin-orders.page.html
     15  Sales Analytics      admin/analytics/analytics.page.html
     14  Bulk import flavors  admin/inventory/csv-import-modal (a MODAL, and
                               modals are narrower than pages at 320px)
     14  Product Detail       products/product-detail — see below

   Nothing breaks, because `.toolbar-title` ellipsises rather than overflowing,
   but a truncation in a script face looks worse than one in a geometric sans.
   `ion-title` has no shrink mechanism short of abandoning the face, so the lever
   is the copy: the drawer already calls the analytics page "Analytics", and
   "Bulk Import" would read the same. Both are copy decisions rather than CSS
   ones, so neither has been changed here.

   The product-detail title is different in kind, because it is not authored:
   `{{ product()?.variantName ?? 'Product Detail' }}` interpolates a name that
   came from a CSV import and is therefore unbounded. A 25-character flavour name
   will ellipsise. There is no CSS fix for that and none is needed — the worst
   case is a visible truncation, not a broken layout — but it is the one title on
   this rule whose length no one controls. */
ion-title {
  font-family: var(--font-display-retro);
  font-weight: 700;
  font-size: 19px;
  line-height: 1.1;
  /* The small-scale token, not the display one: at 19px the 0.06em display
     offset is 1.1px and effectively invisible, while 0.09em gives 1.7px — enough
     to read as a warm edge behind the letters without turning a toolbar into a
     sticker. See --display-sticker-shadow-small for why there are two scales.

     Safe on powder, and slightly BETTER for the glyph than having no shadow:
     plum on the gold is 8.16:1 against plum on powder's 7.20:1. */
  text-shadow: var(--display-sticker-shadow-small);
}

/* Toolbar controls need the INK colour, not white. Ionic derives a toolbar
   button's colour from the toolbar's own text colour, so with the toolbar on a
   pastel these would otherwise render white-on-powder at 1.79:1.

   The original note here described a different bug — a bare <ion-button> picking
   up `.button-clear`'s `--color: var(--ion-color-primary)`, which is now the
   same pastel as the toolbar background, i.e. powder-on-powder. Naming the
   contrast token explicitly fixes that case too, because
   `--ion-color-primary-contrast` is plum. */
ion-toolbar ion-button,
ion-menu-button,
ion-back-button {
  --color: var(--ion-color-primary-contrast, #3d2b45);
}

// ── Focus visibility ─────────────────────────────────────────
/* The audit found only three `:focus-visible` rules in the entire app, none of
   them global, so ~20 custom buttons (qty steppers, remove buttons, mode tabs,
   the wishlist button, the promo banner) fell back to the user-agent ring — which
   is near-invisible on cream and on the pastel toolbar. This is the one place
   that fixes all of them at once.

   `:focus-visible` rather than `:focus` so a mouse click does not leave a ring
   behind, while keyboard and switch-access users always get one. */
:focus-visible {
  outline: 3px solid var(--color-primary-ink);
  outline-offset: 2px;
  border-radius: var(--radius-xs);
}

// ── Motion ──────────────────────────────────────────────────
/* There was NO prefers-reduced-motion handling anywhere in the app, while
   running ~20 unguarded transitions, 7 animated skeletons and 2 pull-to-refresh
   spinners. This collapses all of them for users who ask for it.

   The `*` selector is deliberate and is the standard technique — it forces the
   effective duration of every animation and transition to be 0.01ms rather than
   having to enumerate them, which is what makes it robust against the styles
   that have not been written yet.

   The `[data-motion='reduced']` twin lets the Settings page turn this on from
   inside the app. It is a second selector rather than a class toggle so the
   preference can be written to the document element and observed by CSS without
   a stylesheet swap. */
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}

html[data-motion='reduced'] *,
html[data-motion='reduced'] *::before,
html[data-motion='reduced'] *::after {
  animation-duration: 0.01ms !important;
  animation-iteration-count: 1 !important;
  transition-duration: 0.01ms !important;
  scroll-behavior: auto !important;
}

// ── High contrast (Settings) ─────────────────────────────────
/* Powder blue on cream is a comfortable 7.20:1 but the pastel TIEL behind icons
   are near-white, so a pastel-on-pastel detail (a mint border on a mint tile)
   drops below the 3:1 that WCAG 1.4.11 asks of non-text UI. This darkens the
   inks and the borders without touching the brand hues themselves, so the page
   still looks like the same product. */
html[data-contrast='high'] {
  --color-ink: #241833;
  --color-ink-soft: #4a3a54;
  --ion-color-medium: #5b4c66;
  --color-brand-light: #a8d9b8;
  --tile-powder: #cfe4f2;
  --tile-mint: #cdead9;
  --tile-lemon: #fbe9be;
  --tile-blush: #f8d2dd;
  --tile-periwinkle: #d3ddf7;
  --tone-success-border: #4f9a6c;
  --tone-warning-border: #a8791c;
  --tone-danger-border: #c25c7c;
  --tone-info-border: #4c82b0;
}

// ── Wave / Drip ─────────────────────────────────────────────
/* The one place the brief's "wave and drip" motif is allowed to appear.
   Per the design direction it is deliberately NOT a texture applied to every
   surface — it is a single distinctive element, used on hero and empty states,
   so it reads as a deliberate brand mark rather than decoration everywhere. */
.wave-drip {
  position: relative;
  overflow: hidden;
}

/* A soft cream swell along the bottom edge — used to close a hero section. */
.wave-drip::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: -1px;
  height: 28px;
  background: var(--color-cream);
  border-radius: 100% 100% 0 0 / 100% 100% 0 0;
}
</file>

<file path="src/global.scss">
/* Five-orites Scoop — Global Styles */
@import '@ionic/angular/css/core.css';
@import '@ionic/angular/css/normalize.css';
@import '@ionic/angular/css/structure.css';
@import '@ionic/angular/css/typography.css';
@import '@ionic/angular/css/display.css';
@import '@ionic/angular/css/padding.css';
@import '@ionic/angular/css/float-elements.css';
@import '@ionic/angular/css/text-alignment.css';
@import '@ionic/angular/css/text-transformation.css';
@import '@ionic/angular/css/flex-utils.css';

/* Large centered card modals (admin forms) — bigger and more presentable
   than the default small alert dialogs. */
.large-sheet-modal {
  --width: min(680px, 94vw);
  --height: min(720px, 92vh);
  --border-radius: 18px;
}

/* ── Layout utilities ────────────────────────────────────────────────────
   Before these, every page hand-rolled its own wrapper. The audit found
   `.profile-wrap` capping at 640px while `.about-body` had no max-width at all,
   so the same content went full-bleed edge-to-edge on a tablet on one page and
   stayed readable on the next. These are the shared answer.

   `.container` is the standard centred column; `.page-shell` is the same thing
   with the page's vertical padding already applied, which is what most page
   bodies actually want. */
.container,
.page-shell {
  width: 100%;
  max-width: var(--container-max);
  margin-inline: auto;
  padding-inline: var(--space-4);
}

.page-shell {
  padding-block: var(--space-4) var(--space-6);
}

/* A narrower measure for long-form prose. `.story-text` on About had this inline
   as 68ch; it is a token now because it is a typographic decision, not a layout
   one. */
.measure {
  max-width: var(--measure-max);
}

/* ── Breakpoint helpers ─────────────────────────────────────────────────
   CSS custom properties cannot be used in a media query condition, so these
   are literal values. They exist so a page can respond to a width without
   inventing its own threshold, and they mirror --bp-* in variables.scss.
   `.stack-md` is the workhorse: it stacks on a phone and becomes a row from
   tablet up, which is the layout the tracking page and the admin split views
   both need. */
@media (min-width: 480px) {
  .bp-sm-up {
    display: revert;
  }
}

@media (min-width: 768px) {
  .bp-md-up {
    display: revert;
  }
  .stack-md {
    flex-direction: row;
  }
  .stack-md > * {
    flex: 1 1 0;
    min-width: 0;
  }
}

@media (min-width: 1024px) {
  .bp-lg-up {
    display: revert;
  }
  .stack-lg {
    flex-direction: row;
  }
  .stack-lg > * {
    flex: 1 1 0;
    min-width: 0;
  }
}

/* Hidden by default, revealed from a breakpoint up. */
.bp-only {
  display: none;
}
@media (min-width: 768px) {
  .bp-md-only {
    display: revert;
  }
}

/* ── Toggle switches ─────────────────────────────────────────────────────
   All six ion-toggles in this app previously rendered with stock Ionic
   theming and zero overrides, so they were whatever --ion-color-primary
   happened to be — including a pill track with a plum handle. One place to
   restyle them, so every switch matches.

   The track is a muted surface and the handle is white, which is the modern
   convention: the ON state is indicated by the track filling with the brand
   colour, not by the handle changing. That also means the handle is identical
   in both states, so nothing shifts when the switch moves. */
ion-toggle {
  --track-background: var(--ion-color-light-shade);
  --track-background-checked: var(--color-brand-primary);
  --handle-background: var(--color-white);
  --handle-background-checked: var(--color-white);
  --handle-width: 22px;
  --handle-height: 22px;
  --handle-spacing: 3px;
  --handle-box-shadow: 0 2px 5px rgba(61, 43, 69, 0.28);
  --border-radius: 999px;
}

/* The track's ON fill is a pastel, so it needs an edge to read as "on" — the
   same reasoning as the selected-state borders elsewhere. */
ion-toggle::part(native)::after {
  border-radius: 999px;
}

ion-toggle.toggle-checked::part(native) {
  border: 1px solid var(--color-primary-ink);
}

/* ── Map pins ─────────────────────────────────────────────────────────────
   These MUST live here, not in a component stylesheet.

   The tracking map builds its markers with Leaflet's divIcon, whose `html` is
   injected into the map pane as raw DOM — outside Angular's view encapsulation.
   A rule in ScoopMapComponent's `styles` would be scoped with an _ngcontent
   attribute that the injected markup does not carry, so it would never match and
   the pins would render as invisible 18px boxes. */
.scoop-pin {
  background: none;
  border: none;
}

.scoop-pin-dot {
  display: block;
  width: 18px;
  height: 18px;
  border-radius: 50%;
  border: 3px solid var(--color-white);
  box-shadow: 0 2px 6px rgba(61, 43, 69, 0.35);
}

.scoop-pin-dot.tone-primary {
  background: var(--color-brand-primary);
}
.scoop-pin-dot.tone-mint {
  background: var(--color-brand-light);
}
.scoop-pin-dot.tone-sunny {
  background: var(--color-brand-accent);
}
.scoop-pin-dot.tone-danger {
  background: var(--ion-color-danger);
}

/* Leaflet ships a light default popup chrome; matching it to the cream surface
   keeps the map from flashing a white box against the page. */
.leaflet-popup-content-wrapper {
  border-radius: var(--radius-sm);
  background: var(--color-white);
  box-shadow: var(--shadow-float);
  font-family: var(--font-body);
  color: var(--color-ink);
}

.leaflet-popup-tip {
  background: var(--color-white);
}

/* Leaflet's default control buttons are grey-on-white squares, which look like a
   different design system dropped onto the page. */
.leaflet-bar a {
  color: var(--color-ink);
  background: var(--color-white);
  border-bottom-color: var(--ion-color-light-shade);
}

.leaflet-bar a:hover {
  background: var(--color-brand-light);
}

.leaflet-control-attribution {
  background: rgb(255 255 255 / 0.85);
  color: var(--ion-color-medium);
  font-size: 10px;
}

/* ── Segmented controls ──────────────────────────────────────────────────────
 *
 * Ionic gives a checked `ion-segment-button` the primary for BOTH its label
 * (--color-checked) and the indicator behind it (--indicator-color). With
 * --ion-color-primary set to a pastel, that is the label painted on its own
 * background: measured at 1.00:1 on /products, /admin/orders and /admin/analytics.
 *
 * Fixed once, here, rather than in three page stylesheets. Each of those pages styles
 * its own segment and none of them fixed this, because the cause is the Ionic default
 * and not any local rule - the same drift shape as everything else in this project.
 *
 * --color is set as well as --color-checked: the unchecked label was legible, but
 * leaving it to inherit a shadown of a pastel is the same fragility one theme variable
 * away. Ink on both is 7.20:1 on the powder indicator and far higher off it.
 */
ion-segment-button {
  --color: var(--color-ink);
  --color-checked: var(--color-ink);

  /* THIS LINE IS NOT OPTIONAL, and getting it wrong is how the first attempt at this
     fix traded one 1.00:1 for another. --indicator-color DEFAULTS TO --color, not to
     the primary: declaring ink for the label therefore propagated ink into the pill
     the label sits on, and the checked label measured ink-on-ink. Declaring the
     indicator restores the brand pill, and ink on powder is 7.20:1. */
  --indicator-color: var(--color-brand-primary);
}

/* ── Outline buttons ──────────────────────────────────────────────────────────
 *
 * An `ion-button fill="outline"` with no declared foreground inherits
 * --ion-color-primary, and this app's primary is a pastel. Measured on the live pages:
 * "Bulk Restock" 1.71:1, "Run reconciliation check" 1.79:1, "Apply Voucher" 1.71:1,
 * "Wishlist" 1.71:1, "Clear Cart" 1.79:1 - all powder on cream or white, none of them
 * below AA, all of them shipping.
 *
 * Fixed once here rather than by adding a class to each of five buttons across four
 * pages, which is what had been happening, and which is how the sixth one arrived while
 * the fifth was being fixed.
 *
 * The :where() is load-bearing. Written as `ion-button[fill="outline"]` this selector
 * has specificity (0,1,1) and would BEAT a `.cancel-order-btn` class at (0,1,0),
 * silently repainting the destructive Cancel buttons on /orders and the order tracker
 * back to powder. :where() contributes nothing, so the rule sits at (0,0,1) and every
 * explicit class still wins - which is what a default should do. */
ion-button:where([fill='outline']) {
  --color: var(--color-primary-ink);
}
/* ── Scroll-area layout ───────────────────────────────────────────────────────
   ion-content's scroll element is display: block, so slottable children stack
   in normal flow. When a page's content is SHORTER than the viewport, the
   <app-footer> stops after the last card and the leftover space sits BELOW it
   as dead cream. Measured at 128px on /about in a 1600x2600 viewport, and absent
   at 390px wide because the stacked mobile layout is about 1.8x taller.

   Making the scroll element a column flexbox lets the footer's auto margin
   absorb that free space.

   `flex: 0 0 auto` on the children is NOT optional. Flex items shrink by
   default and block children never did, so without it a long page compresses to
   fit instead of scrolling.

   The exposed part is `scroll`, NOT `inner-scroll`. The latter is the CSS class
   inside the shadow root; the part attribute is `scroll`. Using the class name
   silently matches nothing. */
ion-content::part(scroll) {
  display: flex;
  flex-direction: column;
}
ion-content > * {
  flex: 0 0 auto;
}
</file>

<file path="angular.json">
{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "app": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "www",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "src/assets",
                "output": "assets"
              },
              // Leaflet's default marker/layer sprites. leaflet.css references
              // these by relative URL and the esbuild application builder copies
              // nothing out of node_modules unless a glob says so. Without this
              // the map renders with invisible zoom and attribution controls.
              {
                "glob": "**/*",
                "input": "node_modules/leaflet/dist/images",
                "output": "assets/leaflet"
              }
            ],
            // ORDER IS LOAD-BEARING. Leaflet must come first: the entries below it
            // define global element overrides (ion-card, ion-toolbar, ion-button)
            // that should win specificity ties against Leaflet's own component
            // styles deliberately rather than by accident. Both files land in one
            // concatenated stylesheet, so array order is the only tiebreaker.
            "styles": ["node_modules/leaflet/dist/leaflet.css", "src/theme/variables.scss", "src/global.scss"],
            "scripts": []
          },
          "configurations": {
            "production": {
              // Budget notes. `initial` was 1.7mb/2.5mb against a MEASURED baseline
              // of 1.546mb across 19 initial files — only ~150kb of headroom, which
              // the web fonts and Leaflet's CSS consumed on their own. Raised to
              // 2.2/3.2 so the build still fails loudly rather than being switched
              // off.
              //
              // `anyComponentStyle` was 5kb/8kb. src/theme/variables.scss is EXEMPT
              // from it (it is a global stylesheet, so it counts toward `initial`),
              // which means a token-heavy redesign pushes its growth onto per-
              // component styles instead. cart.page.scss and inventory.page.scss
              // were the two closest to the old 5kb warning.
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2.2mb",
                  "maximumError": "3.2mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "16kb",
                  "maximumError": "24kb"
                }
              ],
              "outputHashing": "all",
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            // The SAFE development configuration, and the one `npm start` uses.
            //
            // It exists because `development` above resolves to `environment.ts`,
            // which hard-codes the production projectId — so plain `npm start`
            // served a fully working admin app backed by the real database. Every
            // control there writes.
            //
            // Swapping in `environment.emulator.ts` is what makes the app connect to
            // the Firestore and Auth emulators that `firebase.json` has been
            // configuring all along. Reachable explicitly as `npm run serve:prod`,
            // because someone occasionally does need to look at real data, and
            // because a deliberately-requested production connection is defensible
            // in a way an accidental one is not.
            "emulator": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.emulator.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "app:build:production"
            },
            "development": {
              "buildTarget": "app:build:development"
            },
            "emulator": {
              "buildTarget": "app:build:emulator"
            },
            // Explicit opt-in to talking to the real project from a dev server.
            "prod": {
              "buildTarget": "app:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  },
  "cli": {
    "analytics": "d4b068be-2c19-4d7a-ba8b-762f814d80c7"
  }
}
</file>

<file path="firebase.json">
{
  "//": "Five-orites Scoop — Firebase Deployment Configuration",
  "hosting": {
    "public": "www/browser",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "//": "ORDER IS LOAD-BEARING. Firebase combines the headers of every matching rule, and where two rules set the same header the LAST one wins. The broad `**` rule therefore declares no-store FIRST and the hashed-asset rule overrides it SECOND. Reverse them and every bundle silently loses its year-long cache.",
        "source": "**",
        "headers": [
          {
            "//": "The SPA shell must never be cached, and this rule is deliberately `**` rather than `/index.html`. Firebase matches headers on the REQUEST path, and every route here (`/developers`, `/admin/users`, `/checkout`) is served by the `**` rewrite to index.html - so a rule scoped to `/index.html` would leave every deep link cached. Firebase's default for an unconfigured path is max-age=3600, which is exactly what was happening: index.html carried an hour-long cache while the content-hashed bundles under it carried a year. A browser holding a cached shell therefore kept requesting the PREVIOUS deploy's chunk hashes for up to an hour after a release. That is not theoretical - it is how a shipped fix to /developers kept looking broken on a real device.",
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
          { "key": "X-Content-Type-Options", "value": "nosniff" }
        ]
      },
      {
        "//": "These filenames are content-hashed by the Angular build (`main-3THZSKJH.js`), so the bytes at a given URL can never change. `immutable` also stops browsers revalidating them on reload.",
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "functions",
    "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"],
    "ignore": ["node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log", "*.local"]
  },
  "emulators": {
    "auth": { "port": 9099 },
    "functions": { "port": 5001 },
    "firestore": { "port": 8080 },
    "hub": { "port": 4400 },
    "ui": { "enabled": true, "port": 4000 },
    "singleProjectMode": true
  }
}
</file>

<file path="src/app/admin/inventory/add-product-modal.component.ts">
// src/app/admin/inventory/add-product-modal.component.ts
// Five-orites Scoop — Add Product form (dropdown + New option)

import { Component, Input, inject } from '@angular/core';
import { CommonModule } from '@angular/common';
import { FormsModule } from '@angular/forms';
import {
  IonHeader,
  IonToolbar,
  IonTitle,
  IonContent,
  IonButtons,
  IonButton,
  IonList,
  IonItem,
  IonSelect,
  IonSelectOption,
  IonInput,
  IonTextarea,
  ModalController,
  ToastController,
} from '@ionic/angular/standalone';
import { AppIconComponent } from '../../shared/components/app-icon/app-icon.component';
import { InventoryService } from '../../core/services/inventory.service';
import { ImageUploadService } from '../../core/services/image-upload.service';
import { SET_NAMES, SIZE_DISPLAY_LABELS, getPricingForSet } from '../../core/config/pricing.config';
import { SizeVariant } from '../../core/models/product.model';
import { SIZE_VARIANTS, totalStock } from '../../core/logic/stock';

@Component({
  selector: 'app-add-product-modal',
  standalone: true,
  imports: [
    CommonModule,
    FormsModule,
    IonHeader,
    IonToolbar,
    IonTitle,
    IonContent,
    IonButtons,
    IonButton,
    IonList,
    IonItem,
    IonSelect,
    IonSelectOption,
    IonInput,
    IonTextarea,
    AppIconComponent,
  ],
  template: `
    <ion-header>
      <ion-toolbar color="primary">
        <ion-title>Add Product</ion-title>
        <ion-buttons slot="end">
          <ion-button (click)="cancel()">Close</ion-button>
        </ion-buttons>
      </ion-toolbar>
    </ion-header>

    <ion-content class="ion-padding">
      <ion-list>
        <ion-item>
          <ion-select
            label="Flavor Set"
            labelPlacement="stacked"
            interface="popover"
            [(ngModel)]="selectedSet"
            (ionChange)="onSetChange()"
          >
            @for (s of sets; track s.value) {
              <ion-select-option [value]="s.value">
                Set {{ s.value }} · {{ s.label }}
              </ion-select-option>
            }
            <ion-select-option value="new">✨ New flavor set…</ion-select-option>
          </ion-select>
        </ion-item>

        @if (isNewSet) {
          <ion-item>
            <ion-input
              label="New set name"
              labelPlacement="stacked"
              placeholder="e.g. Pistachio"
              [(ngModel)]="newSetName"
            ></ion-input>
          </ion-item>
          <ion-item>
            <ion-input
              label="Variant name"
              labelPlacement="stacked"
              placeholder="e.g. Roasted Pistachio"
              [(ngModel)]="variantName"
            ></ion-input>
          </ion-item>
        } @else {
          <ion-item>
            <ion-select
              label="Variant name"
              labelPlacement="stacked"
              interface="popover"
              placeholder="Choose a variant…"
              [(ngModel)]="selectedVariant"
            >
              @for (v of availableVariants; track v) {
                <ion-select-option [value]="v" [disabled]="!isVariantActive(v)">
                  {{ v }}{{ isVariantActive(v) ? '' : ' — inactive' }}
                </ion-select-option>
              }
              <ion-select-option value="new">✨ New variant…</ion-select-option>
            </ion-select>
          </ion-item>

          @if (isNewVariant) {
            <ion-item>
              <ion-input
                label="New variant name"
                labelPlacement="stacked"
                placeholder="e.g. Rocky Road"
                [(ngModel)]="customVariant"
              ></ion-input>
            </ion-item>
          }
        }

        <!--
          No Type control. Everything this form can create is a flavor, so the
          dropdown was a decision the admin almost never needed to make and had
          no good answer for in the one case that mattered. See the category field
          in create() for why the value is still written.
        -->

        <ion-item>
          <ion-textarea
            label="Description"
            labelPlacement="stacked"
            placeholder="Describe this flavor…"
            rows="3"
            [(ngModel)]="description"
          ></ion-textarea>
        </ion-item>

        <!--
          Initial stock, entered at creation instead of afterwards.

          It used to be hardcoded to zero and the success toast said "Set its
          stock next", so every new product started unbuyable and had to be
          hunted down on the inventory card. Zeros are still the default — a
          flavor catalogued before it is stocked is an ordinary case — but the
          count can now be typed once instead of dialled in one tap at a time.

          Plain number boxes, deliberately NOT steppers: a stepper is right for
          nudging a live figure by one (that is what the inventory card is for)
          and wrong for entering twenty. The split is intentional, not an
          oversight.
        -->
        <h3 class="section-title">Initial stock</h3>
        <p class="section-note">Units on hand right now. Leave at 0 to fill it in later.</p>
        <div class="stock-grid">
          @for (f of stockFields; track f.key) {
            <ion-item>
              <ion-input
                [label]="f.label"
                labelPlacement="stacked"
                type="number"
                inputmode="numeric"
                min="0"
                step="1"
                placeholder="0"
                [ngModel]="stockInput[f.key]"
                (ngModelChange)="onStockInput(f.key, $event)"
              ></ion-input>
            </ion-item>
          }
        </div>
        @if (stockError) {
          <p class="field-error">{{ stockError }}</p>
        }

        <h3 class="section-title">Product Image (optional)</h3>
        <div
          class="img-box"
          (click)="fileInput.click()"
          (keydown.enter)="fileInput.click()"
          (keydown.space)="fileInput.click(); $event.preventDefault()"
          tabindex="0"
          role="button"
          aria-label="Choose image from device"
        >
          @if (previewImage) {
            <img [src]="previewImage" alt="Product image preview" class="img-box-fill" />
            <span class="img-box-change">Tap to change</span>
          } @else {
            <div class="img-box-empty">
              <app-icon name="image" class="img-box-icon" />
              <span>Tap to choose image from device</span>
            </div>
          }
        </div>
        <input #fileInput type="file" accept="image/*" hidden (change)="onFilePicked($event)" />
        @if (pendingFile) {
          <ion-button expand="block" fill="clear" size="small" color="medium" (click)="clearFile()">
            Remove device image
          </ion-button>
        }
        @if (!uploadService.isConfigured) {
          <p class="config-hint">
            ⚠️ Cloudinary is not set up yet — fill cloudName + uploadPreset in environment.ts to
            enable image uploads.
          </p>
        }
      </ion-list>

      <ion-button expand="block" (click)="create()" [disabled]="isSaving" class="create-btn">
        {{
          isUploading
            ? 'Uploading image…'
            : isSaving
              ? 'Creating…'
              : isNewSet
                ? 'Create New Set'
                : 'Create Product'
        }}
      </ion-button>
    </ion-content>
  `,
  styles: [
    `
      .create-btn {
        --background: var(--color-brand-primary);
        --border-radius: 10px;
        font-weight: 700;
        margin-top: 16px;
      }
      .section-title {
        font-size: 14px;
        font-weight: 800;
        color: var(--ion-color-dark);
        margin: 18px 2px 4px;
      }
      .section-note {
        margin: 0 2px 4px;
        font-size: 12px;
        line-height: 1.4;
        color: var(--ion-color-medium);
      }
      /* Two columns of stock boxes rather than four stacked rows — the four
         sizes are a set the admin reads ACROSS, not a list they read down.
         Same treatment as the pricing grid in the edit modal. */
      .stock-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0 8px;
      }
      @media (max-width: 380px) {
        .stock-grid {
          grid-template-columns: 1fr;
        }
      }
      .field-error {
        margin: 8px 2px 0;
        font-size: 12px;
        font-weight: 600;
        color: var(--color-danger, #c62828);
      }
      .img-box {
        position: relative;
        min-height: 180px;
        border-radius: 14px;
        overflow: hidden;
        cursor: pointer;
        border: 2px dashed var(--ion-color-medium, #999);
        background: var(--ion-color-light);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 4px 2px 0;
      }
      .img-box-empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        padding: 28px 12px;
        color: var(--ion-color-medium);
        font-size: 13px;
        font-weight: 600;
        text-align: center;
      }
      .img-box-icon {
        font-size: 44px;
      }
      .img-box-fill {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .img-box-change {
        position: absolute;
        bottom: 10px;
        left: 50%;
        transform: translateX(-50%);
        background: rgba(0, 0, 0, 0.65);
        color: #fff;
        font-size: 12px;
        font-weight: 600;
        padding: 4px 14px;
        border-radius: 20px;
        white-space: nowrap;
      }
      .config-hint {
        font-size: 12px;
        color: var(--ion-color-warning-shade, #9a6b00);
        margin: 6px 2px 0;
      }
    `,
  ],
})
export class AddProductModalComponent {
  private inventoryService = inject(InventoryService);
  private modalCtrl = inject(ModalController);
  private toastCtrl = inject(ToastController);
  readonly uploadService = inject(ImageUploadService);

  /**
   * The highest set number currently in use; the new product gets `+ 1`.
   *
   * The default is 0, not 8. This was 8, which was wrong twice over: the live
   * catalogue has NINE sets — `SET_NAMES` in pricing.config.ts stops at 8 and so
   * does `PRICING_MATRIX` in scripts/seed-products.ts — and an empty catalogue
   * honestly means "no sets yet", so a first product should be Set 1 rather than
   * Set 9. `inventory.page.ts` always passes this prop, so the default is only ever
   * seen if the modal is rendered somewhere else; it is a third copy of the same
   * ceiling and it should not be a fourth.
   */
  @Input() maxSetNumber = 0;
  @Input() variants: {
    setNumber: number;
    setName: string;
    variantName: string;
    isActive: boolean;
  }[] = [];

  /**
   * Built-in sets merged with any admin-created set present in the catalog.
   *
   * This used to list only SET_NAMES (1-8), yet a new set is assigned
   * `maxSetNumber + 1`. Custom sets were therefore unselectable, and creating
   * two of them collided on the same set number.
   */
  get sets(): { value: string; label: string }[] {
    const byNumber = new Map<number, string>();
    for (const [k, v] of Object.entries(SET_NAMES)) byNumber.set(Number(k), v);
    for (const v of this.variants) {
      if (!byNumber.has(v.setNumber)) {
        byNumber.set(v.setNumber, v.setName || `Set ${v.setNumber}`);
      }
    }
    return [...byNumber.entries()]
      .sort((a, b) => a[0] - b[0])
      .map(([n, name]) => ({ value: String(n), label: name }));
  }

  /** Display name for a set number, including admin-created sets. */
  setNameFor(setNumber: number): string {
    return (
      this.sets.find((s) => s.value === String(setNumber))?.label ??
      SET_NAMES[setNumber] ??
      `Set ${setNumber}`
    );
  }

  selectedSet: string = '1';
  selectedVariant: string = '';
  customVariant = '';
  newSetName = '';
  variantName = '';
  description = '';
  pendingFile: File | null = null;
  previewObjectUrl = '';
  isSaving = false;
  isUploading = false;

  /**
   * The four stock boxes, labelled from `SIZE_DISPLAY_LABELS` and ORDERED BY
   * `SIZE_VARIANTS`.
   *
   * Driving both from the shared source is what keeps this section from
   * becoming a third place that has to be edited when a size is added or
   * reordered. (The owner asked for Cup, Pint, Gallon, Half Gallon; that order
   * was not adopted, because it disagrees with the canonical one used by the
   * pricing matrix, the cart and the inventory card.)
   */
  readonly stockFields: readonly { key: SizeVariant; label: string }[] = SIZE_VARIANTS.map((k) => ({
    key: k,
    label: SIZE_DISPLAY_LABELS[k],
  }));

  /**
   * The stock boxes as raw text, not numbers.
   *
   * A `number` model cannot represent what the admin is partway through typing
   * — "" while the field is empty, "-2" while a mistake is being corrected —
   * and coercing on the way in would silently rewrite their typing into
   * something they never wrote. Held raw here, validated on the way out.
   */
  stockInput: Record<SizeVariant, string> = { cup: '', pint: '', halfGallon: '', gallon: '' };

  /**
   * The message for the first size that cannot be written, or null.
   *
   * `sizeIsSane` in firestore.rules is the actual guarantee — a negative or
   * fractional count is rejected server-side whatever this form sends. This
   * exists so the admin gets "Half Gallon must be a whole number of 0 or more"
   * next to the box they typed it into, rather than a rules error after the
   * fact. It is a readable message, not a security boundary.
   *
   * Only the first offending size is named: which box is wrong is a one-glance
   * read, and four simultaneous messages would bury it.
   *
   * An empty box is 0, not an error. A flavor catalogued before it is stocked
   * is an ordinary product, and clearing a box while retyping must not light
   * the form up red.
   */
  get stockError(): string | null {
    for (const { key, label } of this.stockFields) {
      const raw = this.stockInput[key].trim();
      if (raw === '') continue;
      const n = Number(raw);
      if (!Number.isFinite(n) || !Number.isInteger(n) || n < 0) {
        return `${label} must be a whole number of 0 or more.`;
      }
    }
    return null;
  }

  onStockInput(key: SizeVariant, value: unknown): void {
    this.stockInput[key] = value === null || value === undefined ? '' : String(value);
  }

  /** The raw text as the four numbers to write. Only called once validated. */
  private stockLevels(): Record<SizeVariant, number> {
    const out = {} as Record<SizeVariant, number>;
    for (const { key } of this.stockFields) {
      const raw = this.stockInput[key].trim();
      out[key] = raw === '' ? 0 : Number(raw);
    }
    return out;
  }

  get isNewSet(): boolean {
    return this.selectedSet === 'new';
  }

  get isNewVariant(): boolean {
    return this.selectedVariant === 'new';
  }

  get availableVariants(): string[] {
    const set = Number(this.selectedSet) || 0;
    const names = this.variants.filter((v) => v.setNumber === set).map((v) => v.variantName);
    return [...new Set(names)].sort((a, b) => a.localeCompare(b));
  }

  /**
   * A variant with no active row is deactivated, not deleted. It stays in the
   * list so the admin can see it exists, and is told to switch it back on from
   * the inventory list rather than creating a second product with the same name
   * and orphaning the original.
   */
  isVariantActive(name: string): boolean {
    const set = Number(this.selectedSet) || 0;
    return this.variants.some((v) => v.setNumber === set && v.variantName === name && v.isActive);
  }

  onSetChange(): void {
    this.selectedVariant = '';
    this.customVariant = '';
  }

  get previewImage(): string {
    return this.previewObjectUrl;
  }

  onFilePicked(event: Event): void {
    const input = event.target as HTMLInputElement;
    const file = input.files?.[0];
    input.value = '';
    if (!file) return;
    if (!file.type.startsWith('image/')) {
      void this.toast('Please choose an image file.', 'danger');
      return;
    }
    if (this.previewObjectUrl) URL.revokeObjectURL(this.previewObjectUrl);
    this.pendingFile = file;
    this.previewObjectUrl = URL.createObjectURL(file);
  }

  clearFile(): void {
    if (this.previewObjectUrl) URL.revokeObjectURL(this.previewObjectUrl);
    this.pendingFile = null;
    this.previewObjectUrl = '';
  }

  cancel(): void {
    void this.modalCtrl.dismiss();
  }

  async create(): Promise<void> {
    if (this.isSaving) return;

    let setNumber: number;
    let setName: string;
    let variant: string;
    if (this.isNewSet) {
      const name = this.newSetName.trim();
      if (!name) {
        await this.toast('New set name is required.', 'danger');
        return;
      }
      variant = this.variantName.trim();
      if (!variant) {
        await this.toast('Variant name is required.', 'danger');
        return;
      }
      setNumber = this.maxSetNumber + 1;
      setName = name;
    } else {
      setNumber = Number(this.selectedSet) || 1;
      setName = this.setNameFor(setNumber);
      if (this.isNewVariant) {
        variant = this.customVariant.trim();
        if (!variant) {
          await this.toast('New variant name is required.', 'danger');
          return;
        }
      } else {
        variant = this.selectedVariant;
        if (!variant) {
          await this.toast('Choose a variant, or pick New variant…', 'danger');
          return;
        }
        // Defence in depth: the option is disabled in the list, but a popover can
        // still be driven by keyboard/assistive tech, so re-check on submit.
        if (!this.isVariantActive(variant)) {
          await this.toast(
            `"${variant}" is deactivated. Switch it back on from the inventory list instead of creating a duplicate.`,
            'danger',
          );
          return;
        }
      }
    }

    // Checked after the names rather than before: the boxes sit lower in the
    // form, so a form that is wrong in both places should complain about the
    // thing above first. Toasted as well as shown inline because the button
    // lives at the bottom of a scrolling sheet — the admin may be looking at it,
    // not at the box.
    const stockError = this.stockError;
    if (stockError) {
      await this.toast(stockError, 'danger');
      return;
    }
    const stock = this.stockLevels();

    this.isSaving = true;
    try {
      // Device image → Cloudinary URL first; empty when no image was picked.
      let finalImageUrl = '';
      if (this.pendingFile) {
        this.isUploading = true;
        try {
          finalImageUrl = await this.uploadService.uploadProductImage(this.pendingFile);
        } finally {
          this.isUploading = false;
        }
      }
      await this.inventoryService.createProduct({
        setNumber,
        setName,
        variantName: variant,
        description: this.description.trim() || 'New Five-orites flavor.',
        imageUrl: finalImageUrl,
        // Always 'flavor', and no longer a control.
        //
        // The form used to offer a Type dropdown. Of the 66 products in
        // production, 65 carry no `category` at all and the one that does is a
        // sundae — so the dropdown asked a question with one overwhelmingly
        // obvious answer, and an admin adding a cone or a sundae had to be told
        // that this is where you do that. The VALUE is still written, because
        // what was removed is the control, not the field: a new document should
        // be complete, and categoryIsValid() only constrains the field when it
        // is present.
        category: 'flavor',
        pricing: getPricingForSet(setNumber),
        stock,
      });
      // The "Set its stock next" nudge is gone now that stock is entered above,
      // but only the part that was wrong. A product that really did go in at
      // zero still needs saying: it is live and unbuyable until someone fills it
      // from the inventory list.
      const zeroStockNote = totalStock(stock) === 0 ? ' It starts at zero stock.' : '';
      await this.toast(
        (this.isNewSet ? `✅ Set ${setNumber} · ${setName} created.` : '✅ Product created.') +
          zeroStockNote,
        'success',
      );
      await this.modalCtrl.dismiss({ created: true });
    } catch (err: unknown) {
      await this.toast(err instanceof Error ? err.message : 'Failed to create product.', 'danger');
    } finally {
      this.isSaving = false;
    }
  }

  private async toast(message: string, color: 'success' | 'danger'): Promise<void> {
    const t = await this.toastCtrl.create({ message, color, duration: 2500, position: 'top' });
    await t.present();
  }
}
</file>

