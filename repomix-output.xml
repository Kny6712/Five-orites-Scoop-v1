// src/app/admin/inventory/inventory.page.scss
// Five-orites Scoop — Admin Inventory Manager

// ── Header ─────────────────────────────────────────────
.inv-header {
  padding: 10px 12px 6px;
}

/* ion-searchbar's own radius is a hard-coded 28px on a white field, which is not
   the shape of anything else on this page. Matches .track-search on /admin/tracking
   and .voucher-search on /admin/vouchers. */
.inv-search {
  --border-radius: var(--radius-sm);
  --background: var(--ion-color-light);
  padding: 0;
}

.inv-count {
  margin: 0 0 8px;
  font-size: 12px;
  color: var(--ion-color-medium);
}

.inv-actions {
  display: flex;
  gap: 8px;
}

.inv-list {
  padding: 4px 12px 12px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

// ── Card ───────────────────────────────────────────────
.inv-card {
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
  margin: 0;
  transition: opacity 0.15s ease;
}

/* A deactivated flavor stays fully legible and stays on the page. Dimming it to
   near-invisible was the old treatment, and it read as "this card is broken"
   rather than "this flavor is off sale" — especially for the stock numbers, which
   still matter because they are what you are here to restock. */
.inv-card.inactive-card {
  opacity: 0.72;
}

.inv-card.inactive-card .inv-thumb-img {
  filter: grayscale(0.7);
}

.inv-card-main {
  display: flex;
  gap: 12px;
  padding: 12px;
  align-items: flex-start;
}

.inv-card-body {
  flex: 1;
  min-width: 0;
}

// ── Thumbnail ──────────────────────────────────────────
.inv-thumb-btn {
  flex: 0 0 auto;
  width: 84px;
  padding: 0;
  background: none;
  border: 0;
  cursor: pointer;
  font: inherit;
}

.inv-thumb-btn:disabled {
  cursor: progress;
}

.inv-thumb-frame {
  position: relative;
  display: block;
  width: 84px;
  /* A locked 4:3 box. This is what satisfies "the container resizes cleanly to
     the new image": the frame never derives its height from the picture, and
     object-fit: cover fills it without distortion. Replace a portrait photo on
     one card and that card is exactly as tall as its neighbours. */
  aspect-ratio: 4 / 3;
  border-radius: var(--radius-sm);
  overflow: hidden;
  background: var(--tile-powder);
  border: 1px solid var(--ion-color-light-shade);
}

.inv-thumb-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* The "you can change this" affordance, bottom-right of the frame. */
.inv-thumb-badge {
  position: absolute;
  right: 3px;
  bottom: 3px;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 22px;
  height: 22px;
  border-radius: 50%;
  background: var(--color-white);
  box-shadow: 0 1px 4px rgb(36 24 51 / 0.3);
  opacity: 0;
  transition: opacity 0.15s ease;
}

.inv-thumb-badge app-icon {
  --icon-size: 13px;
  color: var(--color-primary-ink);
}

.inv-thumb-btn:hover .inv-thumb-badge,
.inv-thumb-btn:focus-visible .inv-thumb-badge {
  opacity: 1;
}

// ── Card header ────────────────────────────────────────
.inv-card-header {
  padding: 0;
  margin: 0 0 8px;
}

.inv-card-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 8px;
  margin-bottom: 4px;
}

.inv-ident {
  min-width: 0;
}

/* The two read-out chips above the flavour name: the set, and the family stock
   total. ion-chip ships min-height 32px plus 4px of margin on every side, which
   is a chip sized for a filter row and not for a card header that already carries
   an 11px label underneath it — so both are pulled in here.

   min-height, not height: ion-chip's own host sets min-height, and min-height
   always beats height, so the original `height` in this rule could never have
   taken effect. Named explicitly because `ion-chip`'s host is easy to confuse
   with the page's own, and this page deliberately declares no `:host` rule — it
   would override `.ion-page { display: flex }` and stop <app-footer> from being
   page chrome. */
.set-chip-sm {
  font-size: 11px;
  min-height: 22px;
  margin: 0 0 2px;
  --color: var(--color-ink);

  ion-label {
    color: var(--color-ink);
  }
}

/* These carried color="primary" and color="secondary", which Ionic turns into a
   foreground AND a background chosen independently: measured at 1.27:1 and 1.14:1,
   the label and the pill at nearly the same lightness. Explicit backgrounds plus plum
   ink, the treatment the credits page already uses. */
.set-chip-powder {
  background: var(--tile-powder);
}

.set-chip-mint {
  background: var(--tile-mint);
}

/* An outline ion-button inherits --ion-color-primary - the powder brand hue - which
   measured 1.71:1 on this page's cream ground. */
.bulk-restock-btn {
  --color: var(--color-primary-ink);
}

/* The family total is the one figure on the card that changes in place while an
   admin steps stock, so it is tabular for the same reason .stock-qty is: without
   it the label slides sideways on every tap. */
.stock-total-chip {
  font-variant-numeric: tabular-nums;
}

.inv-set-name {
  margin: 3px 0 0;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.3px;
  text-transform: uppercase;
  color: var(--ion-color-medium);
}

.inv-variant-name {
  font-family: var(--font-display);
  font-size: 17px;
  font-weight: 600;
  color: var(--color-ink);
  margin: 0;
  padding: 0;
}

/* ── Tool row: Active · edit · delete ─────────────────────
   Three controls in one row, and the spacing between them is doing real work.
   The Active pill is the common, reversible action; X is destructive and
   irreversible. They are the same size and the same distance apart, which is
   exactly the mistake this layout avoids: putting them side by side with no
   separation is how a mis-tap erases a flavor. The gap before X says "this one
   is different" without a dialog. */
.inv-tools {
  display: flex;
  align-items: center;
  gap: 6px;
  flex: 0 0 auto;
}

.status-pill {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  margin: 0;
  padding: 6px 11px 6px 9px;
  border: 1px solid var(--ion-color-light-shade);
  border-radius: var(--radius-pill);
  background: var(--ion-color-light);
  color: var(--ion-color-medium);
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
  white-space: nowrap;
}

.status-pill--on {
  background: var(--tone-success-bg);
  border-color: var(--tone-success-border);
  color: var(--tone-success-ink);
}

.status-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: currentColor;
  flex: 0 0 auto;
}

.tool-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 30px;
  height: 30px;
  padding: 0;
  border: 1px solid var(--ion-color-light-shade);
  border-radius: var(--radius-xs);
  background: var(--color-white);
  color: var(--color-primary-ink);
  cursor: pointer;
  transition:
    background-color 0.15s ease,
    border-color 0.15s ease;
}

.tool-btn app-icon {
  --icon-size: 15px;
}

.tool-btn:hover {
  background: var(--tile-powder);
  border-color: var(--color-primary-ink);
}

.tool-btn--danger {
  color: var(--tone-danger-ink);
  /* margin-left is the separator described above. */
  margin-left: 6px;
}

.tool-btn--danger:hover {
  background: var(--tone-danger-bg);
  border-color: var(--tone-danger-border);
}

.inv-card-content {
  padding: 0;
}

// ── Stock steppers ─────────────────────────────────────
.stock-view-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px;
}

@media (min-width: 560px) {
  .stock-view-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
}

.stock-view-cell {
  position: relative;
  background: var(--ion-color-light);
  border-radius: var(--radius-sm);
  padding: 7px 8px 8px;
  text-align: center;
}

.stock-size-label {
  display: block;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.3px;
  text-transform: uppercase;
  color: var(--ion-color-medium);
  margin-bottom: 4px;
}

/* The stepper itself. - 12 - on one row: the quantity is the thing being read,
   and the buttons are the thing being aimed at, so they sit either side of it
   where the eye already is. */
.stock-stepper {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 2px;
}

.step-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  padding: 0;
  border: 1px solid var(--ion-color-light-shade);
  border-radius: var(--radius-xs);
  background: var(--color-white);
  color: var(--color-primary-ink);
  cursor: pointer;
  /* 28px is a little under the 44px touch target, but this is a dense admin
     grid and the button is not the only way to reach the number — and a 44px
     target in a 4-across grid on a 360px phone would leave ~34px per column. */
  transition: background-color 0.12s ease;
}

.step-btn app-icon {
  --icon-size: 14px;
}
.step-btn:hover:not(:disabled) {
  background: var(--color-brand-primary);
}
.step-btn:active:not(:disabled) {
  background: var(--color-brand-primary-shade);
}

.step-btn:disabled {
  opacity: 0.32;
  cursor: not-allowed;
}

.stock-qty {
  min-width: 30px;
  font-family: var(--font-display);
  font-size: 16px;
  font-weight: 700;
  color: var(--color-ink);
  /* tabular so the number does not jitter sideways as it counts up */
  font-variant-numeric: tabular-nums;
}

.stock-in-stock {
  color: var(--color-ink);
}
.stock-low-stock {
  color: var(--tone-warning-ink);
}
.stock-out-of-stock {
  color: var(--tone-danger-ink);
}

.stock-alert-icon {
  --icon-size: 13px;
  position: absolute;
  top: 4px;
  right: 4px;
}

.stock-alert-danger {
  color: var(--ion-color-danger);
}
.stock-alert-warning {
  color: var(--color-warning);
}
</file>

