<file path="src/app/admin/inventory/inventory.page.html">
<!-- src/app/admin/inventory/inventory.page.html -->
<!-- Five-orites Scoop â€” Admin Inventory Manager -->

<ion-header>
  <ion-toolbar color="primary">
    <ion-buttons slot="start">
      <ion-menu-button aria-label="Open navigation menu"></ion-menu-button>
    </ion-buttons>
    <ion-title>Inventory Manager</ion-title>
    <!--
      No cart button here. This is an admin surface: an admin has no cart, and
      the toolbar's end slot is where the page's own actions live.

      The bulk-import trigger lives here rather than in the scrolling header block
      it used to sit in, for the same reason admin-orders and admin-reviews put
      their CSV export in `slot="end"`: a control inside <ion-content> scrolls out
      of reach, so on a phone the admin scrolls back up to find it every time.
    -->
    <ion-buttons slot="end">
      <ion-button size="small" (click)="openImport()" aria-label="Import flavors from a CSV file">
        <app-icon name="upload" slot="icon-only" />
      </ion-button>
    </ion-buttons>
  </ion-toolbar>
</ion-header>

<ion-content fullscreen>
  <ion-refresher slot="fixed" (ionRefresh)="handleRefresh($event)">
    <ion-refresher-content></ion-refresher-content>
  </ion-refresher>

  <!--
    A failed catalog read must not look like an empty one. The error branch
    replaces the count, the search bar, the set filter, and the bulk actions, because all
    four act on data that never arrived â€” Add Product in particular builds its
    set-number options from the loaded catalog, so over a failed read it would
    silently fall back to a hardcoded default.
  -->
  @if (loadError()) {
    <app-empty-state
      icon="circle-alert"
      title="Could not load the catalog"
      [message]="loadError()"
      actionLabel="Try again"
      (action)="loadProducts()"
      [compact]="true"
    />
  } @else {
    <div class="inv-header">
      <ion-searchbar
        placeholder="Search products..."
        debounce="300"
        (ionInput)="onSearch($event)"
        class="inv-search"
        aria-label="Search inventory"
      ></ion-searchbar>
      <!--
        The set filter, in the same chip idiom as the role chips on /admin/users.

        Inside this branch rather than below the loadError branch on purpose: like
        the search bar and the bulk actions, the chips are built out of the loaded
        catalog, and over a failed read there is no catalog to build them from.

        `All` counts every search hit, not what the grid is showing, so it reads as
        "how wide can I go" next to a set chip's "how much is this one worth".
        The per-set counts are scoped to the SEARCH rather than to the whole
        catalog — see setChips in the page for why that distinction is the whole
        point of the number.
      -->
      <div class="role-chips" role="group" aria-label="Filter by set">
        <button
          type="button"
          class="role-chip"
          [class.active]="setFilter() === 'all'"
          [attr.aria-pressed]="setFilter() === 'all'"
          (click)="onSetFilter('all')"
        >
          All ({{ searchScoped().length }})
        </button>
        @for (chip of setChips(); track chip.setNumber) {
          <button
            type="button"
            class="role-chip"
            [class.active]="setFilter() === chip.setNumber"
            [attr.aria-pressed]="setFilter() === chip.setNumber"
            (click)="onSetFilter(chip.setNumber)"
          >
            {{ chip.label }} ({{ chip.count }})
          </button>
        }
      </div>
      <p class="inv-count">
        @if (totalCount() === 0) {
          No products
        } @else if (page() > 1 || totalPages() > 1) {
          {{ totalCount() }} products &middot; page {{ page() }} of {{ totalPages() }}
        } @else {
          {{ totalCount() }} products
        }
      </p>
      <div class="inv-actions">
        <ion-button size="small" (click)="addProduct()">+ Add Product</ion-button>
        <ion-button size="small" fill="outline" class="bulk-restock-btn" (click)="bulkRestock()">
          Bulk Restock
        </ion-button>
      </div>
    </div>
  }

  <!-- Loading -->
  @if (isLoading()) {
    <div class="inv-list">
      @for (s of skeletonItems; track $index) {
        <ion-card class="inv-card">
          <ion-skeleton-text animated style="height: 80px"></ion-skeleton-text>
        </ion-card>
      }
    </div>
  }

  <!-- Product List -->
  @if (!isLoading() && !loadError()) {
    <div class="inv-list">
      @for (product of pagedProducts(); track product.id) {
        <ion-card class="inv-card" [class.inactive-card]="!product.isActive">
          <div class="inv-card-main">
            <!--
              The product image, and the way to replace it. One tap opens the
              upload sheet â€” the previous path was Details â†’ scroll â†’ tap image â†’
              pick file â†’ Save.

              A real <button> rather than a div with role="button": native
              keyboard support, a real accessible name, and Enter/Space for free.
              The fixed 4:3 frame is what keeps every card the same height
              regardless of the new image's aspect ratio.
            -->
            <button
              type="button"
              class="inv-thumb-btn"
              (click)="replaceImage(product)"
              [attr.aria-label]="'Change photo of ' + product.variantName"
            >
              <span class="inv-thumb-frame">
                <img
                  [src]="(product.imageUrl | cloudinary: 200) || '/assets/placeholder-scoop.svg'"
                  [alt]="product.variantName"
                  class="inv-thumb-img"
                  loading="lazy"
                />
                <span class="inv-thumb-badge" aria-hidden="true">
                  <app-icon name="image-plus" />
                </span>
              </span>
            </button>

            <div class="inv-card-body">
              <ion-card-header class="inv-card-header">
                <div class="inv-card-title-row">
                  <div class="inv-ident">
                    <ion-chip class="set-chip-sm set-chip-powder">Set {{ product.setNumber }}</ion-chip>
                    <p class="inv-set-name">{{ product.setName }}</p>
                    <!--
                      The family total, so an owner scanning the grid gets one
                      figure per flavour instead of adding four in their head. The
                      four steppers below remain the authoritative per-size
                      figures and the only editable ones; this is a read-out.
                    -->
                    <ion-chip class="set-chip-sm stock-total-chip set-chip-mint">
                      {{ totalStock(product.stock) }} units
                    </ion-chip>
                  </div>

                  <!--
                    Three controls, in one row, each a real <button>.

                    The Active pill is not a toggle switch, and that is deliberate:
                    it answers "can this be sold right now", which is a different
                    question from the quantity steppers below, and a switch next
                    to a stock number reads as a control for that number. A pill
                    with a dot states the state at a glance and does not invite
                    the misreading.

                    X is destructive and irreversible â€” it deletes the Firestore
                    document. It is separated from the pill by a gap, given its
                    own hit area, and guarded by a confirm dialog that names the
                    flavor. The pencil is the same Details modal the old
                    "Details" button opened, reduced to an icon.
                  -->
                  <div class="inv-tools">
                    <button
                      type="button"
                      class="status-pill"
                      [class.status-pill--on]="product.isActive"
                      [attr.aria-pressed]="product.isActive"
                      [attr.aria-label]="(product.isActive ? 'Deactivate ' : 'Activate ') + product.variantName"
                      (click)="toggleActive(product)"
                    >
                      <span class="status-dot" aria-hidden="true"></span>
                      {{ product.isActive ? 'Active' : 'Inactive' }}
                    </button>

                    <button
                      type="button"
                      class="tool-btn"
                      (click)="editDetails(product)"
                      [attr.aria-label]="'Edit details of ' + product.variantName"
                    >
                      <app-icon name="pencil" />
                    </button>

                    <button
                      type="button"
                      class="tool-btn tool-btn--danger"
                      (click)="confirmDelete(product)"
                      [attr.aria-label]="'Delete ' + product.variantName + ' permanently'"
                    >
                      <app-icon name="x" />
                    </button>
                  </div>
                </div>

                <ion-card-title class="inv-variant-name">{{ product.variantName }}</ion-card-title>
              </ion-card-header>

              <ion-card-content class="inv-card-content">
                <!--
                  Direct quantity controls. This replaces the "Edit Stock" button
                  and its separate in-place edit mode entirely: an admin adjusting
                  one size should not have to open an editor, retype a number and
                  press Save to move it by one.

                  The value is the source of truth from the live snapshot, and
                  each press calls an atomic server-side adjust â€” see
                  InventoryService.adjustStock for why this is a transaction
                  rather than a client-side read-modify-write.
                -->
                <div class="stock-view-grid">
                  @for (size of sizes; track size) {
                    <div class="stock-view-cell">
                      <span class="stock-size-label">{{ sizeLabels[size] }}</span>
                      <div class="stock-stepper">
                        <button
                          type="button"
                          class="step-btn"
                          [disabled]="busySizeId() !== null || product.stock[size] === 0"
                          (click)="adjustStock(product, size, -1)"
                          [attr.aria-label]="'Decrease ' + sizeLabels[size] + ' stock for ' + product.variantName"
                        >
                          <app-icon name="minus" />
                        </button>

                        <span
                          class="stock-qty"
                          [class.stock-in-stock]="product.stock[size] >= lowStockThreshold()"
                          [class.stock-low-stock]="product.stock[size] > 0 && product.stock[size] < lowStockThreshold()"
                          [class.stock-out-of-stock]="product.stock[size] === 0"
                          [attr.aria-live]="'polite'"
                        >
                          {{ product.stock[size] }}
                        </span>

                        <button
                          type="button"
                          class="step-btn"
                          [disabled]="busySizeId() !== null"
                          (click)="adjustStock(product, size, 1)"
                          [attr.aria-label]="'Increase ' + sizeLabels[size] + ' stock for ' + product.variantName"
                        >
                          <app-icon name="plus" />
                        </button>
                      </div>

                      @if (product.stock[size] < lowStockThreshold()) {
                        <app-icon
                          name="circle-alert"
                          class="stock-alert-icon"
                          [class.stock-alert-danger]="product.stock[size] === 0"
                          [class.stock-alert-warning]="product.stock[size] > 0"
                        />
                      }
                    </div>
                  }
                </div>
              </ion-card-content>
            </div>
          </div>
        </ion-card>
      }
    </div>

    @if (totalCount() === 0) {
      <!--
        One empty state for both reasons the grid can be empty — nothing matches
        the search, or nothing matches it WITHIN the chosen set — because a filter
        that renders a blank grid reads as a broken page rather than as a filter.

        The copy names the set when one is active. The grid is empty with no card
        left to say which set is narrowing it, and "no product matches that
        search" would point an admin at a searchbar that was doing its job.
      -->
      <app-empty-state
        icon="search"
        title="No matching flavors"
        [message]="
          setFilter() === 'all'
            ? 'No product matches that search. Try a different name or clear the search.'
            : 'No product matches that search in ' +
              activeSetLabel() +
              '. Try a different name, or tap All to widen the filter.'
        "
        [compact]="true"
      />
    } @else {
      <app-pagination
        [page]="page()"
        [total]="totalCount()"
        [pageSize]="PAGE_SIZE"
        itemLabel="flavor variants"
        (pageChange)="page.set($event)"
      />
    }
  }
  <app-footer></app-footer>
</ion-content>
</file>

