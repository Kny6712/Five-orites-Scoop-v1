// src/app/features/cart/cart.page.scss

// ── Empty Cart ────────────────────────────────────────────

// Shown when the live stock read failed. Distinct from a stock-out notice:
// nothing is actually out of stock, the app just cannot see the numbers.
.stock-warning p {
  margin: 0;
}
.stock-warning app-icon {
  flex: 0 0 auto;
  font-size: 18px;
  margin-top: 1px;
}

// ── Cart Items ────────────────────────────────────────────
.cart-items {
  padding: 12px 16px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.cart-item {
  display: flex;
  gap: 12px;
  padding: 12px;
  background: #fff;
  border-radius: 14px;
  box-shadow: var(--shadow-card);
  align-items: flex-start;
}

.item-image-wrap {
  width: 60px;
  height: 60px;
  border-radius: 10px;
  background: var(--color-brand-light);
  flex-shrink: 0;
  overflow: hidden;
}
.item-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.item-info {
  flex: 1;
  min-width: 0;
}
.item-name {
  font-size: 14px;
  font-weight: 700;
  color: var(--ion-color-dark);
  margin: 0 0 2px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.item-meta {
  font-size: 12px;
  color: var(--ion-color-medium);
  margin: 0 0 2px;
}
.item-unit-price {
  font-size: 12px;
  color: var(--ion-color-medium);
  margin: 0;
}

.item-controls {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6px;
}

.item-subtotal {
  font-size: 15px;
  font-weight: 700;
  // MONEY, and plum is the only value verified on every surface a cart row uses:
  // 12.88 on white, 12.34 on cream, 7.41 on mint. Measured 1.79:1 as powder on white.
  color: var(--color-ink);
  margin: 0;
}
.remove-btn {
  background: none;
  border: none;
  color: var(--color-danger);
  cursor: pointer;
  --icon-size: 18px;
  padding: 4px;
}

// ── Order Summary ────────────────────────────────────────
.order-summary {
  margin: 4px 16px 0;
  padding: 16px;
  background: var(--color-brand-light);
  border-radius: 14px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.summary-row {
  display: flex;
  justify-content: space-between;
  font-size: 14px;
  color: var(--ion-color-dark);
}
/* The free-delivery nudge, sitting between the Delivery row and the Total row.

   margin: 0 is load-bearing: .order-summary is a flex column with an 8px gap, and
   the UA default of 1em top and bottom on a <p> would blow the panel apart and
   leave a second, uneven gap under the gap.

   --ion-color-dark rather than --ion-color-medium, which is the page's usual
   secondary ink: this text is on the mint summary panel, where medium measures
   about 1.7:1 and is unreadable. Size is what makes it secondary here. */
.free-delivery-hint {
  margin: 0;
  font-size: 12px;
  line-height: 1.45;
  color: var(--ion-color-dark);
}

.total-row {
  border-top: 1px solid var(--ion-color-light-shade);
  padding-top: 8px;
  margin-top: 4px;
}
.total-amount {
  font-size: 20px;
  font-weight: 800;
  // Measured 1.03:1 - powder on the mint total tile, the worst pair still standing.
  // Plum is 7.41:1 there. primary-ink was the obvious candidate and FAILS at 4.09:1
  // on mint, which is why the money rows in this file take plum rather than the ink
  // token used elsewhere.
  color: var(--color-ink);
}

// ── Checkout Form ────────────────────────────────────────
.checkout-form {
  padding: 16px 16px 40px;
}
.form-title {
  font-size: 18px;
  font-weight: 700;
  margin: 16px 0 12px;
}

.input-wrap {
  margin-bottom: 14px;
}
.field-label {
  font-size: 13px;
  font-weight: 600;
  color: var(--ion-color-dark);
  display: block;
  margin-bottom: 6px;
}
.field-input {
  --background: var(--ion-color-light);
  --border-radius: 12px;
  --padding-start: 14px;
  --padding-end: 14px;
}

.checkout-btn {
  --background: var(--color-brand-primary);
  --border-radius: 12px;
  --padding-top: 14px;
  --padding-bottom: 14px;
  font-weight: 700;
  font-size: 16px;
  margin-top: 8px;
}
.clear-btn {
  margin-top: 4px;
  font-size: 14px;
  /* `color="danger"` did not set the foreground; the label came out as the app
     primary, powder on cream at 1.71:1. Third instance of this in the session - the
     Cancel buttons on /orders and on the order tracker needed the same declaration.
     Danger on this ground is 5.38:1. */
  --color: var(--color-danger);
}

// ── Review ────────────────────────────────────────────────
.review-container {
  padding: 20px 16px 40px;
}
.review-section-title {
  font-size: 18px;
  font-weight: 700;
  margin: 0 0 12px;
}

.review-item {
  display: flex;
  gap: 8px;
  padding: 10px 0;
  border-bottom: 1px solid var(--ion-color-light-shade);
  font-size: 14px;
}
.review-item-name {
  flex: 1;
  color: var(--ion-color-dark);
}
.review-item-qty {
  color: var(--ion-color-medium);
}
.review-item-price {
  font-weight: 700;
  color: var(--color-ink);
}

.review-address-box {
  background: var(--color-brand-light);
  border-radius: 12px;
  padding: 14px;
  margin: 16px 0;
}
.review-label {
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  // 11px is small text and owes the full 4.5:1; primary-ink is 6.82:1 on the cream
  // review panel.
  color: var(--color-primary-ink);
  margin: 0 0 4px;
}
.review-value {
  font-size: 14px;
  color: var(--ion-color-dark);
  margin: 0;
}
.review-notes {
  font-size: 13px;
  color: var(--ion-color-medium);
  margin: 4px 0 0;
  font-style: italic;
}

/* Plum, not white. This was white on sunny yellow, which measures 1.58:1 — it
   was a pre-existing failure on the old palette too, and the pastel makes it
   no better. 8.16:1 with plum. */
.place-order-btn {
  --background: var(--color-brand-accent);
  --color: var(--color-ink);
  --border-radius: 12px;
  --padding-top: 14px;
  --padding-bottom: 14px;
  font-weight: 700;
  font-size: 16px;
  margin-top: 16px;
}
.back-btn {
  --border-radius: 12px;
  margin-top: 8px;
}

// ── Confirmed ────────────────────────────────────────────
.confirmed-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 70vh;
  gap: 14px;
  text-align: center;
  padding: 20px;
}
.confirmed-icon {
  --icon-size: 80px;
  color: var(--color-success);
}
.confirmed-title {
  font-size: 28px;
  font-weight: 800;
  margin: 0;
  color: var(--ion-color-dark);
}
.confirmed-sub {
  font-size: 15px;
  color: var(--ion-color-medium);
  margin: 0;
  max-width: 280px;
}
/* The two actions of the confirmation screen. .confirmed-state centres its flex
   items, so without a width of its own this wrapper shrinks to the buttons'
   content width and `expand="block"` has nothing to expand into — the pair reads
   as two small buttons floating mid-screen instead of the full-width pair the
   checkout step shows. Capped so it stays the width of the rest of the screen
   on a desktop split pane rather than stretching the length of the panel. */
.confirmed-actions {
  width: 100%;
  max-width: 320px;
}

/* An outline ion-button inherits --ion-color-primary - the powder brand hue - which
   measured #8ECAE6 on cream at 1.71:1. */
.apply-voucher-btn {
  --color: var(--color-primary-ink);
}
