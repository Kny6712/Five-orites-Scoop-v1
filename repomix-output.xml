// src/app/core/services/order-notification.service.ts
// Five-orites Scoop — in-app order notifications for the signed-in user
//
// Why this exists: `NotificationService.notifyOrderStatusChange()` was called by
// whichever client PERFORMED the status change. So the toast appeared on the
// admin's phone when they advanced a customer's order, and a customer only saw
// anything while they happened to have the tracker page open. The audience and
// the actor were the wrong way round.
//
// This service flips it: it watches the *signed-in user's own* orders and
// notifies them on a genuine transition. It also derives the persistent feed
// that the notifications page and the unread badge read from.
//
// SCOPE: in-app only. This project is on Firebase's free Spark plan, so the
// Cloud Functions in `functions/src/` CANNOT BE DEPLOYED and no push fan-out is
// possible. That is a deliberate scope decision, not a gap being papered over.
// (Wording matters here: three functions DO exist on disk, they just cannot run.
// Saying "there is no Cloud Function" would be its own kind of lie.)
//
// TWO CONSUMERS, ONE WATCHER
//
// The toast and the feed are driven from the same snapshot rather than from two
// independent subscriptions. Two subscriptions to the same query would double
// every read against the Spark plan's 50K reads/day for no benefit, and could
// disagree about what "new" means.

import { Injectable, DestroyRef, inject, signal, computed, OnDestroy } from '@angular/core';
import { takeUntilDestroyed } from '@angular/core/rxjs-interop';
import { Subscription, catchError, of } from 'rxjs';
import { OrderService } from './order.service';
import { NotificationService } from './notification.service';
import { AuthService } from './auth.service';
import { Order, OrderStatus } from '../models/order.model';
import { buildNotificationFeed, countUnread, FeedEntry } from '../logic/notifications';

/**
 * How many recent orders to watch.
 *
 * Only recent orders change status, so this bounds the watch without hiding
 * anything actionable. It is also the ceiling on how far back the feed reaches,
 * which the README states rather than leaving as a surprise — the same class of
 * honest note the analytics and fulfilment pages already carry about their own
 * memory ceilings.
 */
const WATCH_LIMIT = 20;

/** Largest jump a single snapshot may add, so a burst cannot fire a wall of toasts. */
const MAX_TOASTS_PER_UPDATE = 1;

@Injectable({ providedIn: 'root' })
export class OrderNotificationService implements OnDestroy {
  private orderService = inject(OrderService);
  private notifier = inject(NotificationService);
  private auth = inject(AuthService);
  private destroyRef = inject(DestroyRef);

  /** orderId -> the last status we have already told the user about. */
  private readonly seen = new Map<string, OrderStatus>();
  private subscription: Subscription | null = null;

  /** The watched orders. Held so the feed can be a `computed` over them. */
  private readonly orders = signal<Order[]>([]);

  /**
   * The user's read marker, mirrored into a signal.
   *
   * This MUST be a signal rather than reading `AuthService.currentUserSnapshot`
   * directly. That is a plain getter over a `BehaviorSubject`, so it is not
   * reactive: a `computed()` reading it would compute once and never recompute,
   * and the unread badge would stay lit after the user pressed "mark read" until
   * the next order happened to change. That is the exact failure the badge
   * exists to avoid — a control that visibly did nothing.
   *
   * Mirroring here is also what makes the badge correct no matter WHICH surface
   * marks the feed read.
   */
  private readonly readAt = signal<number | null>(null);

  private readonly notificationsEnabled = signal(true);

  /**
   * Everything the signed-in user has been notified about, newest first.
   *
   * A `computed` over the orders and the read marker rather than a signal poked
   * inside the snapshot handler, so marking read updates the list and the badge
   * without waiting for the next Firestore event.
   */
  readonly entries = computed<FeedEntry[]>(() =>
    buildNotificationFeed(this.orders(), this.readAt()),
  );

  /** Unread count for the header badge. Derived, never stored — see the note on `readAt`. */
  readonly unreadCount = computed(() => countUnread(this.entries()));

  constructor() {
    // Mirror the two user fields the feed depends on into signals. Done once,
    // here, instead of each consumer subscribing: three pages reading
    // `notificationsEnabled` should not mean three subscriptions to the auth
    // subject, and a single place to reason about is worth the one line.
    this.auth.currentUser$.pipe(takeUntilDestroyed(this.destroyRef)).subscribe((user) => {
      const marker = user?.notificationsReadAt;
      this.readAt.set(typeof marker === 'number' ? marker : null);
      this.notificationsEnabled.set(this.notifier.isEnabled(user?.notificationsEnabled));
    });
  }

  ngOnDestroy(): void {
    this.subscription?.unsubscribe();
  }

  /**
   * Point the watcher at a user, or pass null to stop it. Safe to call on every
   * auth state change: the previous subscription is dropped, the seen-map and the
   * orders are both cleared, so signing out and back in cannot replay another
   * user's statuses and cannot notify about a status the new user has not seen.
   */
  watch(uid: string | null): void {
    this.subscription?.unsubscribe();
    this.subscription = null;
    this.seen.clear();
    this.orders.set([]);

    if (!uid) return;

    this.subscription = this.orderService
      .getCustomerOrders(uid, WATCH_LIMIT)
      // Without this, a failure here is an UNHANDLED RxJS error. Nothing in the
      // app subscribes to this stream's error channel — it exists only to fire
      // toasts and build the feed — so the throw was invisible to the user while
      // still killing the watcher for the rest of the session.
      //
      // That is not hypothetical: this stream calls the same getCustomerOrders()
      // query the dashboard uses, which needs a composite index on
      // (customerId ASC, createdAt DESC). While that index was undeployed, every
      // sign-in threw here for every user, whether or not they ever opened the
      // dashboard. Order notifications were simply dead, with no error shown.
      .pipe(
        catchError((err: unknown) => {
          console.error('Order notifications: could not watch orders', err);
          return of<Order[]>([]);
        }),
        takeUntilDestroyed(this.destroyRef),
      )
      .subscribe((orders) => this.report(orders));
  }

  /**
   * Marks everything currently in the feed as read.
   *
   * The local signal is moved FIRST so the badge clears on tap rather than after
   * a round trip, and rolled back if the write fails — otherwise the UI claims
   * success for a save that did not happen.
   *
   * Two deliberate choices in the value written:
   *
   * - Epoch ms, not a `serverTimestamp()`, because a sentinel read straight back
   *   is unresolved and the badge would keep counting what was just dismissed.
   *   `ProfilePatch` documents the same reasoning.
   * - `Date.now()` rather than the newest entry's timestamp. If the device clock
   *   and the stored timestamps disagree, using the entry can mark a
   *   just-arrived transition as already-seen; using now can only be conservative.
   */
  async markAllRead(): Promise<void> {
    const previous = this.readAt();
    const now = Date.now();
    this.readAt.set(now);

    try {
      await this.auth.updateProfile({ notificationsReadAt: now });
    } catch (err) {
      // Put the marker back so the badge returns to telling the truth. The
      // caller reports the failure to the user; this keeps the state honest in
      // the meantime rather than silently swallowing the write.
      this.readAt.set(previous);
      throw err;
    }
  }

  private report(orders: Order[]): void {
    this.orders.set(orders);

    // Toasts fire only for orders that are genuinely NEW to this session, and
    // never for the initial population. Opening the app after a change already
    // happened must not replay a burst of stale notifications — the feed exists
    // precisely so that history is available on demand instead.
    let fired = 0;
    for (const order of orders) {
      const previous = this.seen.get(order.id);

      if (
        previous !== undefined &&
        previous !== order.status &&
        this.notificationsEnabled() &&
        fired < MAX_TOASTS_PER_UPDATE
      ) {
        fired += 1;
        void this.notifier.notifyOrderStatusChange(order.id, order.status);
      }

      this.seen.set(order.id, order.status);
    }
  }
}
</file>

<file path="src/app/features/auth/auth.page.html">
<!-- src/app/features/auth/auth.page.html -->
<!-- Five-orites Scoop — Auth Page (Login / Register) -->

<ion-content class="auth-content" fullscreen>
  <div class="auth-container">
    <!-- Branding Hero -->
    <div class="auth-hero">
      <div class="auth-logo-wrap">
        <!-- Decorative: <h1 class="auth-brand"> right below already reads the brand name. -->
        <img src="/assets/images/logo-ice_cream.png" alt="" aria-hidden="true" class="auth-logo" />
      </div>
      <h1 class="auth-brand">Five-orites Scoop</h1>
      <p class="auth-tagline">Premium ice cream, scooped to your door</p>
    </div>

    <!-- Auth Card -->
    <div class="auth-card">
      <!-- Mode Tabs -->
      <div class="mode-tabs">
        <button class="mode-tab" [class.active]="mode() === 'login'" (click)="setMode('login')">Sign In</button>
        <button class="mode-tab" [class.active]="mode() === 'register'" (click)="setMode('register')">Sign Up</button>
      </div>

      <!-- Title -->
      <h2 class="auth-title">
        @if (mode() === 'login') {
          Welcome back
        }
        @if (mode() === 'register') {
          Create account
        }
      </h2>
      <p class="auth-subtitle">
        @if (mode() === 'login') {
          Sign in to order your favourite scoops
        }
        @if (mode() === 'register') {
          Join us for fresh flavors delivered daily
        }
      </p>

      <!-- Error Message -->
      @if (errorMessage()) {
        <app-alert-banner tone="danger" [message]="errorMessage()" />
      }

      <!-- Form Fields -->
      <div class="auth-form">
        <!-- Name field (register mode only) -->
        @if (mode() === 'register') {
          <div class="input-group">
            <app-icon name="user" class="input-icon" />
            <ion-input
              type="text"
              placeholder="Full name"
              aria-label="Full name"
              [(ngModel)]="displayName"
              class="auth-input"
              autocomplete="name"
            ></ion-input>
          </div>
        }

        <!-- Email -->
        <div class="input-group">
          <app-icon name="mail" class="input-icon" />
          <ion-input
            type="email"
            placeholder="Email address"
            aria-label="Email address"
            [(ngModel)]="email"
            class="auth-input"
            autocomplete="email"
          ></ion-input>
        </div>

        <!-- Password -->
        <div class="input-group">
          <app-icon name="lock" class="input-icon" />
          <ion-input
            [type]="showPassword() ? 'text' : 'password'"
            placeholder="Password"
            aria-label="Password"
            [attr.autocomplete]="mode() === 'register' ? 'new-password' : 'current-password'"
            [(ngModel)]="password"
            class="auth-input"
          ></ion-input>
          <button
            class="eye-toggle"
            type="button"
            (click)="togglePasswordVisibility()"
            [attr.aria-pressed]="showPassword()"
            [attr.aria-label]="showPassword() ? 'Hide password' : 'Show password'"
          >
            <app-icon [name]="showPassword() ? 'eye-off' : 'eye'" />
          </button>
        </div>

        <!-- Submit Button -->
        <ion-button expand="block" class="submit-btn" (click)="submit()" [disabled]="isLoading()">
          @if (isLoading()) {
            <ion-spinner name="crescent" slot="start"></ion-spinner>
          }
          @if (mode() === 'login') {
            Sign In
          }
          @if (mode() === 'register') {
            Create Account
          }
        </ion-button>

        <!-- Divider (login only) -->
        @if (mode() === 'login') {
          <div class="divider">
            <span class="divider-line"></span>
            <span class="divider-text">or</span>
            <span class="divider-line"></span>
          </div>

          <ion-button
            expand="block"
            fill="outline"
            class="google-btn"
            (click)="signInWithGoogle()"
            [disabled]="isLoading()"
          >
            <!--
              Google's brand mark, inlined. Lucide is a monochrome outline set and
              has no logo glyphs — and Google's brand guidelines require the
              four-colour mark, so a recoloured Lucide icon would be a misuse of
              both. Hidden from assistive tech because the adjacent button label
              already says "Continue with Google".
            -->
            <svg slot="start" class="google-mark" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
              <path
                fill="#EA4335"
                d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"
              />
              <path
                fill="#4285F4"
                d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"
              />
              <path
                fill="#FBBC05"
                d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"
              />
              <path
                fill="#34A853"
                d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"
              />
            </svg>
            Continue with Google
          </ion-button>

          <!--
            Forgot password. A real <button> rather than a styled div, so it
            inherits keyboard and screen-reader support. The confirmation is
            identical whether or not the address has an account — see
            sendResetEmail() in the component.
          -->
          <button type="button" class="forgot-btn" (click)="sendResetEmail()" [disabled]="isSendingReset()">
            @if (isSendingReset()) {
              Sending…
            } @else {
              Forgot your password?
            }
          </button>
        }

        @if (resetMessage()) {
          <p class="reset-message" role="status">{{ resetMessage() }}</p>
        }
      </div>
    </div>
  </div>
  <app-footer></app-footer>
</ion-content>
</file>

<file path="src/app/features/auth/auth.page.scss">
// src/app/features/auth/auth.page.scss

.auth-content {
  --background: var(--gradient-brand);
}

.auth-container {
  min-height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32px 20px;
  gap: 24px;
}

// ── Hero ────────────────────────────────────────────────
.auth-hero {
  text-align: center;
  // Plum, not white. The hero sits on a light-to-light pastel gradient where
  // white measures 1.79:1. This was white-on-purple before the palette change,
  // which is the kind of contrast that silently disappears when the backdrop
  // changes colour rather than when anyone looks at it.
  color: var(--color-ink);
}

.auth-logo-wrap {
  width: 88px;
  height: 88px;
  /* 50%, not 24px - see .menu-logo-wrap in app.component.scss. */
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  border: 2px solid rgba(255, 255, 255, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 12px;
  overflow: hidden;
}

.auth-logo {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.auth-brand {
  /* Third retro string. This is an <h1>, so it was inheriting Fredoka from the
     bare `h1` rule in variables.scss — font-family has to be stated here to
     override that, since .auth-brand sets a size but never named a family. */
  font-family: var(--font-display-retro);

  /* 700, not the 800 this used to carry. Lobster Two ships ONLY 700, so an 800
     request is not honoured by the font — the browser synthesises the extra
     weight by smearing the outlines, which on a script face fills in the
     counters and the joins. It looks bolder and worse at the same time. */
  font-weight: 700;

  /* Same 28-36px band as the About hero: both are the shop name, both sit on a
     --gradient-brand surface, and both need to read as the same brand moment.
     At 320px the auth content box is 320 less the container's 20px gutters =
     280px, and "Five-orites Scoop" sets to roughly 210px at 30px, so there is
     room to grow from the old 26px. Verified visually, not assumed. */
  font-size: clamp(1.75rem, 5.6vw, 2.25rem);
  line-height: 1.05;
  letter-spacing: -0.5px;

  /* The 4px this used to have is the exact bug that shipped on the About hero:
     the shadow points DOWN by 0.06em — 1.7px at 28px, 2.2px at 36px — and
     .auth-tagline sits immediately below, so the shadow landed on it. The
     logo plate above is not at risk, because the shadow only goes down and
     right. */
  margin: 0 0 var(--space-3);
  text-shadow: var(--display-sticker-shadow);
}

.auth-tagline {
  font-size: 14px;
  margin: 0;
  opacity: 0.8;
}

// ── Card ────────────────────────────────────────────────
.auth-card {
  width: 100%;
  max-width: 400px;
  background: #ffffff;
  border-radius: 24px;
  padding: 28px 24px;
  box-shadow: var(--shadow-float);
}

.auth-title {
  font-size: 22px;
  font-weight: 700;
  color: var(--ion-color-dark);
  margin: 0 0 4px;
}

.auth-subtitle {
  font-size: 14px;
  color: var(--ion-color-medium);
  margin: 0 0 20px;
}

// ── Error Banner ────────────────────────────────────────
.error-banner {
  background: #fde8e8;
  color: var(--color-danger);
  border-radius: 10px;
  padding: 10px 14px;
  font-size: 14px;
  margin-bottom: 16px;
  font-weight: 500;
}

// ── Form ────────────────────────────────────────────────
.auth-form {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.input-group {
  display: flex;
  align-items: center;
  background: var(--ion-color-light);
  border-radius: 12px;
  padding: 0 12px;
  border: 1.5px solid transparent;
  transition: border-color 0.15s ease;

  &:focus-within {
    border-color: var(--color-primary-ink);
  }
}

.input-icon {
  color: var(--ion-color-medium);
  --icon-size: 18px;
  flex-shrink: 0;
  margin-right: 8px;
}

.auth-input {
  --background: transparent;
  --color: var(--ion-color-dark);
  flex: 1;
  font-size: 15px;
}

.eye-toggle {
  background: none;
  border: none;
  cursor: pointer;
  padding: 8px 0 8px 8px;
  color: var(--ion-color-medium);
  display: flex;
  align-items: center;
  font-size: 18px;
}

/* Plum, not white: this is the app's main sign-in action and white on the
   powder primary measured 1.79:1. */
.submit-btn {
  --background: var(--color-brand-primary);
  --color: var(--color-ink);
  --border-radius: 12px;
  --padding-top: 14px;
  --padding-bottom: 14px;
  font-size: 16px;
  font-weight: 700;
  margin-top: 4px;
}

// ── Divider ─────────────────────────────────────────────
.divider {
  display: flex;
  align-items: center;
  gap: 10px;
}

.divider-line {
  flex: 1;
  height: 1px;
  background: var(--ion-color-light-shade);
}

.divider-text {
  font-size: 13px;
  color: var(--ion-color-medium);
}

// ── Google Button ────────────────────────────────────────
.google-btn {
  --color: var(--ion-color-dark);
  --border-color: var(--ion-color-light-shade);
  --border-radius: 12px;
  font-weight: 600;
}

/* The four-colour Google mark, inlined in the template. It is not an app-icon:
   Lucide is a monochrome outline set with no logo glyphs, and Google's brand
   guidelines require the official mark, so it is sized here directly. */
.google-mark {
  width: 18px;
  height: 18px;
  flex: 0 0 auto;
}

// ── Mode Toggle ──────────────────────────────────────────
.mode-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  margin-top: 16px;
  font-size: 14px;
}

.toggle-link {
  background: none;
  border: none;
  color: var(--color-brand-primary);
  font-weight: 700;
  font-size: 14px;
  cursor: pointer;
  padding: 0;
  text-decoration: underline;
}

// ── Mode Tabs ────────────────────────────────────────────────
.mode-tabs {
  display: flex;
  gap: 4px;
  background: var(--ion-color-light);
  border-radius: 14px;
  padding: 4px;
  margin-bottom: 20px;
}

.mode-tab {
  flex: 1;
  background: none;
  border: none;
  padding: 8px 4px;
  border-radius: 10px;
  font-size: 13px;
  font-weight: 600;
  color: var(--ion-color-medium);
  cursor: pointer;
  transition: all 0.15s ease;

  &.active {
    background: #ffffff;
    color: var(--color-primary-ink);
    box-shadow: var(--shadow-card);
  }
}

// Forgot-password link. A real <button>, so keyboard and screen-reader support
// come for free rather than having to be re-implemented with role/tabindex.
.forgot-btn {
  display: block;
  width: 100%;
  margin: 14px 0 0;
  padding: 8px;
  background: none;
  border: 0;
  // `--color-primary-ink`, not `--ion-color-primary`. The latter is the powder
  // brand hue (#8ECAE6), which measured 1.79:1 on this page's white card — a
  // "forgot your password?" link you cannot read. primary-ink (#1B5E7E) on white
  // is already asserted at 4.5:1 in `check-contrast.mjs`.
  color: var(--color-primary-ink);
  font: inherit;
  font-size: 14px;
  text-align: center;
  cursor: pointer;
}
.forgot-btn:disabled {
  opacity: 0.6;
  cursor: default;
}

// Reset confirmation. role="status" announces it without stealing focus.
.reset-message {
  margin: 10px 0 0;
  padding: 10px 12px;
  border-radius: 10px;
  background: var(--ion-color-success-tint, #e8f5e9);
  color: var(--ion-color-success-shade, #1b5e20);
  font-size: 13px;
  line-height: 1.4;
}
</file>

<file path="src/app/features/orders/order-tracker/order-tracker.page.scss">
// src/app/features/orders/order-tracker/order-tracker.page.scss

.tracker-body {
  padding: 16px 16px 40px;
}

.error-state {
  display: flex;
  justify-content: center;
  padding: 40px;
  color: var(--color-danger);
}

// ── Order Header ──────────────────────────────────────────
.order-header {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  flex-wrap: wrap;
  margin-bottom: 20px;
}
.order-label {
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: var(--ion-color-medium);
  margin: 0 0 2px;
}
.order-id {
  font-size: 22px;
  font-weight: 800;
  font-family: monospace;
  margin: 0;
  color: var(--ion-color-dark);
}
.order-date-wrap {
  flex: 1;
}
.order-date {
  font-size: 13px;
  color: var(--ion-color-dark);
  margin: 0;
}

// ── Cancelled Banner ──────────────────────────────────────
.cancelled-banner {
  display: flex;
  align-items: center;
  gap: 8px;
  background: #fde8e8;
  color: var(--color-danger);
  border-radius: 12px;
  padding: 12px 16px;
  font-weight: 600;
  font-size: 14px;
  margin-bottom: 20px;
}

// ── Timeline ──────────────────────────────────────────────
.timeline {
  display: flex;
  flex-direction: column;
  margin-bottom: 20px;
}

.timeline-step {
  display: flex;
  gap: 14px;
  align-items: flex-start;
}

.step-icon-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.step-dot {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2px solid var(--ion-color-light-shade);
  background: #fff;
  transition: all 0.2s;
}

.step-line {
  width: 2px;
  flex: 1;
  min-height: 20px;
  background: var(--ion-color-light-shade);
  margin: 4px 0;
}

.step-content {
  padding: 8px 0 16px;
  flex: 1;
}

.step-label {
  font-size: 15px;
  font-weight: 600;
  color: var(--ion-color-medium);
  margin: 0 0 2px;
}

.step-desc {
  font-size: 13px;
  color: var(--ion-color-medium);
  margin: 0 0 2px;
}

.step-time {
  font-size: 12px;
  color: var(--ion-color-medium);
  margin: 0;
}

// ── Step States ───────────────────────────────────────────
.step-completed {
  .step-dot {
    background: var(--color-success);
    border-color: var(--color-success);
    .step-icon {
      color: #fff;
    }
  }
  .step-line {
    background: var(--color-success);
  }
  .step-label {
    color: var(--color-success);
  }
}

.step-active {
  .step-dot {
    // The dot keeps the brand hue - it is a fill, and powder is legible as a fill.
    background: var(--color-brand-primary);
    border-color: var(--color-primary-ink);
    box-shadow: 0 0 0 4px var(--tile-powder);
    .step-icon {
      // Not white. White on the powder dot measured 1.79:1, and this is the CURRENT
      // step - the one glyph on the page that most needs to be findable. An icon owes
      // 3:1, and primary-ink on powder is 3.98:1.
      color: var(--color-primary-ink);
    }
  }
  .step-label {
    // Plum, not the brand hue: this measured 1.71:1 on the cream page. The step DOT
    // beside it keeps powder on purpose - a 16px dot is a shape, and powder is legible
    // as a shape. This is text.
    color: var(--color-ink);
    font-size: 16px;
  }
}

.step-upcoming {
  .step-icon {
    // light-shade is a BORDER token; as a glyph on white it measured 1.19:1. A dimmed
    // UPCOMING step still has to be perceivable, and medium is 4.93:1 - so the
    // de-emphasis now comes from the step's own dimming rather than from a colour
    // nobody can see.
    color: var(--ion-color-medium);
  }
}

.step-icon {
  --icon-size: 18px;
}

// ── Info Cards ────────────────────────────────────────────
.info-card {
  border-radius: 14px;
  box-shadow: var(--shadow-card);
  margin: 0 0 12px;
}

.info-label {
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  // primary-ink: 1.71:1 on cream becomes 6.82:1. At 11px this is small text and owes
  // the full 4.5:1, so the brand hue could never have cleared it here at any weight.
  color: var(--color-primary-ink);
  margin: 0 0 6px;
}

// The map, and the address it explains.
.map-card ion-card-content {
  padding-top: var(--space-3);
}

.map-note {
  margin: var(--space-3) 0 0;
  font-size: 13px;
  line-height: 1.45;
  color: var(--ion-color-medium);
}

.address-link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  margin-top: var(--space-3);
  min-height: 36px;
  font-size: 13px;
  font-weight: 700;
  color: var(--color-primary-ink);
  text-decoration: none;
}

.address-link app-icon {
  --icon-size: 16px;
}
.info-value {
  font-size: 14px;
  color: var(--ion-color-dark);
  margin: 0;
}
.info-notes {
  font-size: 13px;
