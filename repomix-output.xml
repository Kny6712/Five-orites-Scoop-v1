// src/app/admin/inventory/edit-product-modal.component.ts
// Five-orites Scoop — Edit Product: variant name, description and image.
// Stock quantities are edited from the inventory list, not here.

import { Component, Input, OnInit, OnDestroy, inject, computed } from '@angular/core';
import { CommonModule } from '@angular/common';
import { FormsModule } from '@angular/forms';
import {
  IonHeader,
  IonFooter,
  IonToolbar,
  IonTitle,
  IonContent,
  IonButtons,
  IonButton,
  IonList,
  IonItem,
  IonInput,
  IonTextarea,
  ModalController,
  ToastController,
} from '@ionic/angular/standalone';
import { InventoryService } from '../../core/services/inventory.service';
import { ImageUploadService } from '../../core/services/image-upload.service';
import { Product, SizePricing, SizeVariant } from '../../core/models/product.model';
import { SIZE_DISPLAY_LABELS } from '../../core/config/pricing.config';
import { flavourOf } from '../../core/logic/flavor';
import { CloudinaryPipe } from '../../shared/pipes/cloudinary.pipe';

@Component({
  selector: 'app-edit-product-modal',
  standalone: true,
  imports: [
    CommonModule,
    FormsModule,
    IonHeader,
    IonToolbar,
    IonTitle,
    IonContent,
    IonButtons,
    IonButton,
    IonList,
    IonItem,
    IonInput,
    IonTextarea,
    IonFooter,
    CloudinaryPipe,
  ],
  template: `
    <ion-header>
      <ion-toolbar color="primary">
        <ion-title>Edit Product</ion-title>
        <ion-buttons slot="end">
          <ion-button (click)="cancel()">Close</ion-button>
        </ion-buttons>
      </ion-toolbar>
    </ion-header>

    <ion-content class="ion-padding">
      @if (product) {
        <div class="modal-body">
          <h3 class="section-title">Details</h3>
          <ion-list class="card-list">
            <ion-item>
              <ion-input
                label="Variant name"
                labelPlacement="stacked"
                [(ngModel)]="variantName"
              ></ion-input>
            </ion-item>
            <!--
              Flavor, derived — not a control.

              Read-only because there is nothing to choose: the flavour IS the
              product's set, and every product already stores a setName. A dropdown
              here would mean a second place to keep the same fact in step with the
              name, which is the shape of most of the bugs this project has had.

              It is NOT derived from the variant name, despite sitting directly
              under it. Seven of the sixty-five products name a different flavour
              inside their variant name — "Chocolate Chip Cookie Dough" is a Cookies
              & Cream, "Coffee Chocolate Chip" is a Coffee — so a name search would
              answer "Chocolate" for every one of them. core/logic/flavor.ts lists
              them.

              This used to be described as distinct from a Type control answering a
              different question (what FORM the product is, vs which FLAVOUR).
              There is no Type control in this modal any more: it was removed
              because nothing here can change a product's form, and the one
              non-flavor in the catalog was never edited from here. See the note on
              category in save().
            -->
            <ion-item>
              <ion-input
                label="Flavor"
                labelPlacement="stacked"
                [value]="flavour()"
                readonly
                aria-label="Flavor, derived from the product's set"
              ></ion-input>
            </ion-item>
            <ion-item>
              <ion-textarea
                label="Description"
                labelPlacement="stacked"
                rows="3"
                [(ngModel)]="description"
              ></ion-textarea>
            </ion-item>
          </ion-list>

          <!--
            Per-size pricing.

            This is the fix for a documented permanent bug: corrected-gap-analysis.md:308
            recorded that "admin-created flavor sets above number 8 are permanently
            mispriced" because getPricingForSet falls back to the Chocolate tier and
            NOTHING in the app could ever change it — updateProductDetails accepted a
            pricing patch all along, but no UI exposed one.

            Only sent when a price actually changed, so renaming a flavor cannot
            silently rewrite its pricing.
          -->
          <h3 class="section-title">Pricing per size</h3>
          <p class="pricing-note">
            Prices are per variant, not per set — two variants in the same set can charge
            differently.
          </p>
          <ion-list class="card-list price-grid">
            @for (row of priceFields; track row.key) {
              <ion-item>
                <ion-input
                  [label]="row.label"
                  labelPlacement="stacked"
                  type="number"
                  inputmode="numeric"
                  min="0"
                  [ngModel]="price[row.key]"
                  (ngModelChange)="onPriceInput(row.key, $event)"
                ></ion-input>
              </ion-item>
            }
          </ion-list>

          <!-- The preview lives outside the card so it can be centred in the
               leftover space between the card and the footer action bar.
               Clickable so a photo can be replaced or added after the product
               already exists — previously the image could only be set at
               creation time, leaving no way to fix a wrong or missing photo. -->
          <div
            class="image-frame"
            (click)="pickImage(fileInput)"
            (keydown.enter)="pickImage(fileInput)"
            (keydown.space)="pickImage(fileInput); $event.preventDefault()"
            tabindex="0"
            role="button"
            [attr.aria-label]="previewImage ? 'Change product photo' : 'Add a product photo'"
          >
            <img
              [src]="(previewImage | cloudinary: 600) || '/assets/placeholder-scoop.svg'"
              [alt]="variantName || 'Product image'"
              class="image-preview"
              [class.is-stale]="removeImage"
              (error)="onImageError($event)"
            />
            @if (isUploading) {
              <span class="image-frame-badge">Uploading…</span>
            } @else if (pendingFile) {
              <span class="image-frame-badge">Tap to choose a different photo</span>
            } @else {
              <span class="image-frame-badge">
                {{ previewImage ? 'Tap to change photo' : 'Tap to add a photo' }}
              </span>
            }
          </div>
          <input #fileInput type="file" accept="image/*" hidden (change)="onFilePicked($event)" />
          @if (!uploadService.isConfigured) {
            <p class="config-hint">
              ⚠️ Cloudinary is not set up yet — add cloudName + uploadPreset in environment.ts to
              enable photo uploads.
            </p>
          }
          @if (pendingFile || (product.imageUrl && !removeImage)) {
            <div class="image-actions">
              @if (pendingFile) {
                <ion-button size="small" fill="clear" color="medium" (click)="clearPending()">
                  Discard new photo
                </ion-button>
              }
              @if (product.imageUrl && !pendingFile && !removeImage) {
                <ion-button size="small" fill="clear" color="danger" (click)="removeImage = true">
                  Remove current photo
                </ion-button>
              }
              @if (removeImage) {
                <ion-button size="small" fill="clear" color="medium" (click)="removeImage = false">
                  Keep current photo
                </ion-button>
              }
            </div>
          }
        </div>
      }
    </ion-content>

    <ion-footer>
      <ion-toolbar>
        <ion-button
          expand="block"
          fill="outline"
          color="primary"
          (click)="save()"
          [disabled]="isSaving || !product"
          class="save-btn"
        >
          {{ isSaving ? 'Saving…' : 'Save Changes' }}
        </ion-button>
      </ion-toolbar>
    </ion-footer>
  `,
  styles: [
    `
      .section-title {
        font-size: 15px;
        font-weight: 800;
        color: var(--ion-color-dark);
        margin: 18px 2px 8px;
      }
      .section-title:first-of-type {
        margin-top: 2px;
      }
      .card-list {
        border-radius: 14px;
        overflow: hidden;
        box-shadow: var(--shadow-card);
      }
      .pricing-note {
        margin: -4px 0 8px;
        padding: 0 16px;
        font-size: 12px;
        line-height: 1.4;
        color: var(--ion-color-medium);
      }
      /* Two columns of price boxes rather than four stacked rows — the four sizes
       are a set the admin reads ACROSS, not a list they read down. */
      .price-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0 8px;
      }
      @media (max-width: 380px) {
        .price-grid {
          grid-template-columns: 1fr;
        }
      }
      /* Fills ion-content's scroll area so margin-block: auto below has some free
       space to distribute. The 100% resolves because ion-content's .inner-scroll
       is position:absolute with all four offsets set, giving it a definite
       height — that is the only way in, since .inner-scroll is shadow DOM and
       cannot be styled from here. min-height (not height) so a long description
       still grows the body and scrolls instead of being clipped. */
      .modal-body {
        min-height: 100%;
        display: flex;
        flex-direction: column;
      }
      /* Centred in whatever space is left between the card and the action bar.
       Auto margins collapse to 0 once the content outgrows the area, so the
       layout degrades to normal flow rather than overflowing. */
      .image-frame {
        position: relative;
        margin-block: auto;
        margin-inline: auto;
        width: 100%;
        max-width: 420px;
        border-radius: 12px;
        overflow: hidden;
        background: var(--color-brand-light);
        border: 1px solid rgba(107, 63, 160, 0.14);
        cursor: pointer;
        transition:
          border-color 150ms ease,
          box-shadow 150ms ease;
      }
      .image-frame:hover {
        border-color: rgba(107, 63, 160, 0.34);
      }
      .image-frame:focus-visible {
        outline: 2px solid var(--color-brand-primary);
        outline-offset: 2px;
      }
      /* contain, not cover: cover cropped a 4:3 shot down to its middle 35% and
       cut the top off the scoop. The frame is close to 3:2 so the letterboxing
       on either side stays small. */
      .image-preview {
        display: block;
        width: 100%;
        height: 280px;
        object-fit: contain;
      }
      /* Faded while a removal is staged, so "this photo will go" is obvious
       before anything is saved. */
      .image-preview.is-stale {
        opacity: 0.3;
      }
      .image-frame-badge {
        position: absolute;
        left: 50%;
        bottom: 12px;
        transform: translateX(-50%);
        padding: 5px 14px;
        border-radius: 20px;
        background: rgba(0, 0, 0, 0.66);
        color: #fff;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
        pointer-events: none;
      }
      .image-actions {
        display: flex;
        justify-content: center;
        gap: 4px;
        margin-top: 6px;
        ion-button {
          --border-radius: 10px;
          font-size: 13px;
        }
      }
      .config-hint {
        font-size: 12px;
        color: var(--ion-color-warning-shade, #9a6b00);
        text-align: center;
      }
      /* Pinned action bar: the button stays at the bottom while ion-content scrolls.
       The hairline separates it from the scrolling card; the violet strip closes
       the modal off and echoes the header. .large-sheet-modal is Ionic's
       .modal-wrapper, which is border-radius + overflow: hidden, so the strip is
       clipped to the same 18px curve as the header instead of poking out square. */
      ion-footer {
        box-shadow: 0 -1px 6px rgba(0, 0, 0, 0.06);
        border-bottom: 3px solid var(--color-primary-ink);
      }
      /* variables.scss paints every ion-toolbar brand-violet, which is right for
       the header but wrong here — this bar must read as part of the white
       content area. Only the bar changes; the button is an outline treatment. */
      ion-footer ion-toolbar {
        --background: var(--ion-background-color, #f8f8f8);
        --color: var(--ion-text-color, #000000);
        /* Collapse the toolbar's default 56px so the button tucks right up against
         the top hairline, with the extra room left underneath for reach. */
        --min-height: 0;
        --padding-start: 16px;
        --padding-end: 16px;
        --padding-top: 2px;
        --padding-bottom: 14px;
      }
      /* Selector is 'ion-button.save-btn' rather than '.save-btn' on purpose:
       Ionic's :host(.button-outline) compiles to the same specificity as a
       component-style class, so the --border-width override would be a coin
       flip on stylesheet injection order. */
      ion-button.save-btn {
        --background: transparent;
        /* The BORDER was already primary-ink; the LABEL was the brand hue, so the
           button was a dark outline around powder text. Measured 1.71:1 on the white
           of this modal. Same token on both halves now.

           Written as a CSS comment because this block is a STYLES string, not
           JavaScript: a "//" line here is invalid CSS, and the apostrophe in the first
           draft of this note made the parser report an unterminated string. Build only
           warned, and the button rendered correctly anyway, so nothing looked broken. */
        --color: var(--color-primary-ink);
        --border-color: var(--color-primary-ink);
        --border-style: solid;
        --border-width: 1.5px;
        --border-radius: 12px;
        --padding-top: 18px;
        --padding-bottom: 18px;
        font-weight: 700;
        font-size: 15px;
        letter-spacing: 0.06em;
        /* ion-button only uppercases in md mode; this modal also runs on device,
         where Ionic uses ios mode and would render 'Save Changes' verbatim. */
        text-transform: uppercase;
        margin: 0;
        min-height: 48px;
      }
    `,
  ],
})
export class EditProductModalComponent implements OnInit, OnDestroy {
  private inventoryService = inject(InventoryService);
  private modalCtrl = inject(ModalController);
  private toastCtrl = inject(ToastController);
  readonly uploadService = inject(ImageUploadService);

  @Input() product: Product | null = null;

  /**
   * The product's flavour, derived from its set.
   *
   * A `computed` rather than a field assigned in `ngOnInit`, so it cannot go stale
   * if `product` is re-assigned while the modal stays open.
   */
  readonly flavour = computed(() => flavourOf(this.product));

  variantName = '';
  description = '';
  isSaving = false;

  /**
   * Live price editing, in pesos.
   *
   * Held as a plain object because it is driven by `ngModel` over a dynamic set
   * of four controls, and the `priceChanged` getter below tracks whether anything
   * moved so an untouched modal never writes the field.
   */
  price: Record<SizeVariant, number> = { cup: 0, pint: 0, halfGallon: 0, gallon: 0 };
  private storedPrice: SizePricing | null = null;

  readonly priceFields: readonly { key: SizeVariant; label: string }[] = (
    ['cup', 'pint', 'halfGallon', 'gallon'] as const
  ).map((k) => ({ key: k, label: SIZE_DISPLAY_LABELS[k] }));

  /**
   * Coerces whatever `ion-input` hands back into a whole peso count.
   *
   * An empty field arrives as `''` and a partially-typed number as a string, so
   * this cannot assume a number. 0 is the floor: a negative price is not a
   * discount, it is a bug that would let checkout credit the customer.
   */
  onPriceInput(key: SizeVariant, value: unknown): void {
    const n = Math.round(Number(value));
    this.price[key] = Number.isFinite(n) && n > 0 ? n : 0;
  }

  /** True when any price differs from what is stored. */
  private get priceChanged(): boolean {
    if (!this.storedPrice) return false;
    return (['cup', 'pint', 'halfGallon', 'gallon'] as const).some(
      (k) => this.price[k] !== this.storedPrice![k],
    );
  }

  /** A photo chosen in this session, uploaded to Cloudinary on save. */
  pendingFile: File | null = null;
  private previewObjectUrl = '';
  isUploading = false;
  /** Staged removal — only committed on save, so Cancel really cancels. */
  removeImage = false;

  ngOnInit(): void {
    if (this.product) {
      this.variantName = this.product.variantName;
      this.description = this.product.description ?? '';
      // Seed the price boxes from what is stored, and remember that value so
      // `priceChanged` can tell a real edit from a form that was merely opened.
      const p = this.product.pricing;
      this.price = {
        cup: p?.cup ?? 0,
        pint: p?.pint ?? 0,
        halfGallon: p?.halfGallon ?? 0,
        gallon: p?.gallon ?? 0,
      };
      this.storedPrice = { ...this.price };
    }
  }

  ngOnDestroy(): void {
    this.revokePreview();
  }

  /**
   * What the frame shows: the freshly picked local file if there is one,
   * otherwise whatever is already stored (or nothing, for the placeholder).
   * A staged removal reads as "no photo" so the state is visible before saving.
   */
  get previewImage(): string {
    if (this.removeImage) return '';
    return this.previewObjectUrl || this.product?.imageUrl || '';
  }

  pickImage(input: HTMLInputElement): void {
    if (this.isUploading || this.isSaving) return;
    if (!this.uploadService.isConfigured) {
      void this.toast('Photo uploads are not set up on this build.', 'danger');
      return;
    }
    input.click();
  }

  onFilePicked(event: Event): void {
    const input = event.target as HTMLInputElement;
    const file = input.files?.[0];
    // Reset immediately, otherwise re-picking the same file fires no change event.
    input.value = '';
    if (!file) return;
    if (!file.type.startsWith('image/')) {
      void this.toast('Please choose an image file.', 'danger');
      return;
    }
    this.revokePreview();
    this.removeImage = false;
    this.pendingFile = file;
    this.previewObjectUrl = URL.createObjectURL(file);
  }

  clearPending(): void {
    this.revokePreview();
    this.pendingFile = null;
  }

  private revokePreview(): void {
    if (this.previewObjectUrl) {
      URL.revokeObjectURL(this.previewObjectUrl);
      this.previewObjectUrl = '';
    }
  }

  /** Falls back to the placeholder so a broken Cloudinary URL is not a blank box. */
  onImageError(event: Event): void {
    const img = event.target as HTMLImageElement;
    if (img && !img.src.endsWith('placeholder-scoop.svg')) {
      img.src = '/assets/placeholder-scoop.svg';
    }
  }

  cancel(): void {
    void this.modalCtrl.dismiss();
  }

  async save(): Promise<void> {
    if (!this.product || this.isSaving) return;
    const name = this.variantName.trim();
    if (!name) {
      await this.toast('Variant name is required.', 'danger');
      return;
    }

    this.isSaving = true;
    try {
      // Upload before writing the product doc, so a failed upload leaves the
      // stored URL untouched rather than blanking the photo.
      let imageUrl: string | undefined;
      if (this.pendingFile) {
        this.isUploading = true;
        try {
          imageUrl = await this.uploadService.uploadProductImage(this.pendingFile);
        } finally {
          this.isUploading = false;
        }
      } else if (this.removeImage) {
        imageUrl = '';
      }

      // Stock is deliberately not touched here — it is entered when a product is
      // created and adjusted from the inventory list's steppers, so this modal
      // only owns the descriptive fields and the price.
      const patch: Parameters<InventoryService['updateProductDetails']>[1] = {
        variantName: name,
        description: this.description.trim(),
      };
      // Only when a price actually moved. Sending it unconditionally would
      // rewrite the pricing map on every rename, which is how an unrelated edit
      // turns into a silent price change.
      if (this.priceChanged) patch.pricing = { ...this.price };
      // `category` is absent from this patch ON PURPOSE, and it is the one field
      // whose absence is load-bearing rather than merely untidy.
      //
      // `updateProductDetails` calls `updateDoc`, which is a field-level merge:
      // keys the patch does not mention are left exactly as they are. Omitting
      // `category` therefore means the sundae in the catalog keeps its
      // `category: 'sundae'`, and the sixty-five products written before the
      // field existed keep having no field at all — neither group can be
      // flattened by renaming a flavor here.
      //
      // The alternative was to carry the loaded value through on every save,
      // which would BACKFILL `category: 'flavor'` onto all sixty-five as a side
      // effect of an unrelated edit. There is no Type control left in this modal
      // to make that a deliberate act, so there is nothing to send.
      // Only imageUrl is written when it actually changes, so an unrelated
      // rename never rewrites the photo field.
      if (imageUrl !== undefined) patch.imageUrl = imageUrl;

      await this.inventoryService.updateProductDetails(this.product.id, patch);
      await this.toast('✅ Product updated.', 'success');
      await this.modalCtrl.dismiss({ saved: true });
    } catch (err: unknown) {
      await this.toast(err instanceof Error ? err.message : 'Failed to update product.', 'danger');
    } finally {
      this.isSaving = false;
    }
  }

  private async toast(message: string, color: 'success' | 'danger'): Promise<void> {
    const t = await this.toastCtrl.create({ message, color, duration: 2500, position: 'top' });
    await t.present();
  }
}
</file>

<file path="src/app/core/models/order.model.ts">
// src/app/core/models/order.model.ts
// Five-orites Scoop — Order Data Models
// Author: Five-orites Scoop team (see README)

import { Timestamp } from '@angular/fire/firestore';
import { SizeVariant } from './product.model';
import type { AppIcon } from '../icons/app-icons';

export type OrderStatus =
  'pending' | 'confirmed' | 'preparing' | 'out_for_delivery' | 'delivered' | 'cancelled';

export interface OrderItem {
  productId: string;
  variantName: string;
  setName: string;
  size: SizeVariant;
  quantity: number;
  unitPrice: number;
  subtotal: number;
}

export interface Order {
  id: string;
  customerId: string;
  customerEmail: string;
  items: OrderItem[];
  totalAmount: number;
  deliveryFee: number;
  discountAmount?: number;
  voucherCode?: string | null;
  grandTotal: number;
  status: OrderStatus;
  paymentStatus: 'pending' | 'paid' | 'failed' | 'refunded';
  // There is deliberately no paymentReference field: no payment gateway is
  // integrated (see README "Not done yet"). Add it back when one is.
  //
  // Note that 'paid' | 'failed' | 'refunded' are currently unreachable — the only
  // writer is placeOrder, which always writes 'pending', and nothing in the app
  // or the Cloud Functions moves it. Only dashboard.page.ts reads it, and that
  // read is always false today. They are kept because they describe the intended
  // domain, not because the app can currently produce them; revenue is counted
  // from delivered orders instead.
  deliveryAddress: string;
  notes?: string | null;
  cancelReason?: string | null;
  createdAt: Timestamp;
  updatedAt: Timestamp;
  /**
   * The fulfilment timeline. `reason` is optional and only present on entries the
   * Cloud Function writes (`insufficient_stock`, `no_price`, `invalid_line`,
   * `empty_order`) — it records WHY the server cancelled an order, which is the
   * only place that distinction survives. Client-written entries omit it.
   */
  statusHistory: { status: OrderStatus; timestamp: Timestamp; reason?: string }[];

  /**
   * Whether a cancelled order's stock has been returned to inventory.
   *
   * ABSENT IS NOT FALSE. Every order cancelled before this field existed has no
   * marker, and reading "absent" as "stock was never returned" would flood the
   * repair queue with orders that are actually fine.
   *
   * So: `true` means confirmed returned, `false` means confirmed NOT returned
   * (the restock threw), and `undefined` means unknown — which is why the repair
   * panel only offers `false`, and shows unknown ones separately rather than
   * guessing. See `OrderService.repairStockRestock`.
   */
  stockRestored?: boolean;
  stockRestoredAt?: Timestamp | null;
}

export interface OrderStatusMeta {
  label: string;
  /**
   * Typed as `AppIcon` rather than `string`, so a rename or a typo in the icon
   * registry is a compile error instead of a silently blank glyph in the status
   * badge.
   */
  icon: AppIcon;
  description: string;
}

export const ORDER_STATUS_META: Record<OrderStatus, OrderStatusMeta> = {
  pending: {
    label: 'Order Placed',
    icon: 'clock',
    description: 'We received your order and are reviewing it.',
  },
  confirmed: {
    label: 'Confirmed',
    icon: 'circle-check',
    description: 'Your order has been confirmed!',
  },
  preparing: {
    label: 'Preparing Your Scoops',
    icon: 'ice-cream',
    description: 'Our scoop artists are crafting your order.',
  },
  out_for_delivery: {
    label: 'Out for Delivery',
    icon: 'bike',
    description: 'Your ice cream is on its way!',
  },
  delivered: {
    label: 'Delivered',
    icon: 'circle-check-big',
    description: 'Enjoy your scoops! 🍦',
  },
  cancelled: {
    label: 'Cancelled',
    icon: 'circle-x',
    description: 'This order has been cancelled.',
  },
};
</file>

<file path="src/app/features/cart/cart.page.html">
<!-- src/app/features/cart/cart.page.html -->
<!-- Five-orites Scoop — Cart & Checkout -->

<ion-header>
  <ion-toolbar color="primary">
    <ion-buttons slot="start">
      <ion-menu-button aria-label="Open navigation menu"></ion-menu-button>
    </ion-buttons>
    <ion-title>
      @if (checkoutStep() === 1) {
        My Cart
      }
      @if (checkoutStep() === 2) {
        Review Order
      }
      @if (checkoutStep() === 3) {
        Order Placed!
      }
    </ion-title>
  </ion-toolbar>
</ion-header>

<ion-content fullscreen>
  @if (checkoutStep() === 1) {
    @if (cart().items.length === 0) {
      <!-- Was a fourth bespoke empty-state variant, on top of the three the
           audit found already. An empty screen gets one shape now. -->
      <app-empty-state
        icon="cart"
        title="Your cart is empty"
        message="Add some delicious scoops to get started!"
        actionLabel="Browse Flavors"
        (action)="goToProducts()"
      />
    } @else {
      <!--
        Shown when the live stock read failed. The quantity steppers stay
        usable, but without a known stock level the cap cannot be applied, so
        the user is told rather than left to discover it at checkout.
      -->
      @if (stockUnavailable()) {
        <app-alert-banner
          tone="warning"
          title="Live stock unavailable"
          message="Quantities are not capped here for now. Stock is still checked when you place the order."
        />
      }
      <div class="cart-items">
        @for (item of cart().items; track trackItem($index, item)) {
          <div class="cart-item">
            <div class="item-image-wrap">
              <img
                [src]="(item.imageUrl | cloudinary: 200) || '/assets/placeholder-scoop.svg'"
                [alt]="item.variantName"
                class="item-image"
                onerror="this.src = '/assets/placeholder-scoop.svg'"
              />
            </div>
            <div class="item-info">
              <p class="item-name">{{ item.variantName }}</p>
              <p class="item-meta">{{ item.setName }} · {{ sizeLabels[item.size] }}</p>
              <p class="item-unit-price">{{ item.unitPrice | peso }} each</p>
            </div>
            <div class="item-controls">
              <!--
                Shared stepper. This replaces a 28x28 hand-rolled pair of buttons
                — the worst touch target in the app, at 64% of the 44px
                guidance, on the control people tap most.
              -->
              <app-qty-stepper [value]="item.quantity" [max]="maxFor(item)" (changed)="setQty(item, $event)" />
              <p class="item-subtotal">{{ item.unitPrice * item.quantity | peso }}</p>
              <button
                type="button"
                class="remove-btn"
                (click)="removeItem(item)"
                [attr.aria-label]="'Remove ' + item.variantName + ' from cart'"
              >
                <app-icon name="trash" />
              </button>
            </div>
          </div>
        }
      </div>

      <div class="order-summary">
        <div class="summary-row">
          <span>Subtotal</span>
          <span>{{ cart().totalAmount | peso }}</span>
        </div>
        @if (voucherDiscount() > 0) {
          <div class="summary-row">
            <span>Voucher {{ appliedVoucher() }}</span>
            <span>-{{ voucherDiscount() | peso }}</span>
          </div>
        }
        <div class="summary-row">
          <span>Delivery Fee</span>
          <span>{{ isFreeDelivery() ? 'FREE' : (deliveryFee() | peso) }}</span>
        </div>
        @if (!isFreeDelivery()) {
          <p class="free-delivery-hint">
            Add {{ amountAwayFromFreeDelivery() | peso }} more for FREE delivery (over
            {{ freeDeliveryThreshold | peso }}).
          </p>
        } @else {
          <p class="free-delivery-hint">🎉 You've unlocked FREE delivery!</p>
        }
        <div class="summary-row total-row">
          <span>Total</span>
          <span class="total-amount">{{ grandTotal() | peso }}</span>
        </div>
      </div>

      <div class="checkout-form">
        <h3 class="form-title">Voucher</h3>
        @if (!appliedVoucher()) {
          <div class="input-wrap">
            <label class="field-label" for="voucher-input">Promo code</label>
            <ion-textarea
              id="voucher-input"
              [(ngModel)]="voucherCode"
              placeholder="Enter code..."
              rows="1"
              class="field-input"
            ></ion-textarea>
          </div>
          <ion-button expand="block" fill="outline" class="apply-voucher-btn" (click)="applyVoucher()">
            Apply Voucher
          </ion-button>
        } @else {
          <p class="review-notes">✅ {{ appliedVoucher() }} applied.</p>
          <ion-button expand="block" fill="clear" color="medium" (click)="removeVoucher()">Remove Voucher</ion-button>
        }
        @if (voucherMessage()) {
          <p class="review-notes">{{ voucherMessage() }}</p>
        }
      </div>

      <div class="checkout-form">
        <h3 class="form-title">Delivery Details</h3>

        @if (savedAddresses().length > 0) {
          <div class="input-wrap">
            <label class="field-label">Saved addresses</label>
            @for (addr of savedAddresses(); track addr) {
              <ion-button expand="block" fill="outline" size="small" (click)="useSavedAddress(addr)">
                {{ addr }}
              </ion-button>
            }
          </div>
        }

        @if (errorMessage()) {
          <app-alert-banner tone="danger" [message]="errorMessage()" />
        }

        <div class="input-wrap">
          <label class="field-label" for="delivery-address">Delivery Address *</label>
          <ion-textarea
            id="delivery-address"
            [(ngModel)]="deliveryAddress"
            placeholder="Enter your full delivery address..."
            rows="3"
            class="field-input"
          ></ion-textarea>
        </div>

        <div class="input-wrap">
          <label class="field-label" for="order-notes">Order Notes (optional)</label>
          <ion-textarea
            id="order-notes"
            [(ngModel)]="notes"
            placeholder="Special instructions, landmarks, etc."
            rows="2"
            class="field-input"
          ></ion-textarea>
        </div>

        <ion-button expand="block" class="checkout-btn" (click)="proceedToReview()">
          Review Order
          <app-icon name="arrow-right" slot="end" />
        </ion-button>

        <ion-button expand="block" fill="clear" color="danger" (click)="clearCart()" class="clear-btn">
          <app-icon name="trash" slot="start" />
          Clear Cart
        </ion-button>
      </div>
    }
  }

  @if (checkoutStep() === 2) {
    <div class="review-container">
      <h3 class="review-section-title">Order Items</h3>
      @for (item of cart().items; track trackItem($index, item)) {
        <div class="review-item">
          <span class="review-item-name">{{ item.variantName }} ({{ sizeLabels[item.size] }})</span>
          <span class="review-item-qty">×{{ item.quantity }}</span>
          <span class="review-item-price">{{ item.unitPrice * item.quantity | peso }}</span>
        </div>
      }

      <div class="review-address-box">
        <p class="review-label">Delivering to</p>
        <p class="review-value">{{ deliveryAddress }}</p>
        @if (notes) {
          <p class="review-notes">Note: {{ notes }}</p>
        }
      </div>

      <div class="order-summary">
        <div class="summary-row">
          <span>Subtotal</span>
          <span>{{ cart().totalAmount | peso }}</span>
        </div>
        @if (voucherDiscount() > 0) {
          <div class="summary-row">
            <span>Voucher {{ appliedVoucher() }}</span>
            <span>-{{ voucherDiscount() | peso }}</span>
          </div>
        }
        <div class="summary-row">
          <span>Delivery</span>
          <span>{{ isFreeDelivery() ? 'FREE' : (deliveryFee() | peso) }}</span>
        </div>
        <div class="summary-row total-row">
          <span>Total</span>
          <span class="total-amount">{{ grandTotal() | peso }}</span>
        </div>
      </div>

      @if (errorMessage()) {
        <app-alert-banner tone="danger" [message]="errorMessage()" />
      }

      <ion-button expand="block" class="place-order-btn" (click)="placeOrder()" [disabled]="isPlacingOrder()">
        @if (isPlacingOrder()) {
          <ion-spinner name="crescent" slot="start"></ion-spinner>
        }
        {{ isPlacingOrder() ? 'Placing Order...' : 'Place Order' }}
      </ion-button>

      <ion-button expand="block" fill="outline" (click)="backToCart()" class="back-btn"> Back to Cart </ion-button>
    </div>
  }

  @if (checkoutStep() === 3) {
    <div class="confirmed-state">
      <app-icon name="circle-check" class="confirmed-icon" />
      <h2 class="confirmed-title">Order Placed!</h2>
      <p class="confirmed-sub">Your scoops are on the way. Redirecting to your order tracker...</p>
      <ion-spinner name="dots"></ion-spinner>
      <div class="confirmed-actions">
        <ion-button expand="block" class="place-order-btn" (click)="viewTracker()"> View Order Tracker </ion-button>
        <ion-button expand="block" fill="outline" (click)="orderMore()" class="back-btn">
          Order More Flavors
        </ion-button>
      </div>
    </div>
  }
  <app-footer></app-footer>
</ion-content>
</file>

<file path="src/app/features/dashboard/dashboard.page.html">
<!-- src/app/features/dashboard/dashboard.page.html -->
<!-- Five-orites Scoop — Role-Aware Dashboard -->

<ion-header>
  <ion-toolbar color="primary">
    <ion-buttons slot="start">
      <ion-menu-button aria-label="Open navigation menu"></ion-menu-button>
    </ion-buttons>
    <ion-title>Dashboard</ion-title>
  </ion-toolbar>
</ion-header>

<ion-content fullscreen>
  <ion-refresher slot="fixed" (ionRefresh)="handleRefresh($event)">
    <ion-refresher-content></ion-refresher-content>
  </ion-refresher>

  <!--
    A failed read is NOT an empty dashboard. Every feed used to swallow its error
    into `of([])`, so a permissions error, a missing composite index or an
    offline device rendered as a perfectly clean dashboard.

    The message itself comes from describeFirestoreError, which distinguishes a
    missing database index from a permissions problem from a genuinely offline
    device — so a deploy problem no longer presents to the user as a wifi fault.
  -->
  @if (loadError()) {
    <app-alert-banner tone="danger" [message]="loadError()" actionLabel="Try again" (action)="loadDashboard()" />
  }

  <!-- ═══════════════════════════════════════
       CUSTOMER DASHBOARD
  ═══════════════════════════════════════ -->
  @if (!isAdmin()) {
    <!-- Welcome Banner -->
    <div class="welcome-banner">
      <div class="welcome-text">
        <!--
          The greeting is wrapped on its own because the emoji must NOT be
          inside the shadowed run. text-shadow paints behind every glyph in the
          box it is set on, and the scoop is a COLOUR EMOJI — a bitmap, not
          text — so the offset shadow renders as a hard gold fringe around it
          rather than a shadow. Splitting the string is the fix; the alternative
          was dropping the emoji, which is content this page chose to show.

          The accessible name is deliberately left exactly as it was: the emoji
          is still announced, as it was before this change. No aria-hidden, even
          though it is arguably decorative — dropping it would be an unrequested
          change to what the heading says out loud.
        -->
        <h2 class="welcome-title">
          <span class="welcome-greeting">Hello, {{ (currentUser()?.displayName || 'Scooper').split(' ')[0] }}!</span>
          <span class="welcome-scoop">🍦</span>
        </h2>
        <p class="welcome-sub">What flavor are you craving today?</p>
      </div>
      <div class="welcome-image-wrap">
        <!-- The only usage where the brand name is NOT adjacent text, so this one keeps
             a name for screen readers rather than being marked decorative. -->
        <img src="/assets/images/logo-ice_cream.png" alt="Five-orites Scoop logo" class="welcome-image" />
      </div>
    </div>

    <!--
      Notification control. This used to be a div with role="button" and a click
      handler that re-prompted for permission on every tap - so it could not show
      a real state, and tapping it twice did nothing different.

      It is now a genuine toggle bound to `notificationsEnabled` on the user
      document, which means the preference follows the user to another device
      rather than living in one browser's localStorage.

      Turning it ON no longer asks the browser anything. The app used to register
      for FCM push, which needed an OS permission and could leave the switch
      reading "on" while nothing was ever delivered. Notifications are in-app
      only now, so there is no permission to grant and the stored preference is
      the whole truth - see NotificationService.
    -->
    <!--
      The admin-written announcement. Nothing renders unless an admin has saved a
      headline AND switched it on, so this costs no layout on a shop that never
      uses it.

      Note the class name: the block below also carries `promo-banner`, which is
      the notification toggle. `feature-alignment.md:119-123` warned that anyone
      auditing by class name would tick "admin-editable promo banner" as
      implemented off that block alone. This one is the real thing.
    -->
    @if (shop.promo(); as p) {
      <div class="announce-banner" role="status">
        <app-icon name="zap" class="promo-icon" />
        <div class="promo-text">
          <span class="promo-title">{{ p.promoTitle }}</span>
          @if (p.promoBody) {
            <span class="promo-sub">{{ p.promoBody }}</span>
          }
        </div>
      </div>
    }

    <div class="promo-banner">
      <app-icon name="bell" class="promo-icon" />
      <div class="promo-text">
        <span class="promo-title">Track your orders live</span>
        <span class="promo-sub">
          @if (updatesOn()) {
            You'll see an alert in the app when your order's status changes.
          } @else {
            Turn on alerts for status changes.
          }
        </span>
        <!-- The feed, so the banner is a way INTO the history rather than only a
             switch. Someone who wants to know what happened to their order should
             not have to find the menu for it. -->
        <a routerLink="/notifications" class="promo-link">View notifications</a>
      </div>
      <ion-toggle
        [checked]="updatesOn()"
        (ionChange)="onNotificationsToggle($event)"
        aria-label="Order update notifications"
      ></ion-toggle>
    </div>

    <!-- Grab a code, then use it in the cart. -->
    <div class="section-header">
      <h3 class="section-title">Grab a Voucher</h3>
    </div>
    <app-voucher-cards />

    <!-- Featured Flavors -->
    <div class="section-header">
      <h3 class="section-title">Featured Flavors</h3>
      <ion-button fill="clear" size="small" [routerLink]="'/products'" class="see-all-btn"> See All </ion-button>
    </div>

    @if (isLoading()) {
      <ion-grid>
        <ion-row>
          @for (s of [1, 2, 3, 4]; track s) {
            <ion-col size="6">
              <ion-card class="skeleton-card">
                <ion-skeleton-text animated style="height: 120px"></ion-skeleton-text>
                <ion-card-content>
                  <ion-skeleton-text animated style="height: 14px; margin-bottom: 8px"></ion-skeleton-text>
                  <ion-skeleton-text animated style="height: 36px"></ion-skeleton-text>
                </ion-card-content>
              </ion-card>
            </ion-col>
          }
        </ion-row>
      </ion-grid>
    } @else if (!loadError()) {
      <ion-grid>
        <ion-row>
          @for (product of featuredProducts(); track trackProduct($index, product)) {
            <ion-col size="6" size-md="3">
              <app-product-card [product]="product"></app-product-card>
            </ion-col>
          }
        </ion-row>
      </ion-grid>
    }

    <!-- Recent Orders -->
    @if (recentOrders().length > 0) {
      <div class="section-header">
        <h3 class="section-title">Recent Orders</h3>
        <ion-button fill="clear" size="small" [routerLink]="'/orders'" class="see-all-btn"> View All </ion-button>
      </div>
      <div class="recent-orders">
        @for (order of recentOrders(); track trackOrder($index, order)) {
          <div class="recent-order-card" [routerLink]="['/orders', order.id]">
            <div class="recent-order-info">
              <span class="recent-order-id">#{{ order.id.slice(-6).toUpperCase() }}</span>
              <span class="recent-order-date">{{ formatDate(order.createdAt) }}</span>
            </div>
            <app-order-status-badge [status]="order.status"></app-order-status-badge>
          </div>
        }
      </div>
    }
  }

  <!-- ═══════════════════════════════════════
       ADMIN DASHBOARD
  ═══════════════════════════════════════ -->
  @if (isAdmin()) {
    <div class="admin-welcome">
      <h2 class="admin-title">Admin Dashboard</h2>
      <p class="admin-sub">{{ formatDate(null) || 'Today' }}</p>
    </div>

    <!-- KPI Cards. Suppressed entirely when a feed failed: four zeroed tiles
         are indistinguishable from a shop that genuinely took no orders, which
         is the exact failure the error banner above exists to prevent. -->
    @if (isLoading()) {
      <ion-grid>
        <ion-row>
          @for (s of [1, 2, 3, 4]; track s) {
            <ion-col size="6">
              <ion-card class="kpi-skeleton"
                ><ion-skeleton-text animated style="height: 80px"></ion-skeleton-text
              ></ion-card>
            </ion-col>
          }
        </ion-row>
      </ion-grid>
    } @else if (!loadError()) {
      <ion-grid>
        <ion-row>
          <ion-col size="6" size-md="3">
            <div class="kpi-card kpi-revenue">
              <span class="kpi-badge"><app-icon name="banknote" class="kpi-icon" /></span>
              <p class="kpi-label">Today's Revenue</p>
              <p class="kpi-value">{{ todayRevenue() | peso }}</p>
            </div>
          </ion-col>
          <ion-col size="6" size-md="3">
            <div class="kpi-card kpi-pending">
              <span class="kpi-badge"><app-icon name="clock" class="kpi-icon" /></span>
              <p class="kpi-label">Pending Orders</p>
              <p class="kpi-value">{{ pendingOrderCount() }}</p>
            </div>
          </ion-col>
          <ion-col size="6" size-md="3">
            <div class="kpi-card kpi-lowstock">
              <span class="kpi-badge"><app-icon name="circle-alert" class="kpi-icon" /></span>
              <p class="kpi-label">Low Stock Alerts</p>
              <p class="kpi-value">{{ lowStockCount() }}</p>
            </div>
          </ion-col>
          <ion-col size="6" size-md="3">
            <div class="kpi-card kpi-total">
              <span class="kpi-badge"><app-icon name="receipt" class="kpi-icon" /></span>
              <p class="kpi-label">Total Orders</p>
              <p class="kpi-value">{{ totalOrderCount() }}</p>
            </div>
          </ion-col>
        </ion-row>
      </ion-grid>

      <!--
        Admin actions, right-aligned under the toolbar.

        These were full-width stacked buttons sitting in the middle of the page,
        between the metrics and the content. They are navigation, not content, so
        they now sit at the top-right — the same visual corner as the toolbar
        controls they lead to, which is where a person looks for "go somewhere
        else". Two compact tiles rather than two bars, so the row costs ~64px
        instead of ~110px.
      -->
      <div class="admin-actions">
        <a class="action-tile" [routerLink]="'/admin/inventory'">
          <span class="action-icon"><app-icon name="layers" /></span>
          <span class="action-label">Inventory</span>
        </a>
        <a class="action-tile" [routerLink]="'/admin/orders'">
          <span class="action-icon"><app-icon name="clipboard" /></span>
          <span class="action-label">Fulfillment</span>
        </a>
      </div>
    }

    <!--
      Low stock, in its own container.

      This was a bare section heading followed by a column of loose rows, so it
      read as body content rather than as a warning. It is now a single tinted
      panel with a header, so the one thing on this page that needs acting on is
      visibly separate from the two things that are merely informational.
    -->
    @if (lowStockProducts().length > 0) {
      <section class="low-stock-panel">
        <header class="low-stock-head">
          <span class="low-stock-badge"><app-icon name="triangle-alert" /></span>
          <div class="low-stock-head-text">
            <h3 class="low-stock-title">Low Stock Alerts</h3>
            <p class="low-stock-count">
              {{ lowStockCount() }} flavor{{ lowStockCount() === 1 ? '' : 's' }} below {{ lowStockThreshold() }} units
            </p>
          </div>
        </header>

        <ul class="low-stock-list">
          @for (product of pagedLowStock(); track product.id) {
            <li class="low-stock-item">
              <div class="low-stock-info">
                <span class="low-stock-name">{{ product.variantName }}</span>
                <span class="low-stock-set">{{ product.setName }}</span>
              </div>
              <div class="low-stock-levels">
                @if (product.stock.cup < lowStockThreshold()) {
                  <ion-chip color="warning" class="stock-chip-sm">Cup: {{ product.stock.cup }}</ion-chip>
                }
                @if (product.stock.pint < lowStockThreshold()) {
                  <ion-chip color="warning" class="stock-chip-sm">Pint: {{ product.stock.pint }}</ion-chip>
                }
                @if (product.stock.halfGallon < lowStockThreshold()) {
                  <ion-chip color="warning" class="stock-chip-sm">½ Gal: {{ product.stock.halfGallon }}</ion-chip>
                }
                @if (product.stock.gallon < lowStockThreshold()) {
                  <ion-chip color="warning" class="stock-chip-sm">Gal: {{ product.stock.gallon }}</ion-chip>
                }
              </div>
            </li>
          }
        </ul>

        <a class="low-stock-cta" [routerLink]="'/admin/inventory'">
          Restock
          <app-icon name="arrow-right" />
        </a>

        <!--
          Paged from the panel's own total, not the slice above, so the pager
          survives a restock landing while the reader is on a later page — which
          is exactly when they need to get back to page 1. Below the CTA because
          "Restock" is what the panel is for; the pager is chrome for the list.
        -->
        <app-pagination
          [page]="lowStockPage()"
          [total]="lowStockProducts().length"
          [pageSize]="LOW_STOCK_PAGE_SIZE"
          itemLabel="low-stock flavors"
          (pageChange)="lowStockPage.set($event)"
        />
      </section>
    }

    <!-- Recent Orders Table -->
    <div class="section-header">
      <h3 class="section-title">Recent Orders</h3>
      <ion-button fill="clear" size="small" [routerLink]="'/admin/orders'" class="see-all-btn">View All</ion-button>
    </div>
    @if (adminRecentOrders().length > 0) {
      <div class="admin-orders-list">
        @for (order of pagedRecentOrders(); track trackOrder($index, order)) {
          <div class="admin-order-row" [routerLink]="['/orders', order.id]">
            <div class="admin-order-left">
              <span class="admin-order-id">#{{ order.id.slice(-6).toUpperCase() }}</span>
              <span class="admin-order-email">{{ order.customerEmail }}</span>
            </div>
            <div class="admin-order-right">
              <span class="admin-order-total">{{ order.grandTotal | peso }}</span>
              <app-order-status-badge [status]="order.status"></app-order-status-badge>
            </div>
          </div>
        }
      </div>
      <app-pagination
        [page]="recentPage()"
        [total]="adminRecentOrders().length"
        [pageSize]="RECENT_PAGE_SIZE"
        itemLabel="recent orders"
        (pageChange)="recentPage.set($event)"
      />
    }
  }
  <app-footer></app-footer>
</ion-content>
</file>

<file path="src/app/features/developers/developers.page.html">
<!-- src/app/features/developers/developers.page.html -->
<!-- Five-orites Scoop — Team Credits Page -->

<ion-header>
  <ion-toolbar color="primary">
    <ion-buttons slot="start">
      <ion-menu-button aria-label="Open navigation menu"></ion-menu-button>
    </ion-buttons>
    <ion-title>The Team</ion-title>
    <ion-buttons slot="end">
      <app-cart-button></app-cart-button>
    </ion-buttons>
  </ion-toolbar>
</ion-header>

<ion-content fullscreen>
  <!--
    Hero. A gradient band closed by `wave-drip`'s cream swell, carrying one line of
    copy and nothing else.

    It used to hold an authored SVG of the vendor inside a white rounded card, plus
    the page's h1 and tagline. Two of those three moved out:

      - The illustration is gone. It was never really a container's worth of
        artwork — the SVG painted its own opaque full-bleed background
        (`<rect width="320" height="200" fill="url(#dv-sky)">`) and
        `.vendor-art` is `width: 100%`, so the card's `background: white` was
        never visible. The card only supplied rounded corners and a shadow. So
        "remove the container" had no white to remove; keeping the illustration
        would have left its hard square corners on the gradient, and making the
        SVG transparent instead would have deleted six of its ten elements
        (canopy, apron, cap band, shirt, cone and blush scoop all measured
        1.00-1.13:1 against one end of --gradient-brand). It went entirely.
      - The h1 and its sub-line moved to .dev-intro, below the swell, where they
        introduce the cards instead of floating in a banner.

    What came back is one tagline, set in the same retro script as About's
    .hero-title — the same job, a line of display type in a hero — at roughly half
    the size because this string is 36 characters to About's 17.

    The swell is cream and the page is cream, so it hands off with no seam.
  -->
  <!--
    The motto: one line, in the app's own display face.

    This has been three different things — a Lobster Two script line, a
    three-line poster stack with "Five" enlarged, and a Kaushan Script brush lead
    over two Baloo 2 supporting lines. All three are gone, and the reasons are
    worth keeping so the shape is not reinvented:

      - It is NOT Lobster Two. That face is the app's retro treatment for six other
        strings; a seventh hero line in the same script made the two heroes match,
        and matching heroes is what made the page read as one system rather than two.
      - It is NOT a poster stack. Stacking needs a solid face with predictable
        vertical boxes, and the enlarged word wanted a script or brush — which is
        exactly the face whose ascenders overrun the line box.
      - It is NOT a brush. Baloo 2 and Kaushan Script were both added to
        variables.scss and to the Google Fonts request for this motto alone, and
        both were removed again once it stopped using them, taking the app from six
        font families back to four. Neither token survives.

    A <p>, not a heading, and that has not changed through any of those revisions.
    The page's only <h1> is "Meet the Developers" in .dev-intro below the swell, so
    a heading level here would put an h2 in the outline above the h1 that titles it.
  -->
  <div class="dev-hero wave-drip">
    <p class="dev-hero-tagline">Five flavors. One sweet masterpiece.</p>
  </div>

  <!--
    The page's only h1, sat directly above the cards it introduces rather than
    inside the hero. Type-matched to the card area on purpose: same display face
    and weight as .dev-name, same centring as .dev-card-content, so the heading
    reads as part of the team block instead of a banner title.

    Moving the tagline off the gradient also fixes a real contrast failure. It was
    `--color-ink-soft` on `--gradient-brand`: 5.80:1 with the default ink, but
    3.58:1 with the `[data-contrast='high']` ink `#6B5875`, which is under the
    4.5:1 owed by 14px text. On cream that ink is 6.20:1.
  -->
  <div class="dev-intro">
    <h1 class="dev-intro-title">Meet the Developers</h1>
    <p class="dev-intro-sub">The team behind Five-orites Scoop</p>
  </div>

  <!-- Developer Grid -->
  <ion-grid class="dev-grid">
    <ion-row>
      @for (dev of developers(); track dev.id) {
        <ion-col size="12" size-md="6" size-lg="4">
          <ion-card class="dev-card">
            <ion-card-content class="dev-card-content">
              <!--
                The photo when there is one, the initials when there is not, on the
                same accent disc — so a card is the same size in both states and the
                grid does not reflow the moment an owner uploads a photo.

                256 here rather than the admin list's 128, and the difference is not
                an inconsistency: these are the page's focal images at 72px CSS,
                which is ~216 device px on a 3x phone, so 128 is already under 1:1
                and visibly soft. 128 is correct for the admin row's 56px thumbnail
                and should stay there.
              -->
              <ion-avatar class="dev-avatar" [style.background]="dev.accent">
                @if (dev.photoURL) {
                  <img class="dev-photo" [src]="dev.photoURL | cloudinary: 256" [alt]="dev.name" />
                } @else {
                  <div class="dev-initials">{{ initialsFor(dev) }}</div>
                }
              </ion-avatar>

              <div class="dev-info">
                <h2 class="dev-name">{{ dev.name }}</h2>
                <div class="dev-roles">
                  @for (role of dev.roles; track role) {
                    <!--
                      Explicit colours, NOT `[color]="getRoleColor(role)"`.

                      Ionic's `color` input derives a foreground AND a background
                      from the same name, with no contrast relationship between
                      them. Measured on the live DOM it produced:

                        #64B6DD on #8ECAE6   1.27:1   Main Project Lead
                        #36CFA1 on #5FD9B4   1.14:1   Full Stack Dev
                        #FFB60A on #FFC53D   1.11:1   UI/UX Designer
                        #974608 on #B45309   1.31:1   QA
                        #808289 on #FFF9F4   3.67:1   Documentation

                      Five of five role chips were unreadable, and `color` is the
                      wrong tool for text contrast — it is built for tints. The
                      admin version of these same chips already does it correctly
                      (explicit background plus an ink), so this brings the public
                      page in line with a pattern already in the codebase.

                      It also drops the double `getRoleColor()` call per chip that
                      the `[outline]` binding was making.
                    -->
                    <ion-chip class="role-chip" [ngClass]="roleClass(role)">
                      <ion-label>{{ role }}</ion-label>
                    </ion-chip>
                  }
                </div>
              </div>
            </ion-card-content>
          </ion-card>
        </ion-col>
      }
    </ion-row>
  </ion-grid>

  <!-- Credit -->
  <div class="dev-footer">
    <app-icon name="code" class="footer-icon" />
    <p class="footer-text">Built with Ionic &middot; Angular &middot; Firebase</p>
    <p class="footer-sub">Five-orites Scoop &copy; {{ currentYear }}</p>
  </div>
  <app-footer></app-footer>
</ion-content>
</file>

<file path="src/app/features/orders/order-tracker/order-tracker.page.html">
<!-- src/app/features/orders/order-tracker/order-tracker.page.html -->

<ion-header>
  <ion-toolbar color="primary">
    <ion-buttons slot="start">
      <ion-back-button defaultHref="/orders" text="Orders"></ion-back-button>
    </ion-buttons>
    <ion-title>Order Tracker</ion-title>
    <ion-buttons slot="end">
      <app-cart-button></app-cart-button>
    </ion-buttons>
  </ion-toolbar>
</ion-header>

<ion-content fullscreen>
  <!-- Loading -->
  @if (isLoading()) {
    <div class="tracker-body">
      <ion-skeleton-text animated style="height: 20px; width: 50%; margin-bottom: 8px"></ion-skeleton-text>
      <ion-skeleton-text animated style="height: 160px; border-radius: 14px"></ion-skeleton-text>
    </div>
  }

  <!-- Error -->
  @if (!isLoading() && errorMessage()) {
    <div class="error-state">
      <p>{{ errorMessage() }}</p>
    </div>
  }

  <!-- Tracker Content -->
  @if (!isLoading() && order()) {
    <div class="tracker-body">
      <!-- Order ID + Date -->
      <div class="order-header">
        <div>
          <p class="order-label">Order</p>
          <h2 class="order-id">#{{ order()!.id.slice(-6).toUpperCase() }}</h2>
        </div>
        <div class="order-date-wrap">
          <p class="order-label">Placed</p>
          <p class="order-date">{{ formatDate(order()!.createdAt) }}</p>
        </div>
        <app-order-status-badge [status]="order()!.status"></app-order-status-badge>
      </div>

      <!-- Cancelled Banner -->
      @if (isCancelled()) {
        <div class="cancelled-banner">
          <app-icon name="circle-x" />
          This order has been cancelled.
          @if (order()!.cancelReason) {
            <p class="info-notes">Reason: {{ order()!.cancelReason }}</p>
          }
        </div>
      }

      @if (canCancel()) {
        <ion-button
          expand="block"
          fill="outline"
          color="danger"
          class="cancel-order-btn"
          (click)="cancelOrder()"
          [disabled]="isCancelling()"
        >
          {{ isCancelling() ? 'Cancelling...' : 'Cancel Order' }}
        </ion-button>
      }

      <!-- Status Timeline (vertical stepper) -->
      @if (!isCancelled()) {
        <div class="timeline">
          @for (step of statusSequence; track step) {
            <div class="timeline-step" [class]="'step-' + getStepState(step)">
              <div class="step-icon-wrap">
                <div class="step-dot">
                  <app-icon [name]="statusMeta[step].icon" class="step-icon" />
                </div>
                @if (!$last) {
                  <div class="step-line"></div>
                }
              </div>
              <div class="step-content">
                <p class="step-label">{{ statusMeta[step].label }}</p>
                @if (getStepState(step) === 'active') {
                  <p class="step-desc">{{ statusMeta[step].description }}</p>
                }
                @if (getStepTimestamp(step)) {
                  <p class="step-time">{{ getStepTimestamp(step) }}</p>
                }
              </div>
            </div>
          }
        </div>
      }

      <!--
        The map. Progressive enhancement, not a gate: the status timeline above and
        the address below carry the same information, so a failed tile load costs
        the customer nothing. The status path is also the only thing that advances
        the courier marker -- see mapMarkers() for why there is no live GPS.
      -->
      <ion-card class="info-card map-card">
        <ion-card-content>
          <p class="info-label">Live route</p>
          <app-scoop-map
            [markers]="mapMarkers()"
            [route]="mapRoute()"
            height="240px"
            ariaLabel="Route from the shop to your delivery address"
          />

          @if (isGeocoding()) {
            <p class="map-note">Looking up your address…</p>
          } @else if (geoUnavailable()) {
            <p class="map-note">
              We couldn't place your address on the map, but your delivery details below are up to date.
            </p>
          } @else if (courierProgress() !== null) {
            <p class="map-note">
              Your order is on its way — roughly
              {{ courierDistanceLabel() }} from the shop.
            </p>
          }
        </ion-card-content>
      </ion-card>

      <!-- Delivery Address -->
      <ion-card class="info-card">
        <ion-card-content>
          <p class="info-label">Delivering to</p>
          <p class="info-value">{{ order()!.deliveryAddress }}</p>
          @if (order()!.notes) {
            <p class="info-notes">Note: {{ order()!.notes }}</p>
          }
          <a class="address-link" [href]="deliveryMapsUrl()" target="_blank" rel="noopener noreferrer">
            <app-icon name="map-pin" />
            Open in Maps
          </a>
        </ion-card-content>
      </ion-card>

      <!-- Order Items -->
      <ion-card class="info-card">
        <ion-card-content>
          <p class="info-label">Items Ordered</p>
          @for (item of order()!.items; track item.productId + item.size) {
            <div class="order-item-row">
              <span class="item-name">{{ item.variantName }}</span>
              <span class="item-size">{{ sizeLabels[item.size] }}</span>
              <span class="item-qty">×{{ item.quantity }}</span>
              <span class="item-price">{{ item.subtotal | peso }}</span>
            </div>
          }
          <div class="totals-block">
            <div class="total-row">
              <span>Subtotal</span>
              <span>{{ order()!.totalAmount | peso }}</span>
            </div>
            @if ((order()!.discountAmount ?? 0) > 0) {
              <div class="total-row">
                <span>Voucher {{ order()!.voucherCode }}</span>
                <span>-{{ order()!.discountAmount ?? 0 | peso }}</span>
              </div>
            }
            <div class="total-row">
              <span>Delivery</span>
              <span>{{ order()!.deliveryFee === 0 ? 'FREE' : (order()!.deliveryFee | peso) }}</span>
            </div>
            <div class="total-row grand">
              <span>Total</span>
              <span>{{ order()!.grandTotal | peso }}</span>
            </div>
          </div>
        </ion-card-content>
      </ion-card>
    </div>
  }
  <app-footer></app-footer>
</ion-content>
</file>

<file path="src/app/features/products/products.page.html">
<!-- src/app/features/products/products.page.html -->
<!-- Five-orites Scoop — Product Catalog Template -->

<ion-header>
  <ion-toolbar color="primary">
    <ion-buttons slot="start">
      <ion-menu-button aria-label="Open navigation menu"></ion-menu-button>
    </ion-buttons>
    <ion-title>Our Flavors</ion-title>
    <ion-buttons slot="end">
      <app-cart-button></app-cart-button>
    </ion-buttons>
  </ion-toolbar>
</ion-header>

<ion-content fullscreen>
  <!-- Pull to refresh -->
  <ion-refresher slot="fixed" (ionRefresh)="handleRefresh($event)">
    <ion-refresher-content></ion-refresher-content>
  </ion-refresher>

  <!-- Sticky Filter Bar -->
  <div class="filter-bar">
    <!--
      Capped at 300px and left-aligned.

      It was unconstrained, so it spanned the full width of every screen from a
      360px phone to a 1440px desktop — a 1440px-wide search box for a catalog
      of 64 items, with the filter controls stacked beneath it. A search field
      has a comfortable reading measure and no more; past ~300px it is just
      empty space, and on a wide screen it pushed every filter below the fold.
    -->
    <ion-searchbar
      #searchbar
      placeholder="Search flavors"
      debounce="300"
      (ionInput)="onSearch($event)"
      class="product-searchbar"
      aria-label="Search ice cream flavors"
    ></ion-searchbar>

    <!-- Set Filter Chips (horizontal scroll).
         Tracked by set number rather than label text: the number is the real
         identity, so renaming a set cannot break the row and two sets can never
         collide on a duplicate name. -->
    <div class="set-chips-scroll">
      @for (chip of setChips(); track chip.value) {
        <!--
          Explicit classes, NOT [color] + [outline].
          Ionic's color input picks a foreground AND a background from one name with no
          relationship between them. Measured on this page: the selected chip was
          #64B6DD on #8ECAE6 (1.27:1) and the unselected one #808289 on white (3.84:1).
          Both states failed; only the selected one was visible before any filter was
          chosen, which is why every earlier audit of this page passed.
          aria-pressed is unchanged and remains the real state announcement.

          The array form of ngClass carries THREE things: the selected/idle state,
          and the flavour modifier that carries the pastel. The modifier is
          omitted entirely when `slug` is empty — the "All" chip, or any flavour
          missing from the map — because Angular ignores the empty string, so that
          chip just keeps the --flavor-all default declared on `.set-chip`.
        -->
        <ion-chip
          [ngClass]="[
            effectiveSet() === chip.value ? 'set-chip-active' : 'set-chip-idle',
            chip.slug ? 'set-chip--' + chip.slug : '',
          ]"
          (click)="selectSet(chip.value)"
          (keydown.enter)="selectSet(chip.value)"
          (keydown.space)="selectSet(chip.value); $event.preventDefault()"
          role="button"
          tabindex="0"
          [attr.aria-pressed]="effectiveSet() === chip.value"
          class="set-chip"
        >
          <ion-label>{{ chip.label }}</ion-label>
        </ion-chip>
      }
    </div>

    <!--
      Filters, in one container.

      This is the consolidation. Previously the bar was seven stacked blocks —
      a full-width searchbar, a chip scroller, two full-width toggle rows in
      their own container, Size and Max price in a third, and Type alone in a
      FOURTH block that existed purely to borrow that third block's padding. On a
      640px-tall phone that was ~300px of permanently pinned chrome, roughly 40%
      of the screen, before a single flavor card appeared.

      Now: the two switches sit directly beside their own labels rather than at
      the far end of a full-width row, and Size / Max price / Type share one
      compact panel in the space the toggles used to occupy. Selects rather than
      chips for all three, because each is a fixed set defined in code — a chip
      row would imply a fourth option could appear. Each control keeps both a
      visible label and an aria-label, so the accessible name is announced
      either way.
    -->
    <div class="filters">
      <div class="switch-rows">
        <div class="switch-row">
          <app-icon name="package" class="switch-icon" />
          <label class="switch-label" for="instock-toggle">In stock only</label>
          <ion-toggle
            id="instock-toggle"
            class="switch-toggle"
            [checked]="inStockOnly()"
            (ionChange)="onInStockToggle($event)"
            aria-label="Show in-stock products only"
          ></ion-toggle>
        </div>

        <div class="switch-row">
          <app-icon name="heart" class="switch-icon" />
          <label class="switch-label" for="wishlist-toggle">Wishlist only</label>
          <ion-toggle
            id="wishlist-toggle"
            class="switch-toggle"
            [checked]="wishlistOnly()"
            (ionChange)="onWishlistToggle($event)"
            aria-label="Show wishlisted products only"
          ></ion-toggle>
        </div>
      </div>

      <div class="select-panel">
        <div class="select-row">
          <span class="select-label">Size</span>
          <ion-select
            id="size-select"
            class="select-control"
            [value]="selectedSize()"
            (ionChange)="onSizeChange($event)"
            aria-label="Filter by size"
          >
            @for (opt of sizeOptions; track opt.label) {
              <ion-select-option [value]="opt.value">{{ opt.label }}</ion-select-option>
            }
          </ion-select>
        </div>

        <div class="select-row">
          <span class="select-label">Max price</span>
          <ion-select
            id="max-price-select"
            class="select-control"
            [value]="maxPrice()"
            (ionChange)="onMaxPriceChange($event)"
            aria-label="Maximum price"
          >
            @for (opt of maxPriceOptions; track opt.label) {
              <ion-select-option [value]="opt.value">{{ opt.label }}</ion-select-option>
            }
          </ion-select>
        </div>

        <div class="select-row">
          <span class="select-label">Type</span>
          <ion-select
            id="category-select"
            class="select-control"
            [value]="selectedCategory()"
            (ionChange)="onCategoryChange($event)"
            aria-label="Product type"
          >
            @for (opt of categoryOptions; track opt.label) {
              <ion-select-option [value]="opt.value">{{ opt.label }}</ion-select-option>
            }
          </ion-select>
        </div>
      </div>
    </div>

    <!-- Sort: a segment, because it is a small fixed set of mutually exclusive
         orders and switching between them is the point of the control. -->
    <div class="sort-row">
      <span class="filter-label" id="sort-label">Sort by</span>
      <ion-segment
        [value]="sortBy()"
        (ionChange)="onSortChange($event)"
        aria-labelledby="sort-label"
        class="sort-segment"
      >
        @for (opt of sortOptions; track opt.value) {
          <ion-segment-button [value]="opt.value" [attr.aria-label]="opt.label">
            <ion-label>{{ opt.short }}</ion-label>
          </ion-segment-button>
        }
      </ion-segment>
    </div>

    @if (hasActiveFilters()) {
      <div class="clear-row">
        <ion-button
          size="small"
          fill="clear"
          (click)="clearFilters()"
          class="clear-btn"
          aria-label="Clear all filters and sorting"
        >
          <app-icon name="x" />
          Clear all
        </ion-button>
      </div>
    }
  </div>

  <!-- Loading Skeleton -->
  @if (isLoading()) {
    <ion-grid class="products-grid">
      <ion-row>
        @for (s of skeletonItems; track $index) {
          <ion-col size="6" size-md="4" size-lg="3">
            <ion-card class="skeleton-card">
              <ion-skeleton-text animated style="height: 140px; margin: 0"></ion-skeleton-text>
              <div style="padding: 12px">
                <ion-skeleton-text animated style="height: 16px; width: 80%; margin-bottom: 8px"></ion-skeleton-text>
                <ion-skeleton-text animated style="height: 32px; margin-bottom: 8px"></ion-skeleton-text>
                <ion-skeleton-text animated style="height: 20px; width: 60%; margin-bottom: 8px"></ion-skeleton-text>
                <ion-skeleton-text animated style="height: 40px"></ion-skeleton-text>
              </div>
            </ion-card>
          </ion-col>
        }
      </ion-row>
    </ion-grid>
  }

  <!-- Error State -->
  @if (!isLoading() && errorMessage()) {
    <app-empty-state
      icon="frown"
      title="Something went wrong"
      [message]="errorMessage()"
      actionLabel="Try again"
      (action)="loadProducts()"
    />
  }

  <!-- Empty State -->
  @if (!isLoading() && !errorMessage() && filteredProducts().length === 0) {
    <app-empty-state icon="ice-cream" title="No flavors found" message="Try a different search or filter." />
  }

  <!--
    Product Grid.

    Gated on `filteredProducts()` rather than on the rendered page, so the pager
    below stays mounted when the current page happens to be past the end of the
    list. Gating on the page slice would make the pager vanish at exactly the
    moment it is needed to get the user back.
  -->
  @if (!isLoading() && filteredProducts().length > 0) {
    <ion-grid class="products-grid">
      <ion-row>
        @for (product of pagedProducts(); track trackProduct($index, product)) {
          <ion-col size="6" size-md="4" size-lg="3">
            <app-product-card [product]="product"></app-product-card>
          </ion-col>
        }
      </ion-row>
    </ion-grid>

    <app-pagination
      [page]="page()"
      [total]="filteredProducts().length"
      [pageSize]="PAGE_SIZE"
      itemLabel="flavors"
      (pageChange)="page.set($event)"
    />
  }
  <app-footer></app-footer>
</ion-content>
</file>

