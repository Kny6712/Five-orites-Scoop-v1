<file path="src/app/features/cart/cart.page.ts">
// src/app/features/cart/cart.page.ts
// Five-orites Scoop — Cart & Checkout (Fixed double-decrement bug)

import { Component, OnInit, inject, signal, computed } from '@angular/core';
import { CommonModule } from '@angular/common';
import { FormsModule } from '@angular/forms';
import { Router, RouterLink, ActivatedRoute } from '@angular/router';
import {
  IonHeader,
  IonToolbar,
  IonTitle,
  IonContent,
  IonButtons,
  IonMenuButton,
  IonButton,
  IonText,
  IonTextarea,
  IonSpinner,
  AlertController,
  ToastController,
} from '@ionic/angular/standalone';
import { AppIconComponent } from '../../shared/components/app-icon/app-icon.component';
import { catchError, of } from 'rxjs';
import { CartService } from '../../core/services/cart.service';
import { OrderService } from '../../core/services/order.service';
import { AddressService } from '../../core/services/address.service';
import { VoucherService } from '../../core/services/voucher.service';
import { InventoryService } from '../../core/services/inventory.service';
import {
  Cart,
  CartItem,
  getDeliveryFee,
  FREE_DELIVERY_THRESHOLD,
} from '../../core/models/cart.model';
import { Product, SizeVariant } from '../../core/models/product.model';
import { PesoPipe } from '../../shared/pipes/peso.pipe';
import { CloudinaryPipe } from '../../shared/pipes/cloudinary.pipe';
import { SIZE_DISPLAY_LABELS } from '../../core/config/pricing.config';
import { PENDING_VOUCHER_KEY } from '../dashboard/voucher-cards/voucher-cards.component';
import { QtyStepperComponent } from '../../shared/components/qty-stepper/qty-stepper.component';
import { EmptyStateComponent } from '../../shared/components/empty-state/empty-state.component';
import { AlertBannerComponent } from '../../shared/components/alert-banner/alert-banner.component';
import { AppFooterComponent } from '../../shared/components/app-footer/app-footer.component';

/**
 * Ceiling used when live stock is unknown.
 *
 * Only reached when the stock read failed, and the page already says so. A low
 * value here would be a second, contradictory statement about the same thing.
 */
const FALLBACK_QTY_CEILING = 99;
import { takeUntilDestroyed } from '@angular/core/rxjs-interop';

type CheckoutStep = 1 | 2 | 3;

@Component({
  selector: 'app-cart',
  standalone: true,
  imports: [
    CommonModule,
    FormsModule,
    RouterLink,
    IonHeader,
    IonToolbar,
    IonTitle,
    IonContent,
    IonButtons,
    IonMenuButton,
    IonButton,
    IonText,
    IonTextarea,
    IonSpinner,
    PesoPipe,
    CloudinaryPipe,
    AppIconComponent,
    QtyStepperComponent,
    EmptyStateComponent,
    AlertBannerComponent,
    AppFooterComponent,
  ],
  templateUrl: './cart.page.html',
  styleUrls: ['./cart.page.scss'],
})
export class CartPage implements OnInit {
  private cartService = inject(CartService);
  private orderService = inject(OrderService);
  private route = inject(ActivatedRoute);
  private addressService = inject(AddressService);
  private voucherService = inject(VoucherService);
  private inventoryService = inject(InventoryService);
  private router = inject(Router);
  private alertCtrl = inject(AlertController);
  private toastCtrl = inject(ToastController);

  cart = signal<Cart>({ items: [], totalAmount: 0, itemCount: 0 });
  checkoutStep = signal<CheckoutStep>(1);
  deliveryAddress = '';
  notes = '';
  isPlacingOrder = signal(false);
  errorMessage = signal('');
  lastOrderId = signal<string | null>(null);
  savedAddresses = signal<string[]>([]);
  voucherCode = '';
  voucherDiscount = signal(0);
  appliedVoucher = signal<string | null>(null);
  voucherMessage = signal('');

  /** Live stock per `${productId}|${size}` so the stepper cannot oversell. */
  private stockMap = new Map<string, number>();

  /**
   * True when the live stock read failed. The quantity steppers then stop
   * pretending to know what is available instead of silently allowing an
   * uncapped quantity through.
   */
  readonly stockUnavailable = signal(false);

  readonly sizeLabels = SIZE_DISPLAY_LABELS;
  readonly freeDeliveryThreshold = FREE_DELIVERY_THRESHOLD;

  deliveryFee = computed(() => getDeliveryFee(this.cart().totalAmount));
  isFreeDelivery = computed(() => this.deliveryFee() === 0 && this.cart().items.length > 0);
  amountAwayFromFreeDelivery = computed(() =>
    Math.max(this.freeDeliveryThreshold - this.cart().totalAmount, 0),
  );
  grandTotal = computed(
    () => this.cart().totalAmount - this.voucherDiscount() + this.deliveryFee(),
  );

  constructor() {
    this.cartService.cart$.pipe(takeUntilDestroyed()).subscribe((c) => {
      this.cart.set(c);
      // Re-validate voucher when cart changes.
      if (this.appliedVoucher()) {
        this.voucherService
          .validateVoucher(this.appliedVoucher()!, c.totalAmount)
          .then(({ discount }) => this.voucherDiscount.set(discount))
          .catch(() => {
            this.voucherDiscount.set(0);
            this.appliedVoucher.set(null);
            this.voucherMessage.set('Voucher no longer valid for this cart total.');
          });
      }
    });
    this.addressService.addresses$
      .pipe(takeUntilDestroyed())
      .subscribe((a) => this.savedAddresses.set(a));

    // Track live stock so quantity changes are capped at what's actually
    // available, instead of failing at checkout.
    //
    // This must not collapse to an empty list on failure. An empty stockMap
    // makes availableFor() return undefined, and clampToStock passes the
    // quantity through uncapped when availability is unknown — so a failed read
    // would silently DISABLE the stock cap. The user is told instead.
    //
    // The comment here used to end "and the server-side check in
    // validateAndDecrementStock remains the backstop". That method had no
    // callers left and was deleted: stock is reserved by the
    // reconcileOrderStock Cloud Function, which decrements in a transaction and
    // cancels the order itself if the shelf is short. That is the backstop now.
    // See CUTOVER.md for why the function has to be live before the customer
    // branch of the products rule is removed.
    this.inventoryService
      .getProducts()
      .pipe(
        takeUntilDestroyed(),
        catchError((err) => {
          console.error('Failed to load stock levels.', err);
          this.stockUnavailable.set(true);
          return of([] as Product[]);
        }),
      )
      .subscribe((products) => {
        const map = new Map<string, number>();
        for (const p of products) {
          for (const size of Object.keys(p.stock ?? {}) as SizeVariant[]) {
            map.set(`${p.id}|${size}`, p.stock[size] ?? 0);
          }
        }
        this.stockMap = map;
      });
  }

  ngOnInit(): void {
    this.consumeHandedOverVoucher();
  }

  goToProducts(): void {
    void this.router.navigate(['/products']);
  }

  /**
   * Applies a voucher handed over from the dashboard's grab-a-code cards.
   *
   * The code arrives as a query parameter AND is mirrored into sessionStorage by
   * the dashboard. The parameter is the primary path; sessionStorage is the
   * fallback for a reload or a back-navigation, where the query string survives
   * anyway but a direct paste of the URL does not.
   *
   * Whichever source is used, the code goes through `applyVoucher()` — the same
   * path a typed code takes, re-validated against the live cart total. Nothing
   * about a code arriving via navigation grants it any privilege, and the discount
   * is still resolved server-side by OrderService at checkout.
   */
  private consumeHandedOverVoucher(): void {
    const fromQuery = this.route.snapshot.queryParamMap.get('voucher');
    let code = fromQuery;

    if (!code) {
      try {
        code = sessionStorage.getItem(PENDING_VOUCHER_KEY);
      } catch {
        // Storage disabled; the query parameter is the only route anyway.
      }
    }
    if (!code) return;

    // Consume it, so a later reload does not silently re-apply a code the user
    // may since have removed.
    try {
      sessionStorage.removeItem(PENDING_VOUCHER_KEY);
    } catch {
      // ignore
    }

    this.voucherCode = code.trim().toUpperCase();
    void this.applyVoucher();
  }

  /** Stock available for this line, or undefined when unknown. */
  availableFor(item: CartItem): number | undefined {
    return this.stockMap.get(`${item.productId}|${item.size}`);
  }

  atStockLimit(item: CartItem): boolean {
    const available = this.availableFor(item);
    return available !== undefined && item.quantity >= available;
  }

  removeItem(item: CartItem): void {
    this.cartService.removeItem(item.productId, item.size);
  }

  /**
   * Ceiling for the shared stepper on this line.
   *
   * When the live stock read FAILED, `availableFor` returns undefined and the
   * ceiling falls back to a generous constant rather than to 1 — the cart already
   * surfaces `stockUnavailable` and explains that quantities cannot be capped, so
   * freezing the stepper at 1 would be a second, contradictory message.
   */
  maxFor(item: CartItem): number {
    return this.availableFor(item) ?? FALLBACK_QTY_CEILING;
  }

  /**
   * Applies a stepper change.
   *
   * Still routed through CartService.updateQuantity rather than writing the value
   * directly, because that is where the stock cap and the cart-total recompute
   * live. The stepper clamps too, but the service remains the authority.
   */
  setQty(item: CartItem, quantity: number): void {
    if (quantity === item.quantity) return;
    this.cartService.updateQuantity(item.productId, item.size, quantity, this.availableFor(item));
  }

  async clearCart(): Promise<void> {
    const alert = await this.alertCtrl.create({
      header: 'Clear Cart',
      message: 'Remove all items from your cart?',
      buttons: [
        { text: 'Cancel', role: 'cancel' },
        { text: 'Clear', role: 'destructive', handler: () => this.cartService.clearCart() },
      ],
    });
    await alert.present();
  }

  // Step 1 → Step 2: Validate address then show review
  proceedToReview(): void {
    if (!this.deliveryAddress.trim()) {
      this.errorMessage.set('Please enter your delivery address.');
      return;
    }
    this.errorMessage.set('');
    this.addressService.saveAddress(this.deliveryAddress);
    this.checkoutStep.set(2);
  }

  useSavedAddress(address: string): void {
    this.deliveryAddress = address;
  }

  async applyVoucher(): Promise<void> {
    this.voucherMessage.set('');
    try {
      const { voucher, discount } = await this.voucherService.validateVoucher(
        this.voucherCode,
        this.cart().totalAmount,
      );
      this.appliedVoucher.set(voucher.code);
      this.voucherDiscount.set(discount);
      this.voucherMessage.set(`✅ ${voucher.code} applied — you save ₱${discount}!`);
    } catch (err) {
      this.voucherDiscount.set(0);
      this.appliedVoucher.set(null);
      this.voucherMessage.set(err instanceof Error ? err.message : 'Invalid voucher.');
    }
  }

  removeVoucher(): void {
    this.voucherCode = '';
    this.voucherDiscount.set(0);
    this.appliedVoucher.set(null);
    this.voucherMessage.set('');
  }

  backToCart(): void {
    this.checkoutStep.set(1);
    this.errorMessage.set('');
  }

  // Step 2 → Place Order (called ONCE only from the Review screen)
  async placeOrder(): Promise<void> {
    if (this.isPlacingOrder()) return; // ← prevents double-tap double-call
    this.isPlacingOrder.set(true);
    this.errorMessage.set('');

    try {
      // Pass null for empty notes — never undefined
      const notesValue = this.notes.trim().length > 0 ? this.notes.trim() : undefined;

      // Pass only the voucher CODE. OrderService re-resolves the discount from
      // Firestore so the charged amount can never be dictated by the client.
      const orderId = await this.orderService.placeOrder(
        this.deliveryAddress.trim(),
        notesValue,
        this.appliedVoucher(),
      );

      this.lastOrderId.set(orderId);
      this.notes = '';
      this.removeVoucher();
      this.checkoutStep.set(3);
      setTimeout(() => this.router.navigate(['/orders', orderId]), 4000);
    } catch (err: unknown) {
      const message =
        err instanceof Error ? err.message : 'Failed to place order. Please try again.';
      this.errorMessage.set(message);
      const toast = await this.toastCtrl.create({
        message,
        color: 'danger',
        duration: 4000,
        position: 'top',
      });
      await toast.present();
    } finally {
      this.isPlacingOrder.set(false);
    }
  }

  trackItem(_: number, item: CartItem): string {
    return `${item.productId}-${item.size}`;
  }

  orderMore(): void {
    this.checkoutStep.set(1);
    this.errorMessage.set('');
    void this.router.navigate(['/products']);
  }

  viewTracker(): void {
    const id = this.lastOrderId();
    if (id) void this.router.navigate(['/orders', id]);
    else void this.router.navigate(['/orders']);
  }
}
</file>

<file path="src/app/features/dashboard/dashboard.page.scss">
// src/app/features/dashboard/dashboard.page.scss

// ── Customer Welcome ─────────────────────────────────────
.welcome-banner {
  /* A deeper lemon, not --tile-lemon and not the old --gradient-brand.
     --tile-lemon was the obvious choice and is wrong here: at 1.06:1 against the
     cream page it has no edge at all, so the greeting would read as a patch of
     yellow rather than a card. --tile-lemon-deep reaches 1.20:1.

     Two things measured before choosing it, both in the token's comment:
       - the gold retro shadow on the title gets STRONGER (1.26:1 vs 1.13:1 on
         the old gradient), so the sticker treatment improves rather than fades;
       - it stays 1.14:1 off .announce-banner below it, which is --tile-lemon.
         Using that same --tile-lemon here would have made the two cards
         identical at 1.00:1, stacked, on the same screen.

     Plum on this surface is 10.25:1, up from 7.20:1 on the gradient, so the
     greeting and the subtitle both get easier to read. */
  background: var(--tile-lemon-deep);
  margin: 12px 12px 0;
  border-radius: 18px;
  padding: 20px;
  display: flex;
  align-items: center;
  gap: 12px;
  color: var(--color-ink);
}
.welcome-text {
  flex: 1;

  /* This greeting is the one display string in the app whose length is NOT
     under our control — it is the user's own first name, from
     `(displayName || 'Scooper').split(' ')[0]`, and displayName is whatever
     they typed at registration.

     In a flex row, `flex: 1` alone means "shrink to the content's min-content
     width", and for a long unbreakable name that min-content width is the whole
     word. So without min-width: 0 the text box refuses to shrink below it and
     pushes out past the card's rounded edge. overflow-wrap then gives the
     desperate name somewhere to break. Neither property is decorative: they are
     what stops a long name from breaking the layout. */
  min-width: 0;
  overflow-wrap: anywhere;
}

.welcome-title {
  /* The second of two opt-in retro strings. See --font-display-retro. */
  font-family: var(--font-display-retro);
  font-weight: 700;

  /* Smaller clamp than the About hero on purpose. This is a card on a page,
     not a hero: the banner sits on cream with a 72px logo plate beside it, so
     the script has less room and a heavier line would crowd both. 18.4-24px
     keeps the first name on one line for most names while staying a display
     size rather than collapsing into the body face. */
  font-size: clamp(1.15rem, 3.4vw, 1.5rem);
  line-height: 1.1;
  letter-spacing: -0.3px;
  margin: 0 0 var(--space-2);
}

/* The shadow lives on the greeting alone, NOT on the heading. Set on the
   heading it would paint behind the scoop emoji too, and a colour emoji is a
   bitmap rather than text — the offset renders as a hard gold fringe around it
   instead of a shadow. */
.welcome-greeting {
  text-shadow: var(--display-sticker-shadow);
}

/* The emoji needs the line-height reset as well, or the taller script leading
   opens a gap between the scoop and the exclamation mark beside it. */
.welcome-scoop {
  line-height: 1;
}
.welcome-sub {
  font-size: 14px;
  margin: 0;
  opacity: 0.85;
}
.welcome-image-wrap {
  width: 72px;
  height: 72px;
  flex-shrink: 0;
  /* 50%, for consistency with the other three plates. This one is cosmetic
     only: .welcome-image is width/height 100% and this wrap has no border, so
     the image covers the plate completely and the radius is never visible. */
  border-radius: 50%;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.15);
}
.welcome-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

// ── Promo Banner ─────────────────────────────────────────
/* Notification control. Was a div with role="button" and a click handler that
   re-prompted on every tap; now a real toggle with copy that changes to match
   the actual state, including "your browser is blocking this". */
.promo-icon {
  --icon-size: 22px;
  flex: 0 0 auto;
}

.promo-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 1px;
}

.promo-title {
  font-weight: 800;
  font-size: 14px;
}

/* The link into the notifications feed, so the notification banner is a way INTO
   the history rather than only a switch. Sits under the prose inside the same
   flex column, which is why it is a block-level underline rather than an inline
   accent — a link sharing a line with `promo-sub` would be read as part of the
   sentence. */
.promo-link {
  margin-top: var(--space-1);
  align-self: flex-start;
  font-size: 12px;
  font-weight: 700;
  // Plum rather than primary-ink: this link sits on the mint banner, where
  // primary-ink measures 4.09:1 - just under the 4.5 that 12px/700 needs. Measured,
  // and the shortfall is the kind that eyeballing would never catch.
  color: var(--color-ink);
  text-decoration: underline;
  text-underline-offset: 2px;
}

.promo-link:focus-visible {
  outline: 2px solid var(--color-primary-ink);
  outline-offset: 2px;
  border-radius: var(--radius-xs);
}

.promo-sub {
  font-size: 12px;
  opacity: 0.9;
  line-height: 1.35;
}

.promo-banner {
  display: flex;
  align-items: center;
  gap: 10px;
  /* Blush, not mint. Measured on all three text roles the banner carries, since a
     background swap is invisible to the palette gate until the numbers are run:

       plum 14px/800 title          7.00:1  (mint was 7.41)
       plum 12px at 0.9 opacity     5.63:1  (mint was 6.10)
       --color-primary-ink border   3.87:1  (mint was 4.09; 1.4.11 owes 3.0)
       blush against the cream page 1.76:1  (mint was 1.67)

     --tile-blush was the other candidate and is NOT used: at 1.12:1 against the
     cream page the banner dissolves into the background, which is an invisible
     control rather than an unreadable one.

     The dashed --color-primary-ink edge is deliberately left blue. It passes at
     3.87:1, and --color-blush-ink would also pass (3.37:1) if the warm edge is
     preferred — but that is a visible change and not the one that was asked for.

     MEASURED-BY-HAND WARNING: `.promo-sub` uses `opacity: 0.9`, so the figure
     above is the composited colour, not plum at full strength. check-contrast.mjs
     cannot see it — it reads a hardcoded solid-pair table, and the opacity lives
     in this stylesheet. Re-run the composition by hand after any change to
     either the background or that opacity; nothing in the gate will fail. */
  background: var(--color-brand-blush);
  margin: 10px 12px 0;
  padding: 12px 16px;
  border-radius: 12px;
  font-size: 14px;
  color: var(--color-ink);
  font-weight: 600;
  cursor: pointer;
  border: 1.5px dashed var(--color-primary-ink);
  app-icon {
    font-size: 20px;
  }
}

/* The admin-written announcement. Same tinted card language as the notification
   strip below it so the two do not read as unrelated, but a SOLID edge rather
   than the dashed one, which the notification toggle uses to say "this is a
   setting you can change" as opposed to "this is news". */
.announce-banner {
  display: flex;
  align-items: center;
  gap: 10px;
  background: var(--tile-lemon);
  margin: 10px 12px 0;
  padding: 12px 16px;
  border-radius: 12px;
  border: 1.5px solid var(--color-brand-accent);
  app-icon {
    font-size: 20px;
    color: var(--color-sunny-ink);
    flex: 0 0 auto;
  }
}
.announce-banner .promo-title {
  color: var(--color-sunny-ink);
}
.announce-banner .promo-sub {
  color: var(--color-ink-soft);
  font-weight: 500;
}

// ── Section Headers ──────────────────────────────────────
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 16px 4px;
}
.section-title {
  font-size: 18px;
  font-weight: 700;
  margin: 0;
  color: var(--ion-color-dark);
}
.alert-title {
  color: var(--color-warning);
}
.see-all-btn {
  // primary-ink, not the brand hue: 6.82:1 on this cream ground against 1.71:1.
  --color: var(--color-primary-ink);
  font-weight: 600;
  font-size: 13px;
}

// ── Recent Orders (Customer) ──────────────────────────────
.recent-orders {
  padding: 4px 12px 24px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.recent-order-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 12px;
  padding: 12px 14px;
  box-shadow: var(--shadow-card);
  cursor: pointer;
  gap: 8px;
}
.recent-order-info {
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.recent-order-id {
  font-size: 14px;
  font-weight: 700;
  font-family: monospace;
  color: var(--ion-color-dark);
}
.recent-order-date {
  font-size: 12px;
  color: var(--ion-color-medium);
}

// ── Admin Welcome ─────────────────────────────────────────
.admin-welcome {
  padding: 16px 16px 0;
}
.admin-title {
  font-size: 24px;
  font-weight: 800;
  margin: 0 0 4px;
  color: var(--ion-color-dark);
}
.admin-sub {
  font-size: 14px;
  color: var(--ion-color-medium);
  margin: 0;
}

// ── KPI Cards ─────────────────────────────────────────────
/* Centred throughout. The icon used to be a bare glyph pinned to the top-left of
   a left-aligned column, which made the four tiles read as four different
   little lists rather than one set of comparable figures. Centring the badge,
   the label and the number together is what makes a 2x2 grid scannable — you
   compare the numbers, and they are all in the same place. */
.kpi-card {
  border-radius: var(--radius-md);
  padding: var(--space-4) var(--space-3);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 4px;
  min-height: 108px;
}

/* Pastel tile + dark ink, per the "soft pastel accents only" rule. These were
   four saturated ramps (deep green, burnt orange, deep red, ink-blue) behind
   white text. Each pair is an existing `--tone-*` triple whose ink is already
   contrast-verified: 6.35:1, 6.29:1, 7.42:1 and 8.61:1. The ink is carried on
   each tile because each pastel needs its own. */
.kpi-revenue {
  background: var(--tone-success-bg);
  --kpi-ink: var(--tone-success-ink);
}
.kpi-pending {
  background: var(--tone-warning-bg);
  --kpi-ink: var(--tone-warning-ink);
}
.kpi-lowstock {
  background: var(--tone-danger-bg);
  --kpi-ink: var(--tone-danger-ink);
}
.kpi-total {
  background: var(--tone-info-bg);
  --kpi-ink: var(--tone-info-ink);
}

.kpi-skeleton {
  border-radius: var(--radius-md);
  overflow: hidden;
  margin: 0;
}

/* A translucent disc behind the glyph. Without it the icon floats on the
   gradient with nothing to align it, which is why it read as an afterthought
   next to the label. */
/* A translucent disc behind the glyph. Without it the icon floats on the
   gradient with nothing to align it, which is why it read as an afterthought
   next to the label. The disc is now WHITE-on-pastel rather than white-on-dark:
   at 0.18 it was nearly invisible over a pale tile, so it is a solid white
   with the tile's ink showing through as the glyph. */
.kpi-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38px;
  height: 38px;
  border-radius: 50%;
  background: var(--color-white);
  margin-bottom: 2px;
}

.kpi-icon {
  --icon-size: 20px;
  color: var(--kpi-ink);
}
.kpi-label {
  font-size: 11px;
  color: var(--kpi-ink);
  opacity: 0.85;
  font-weight: 600;
  margin: 0;
  /* Two lines allowed so "Today's Revenue" and "Pending Orders" occupy the same
     height — an uneven label baseline between adjacent tiles is very visible in
     a 2x2 grid. */
  line-height: 1.3;
  min-height: 2.6em;
  display: flex;
  align-items: center;
}
/* The tile's own ink, not white: these tiles are now pastel surfaces, and
   white on `--tone-success-bg` would have measured well under 4.5:1. Each
   `--kpi-ink` clears it (6.35 / 6.29 / 7.42 / 8.61). */
.kpi-value {
  font-family: var(--font-display);
  font-size: 24px;
  font-weight: 700;
  color: var(--kpi-ink);
  margin: 0;
  font-variant-numeric: tabular-nums;
}

// ── Admin action tiles ────────────────────────────────────
/* Right-aligned, under the toolbar. These are navigation, not content: two
   compact tiles in the top-right corner rather than two full-width buttons
   wedged between the metrics and the content, which is where a person does not
   look for a way to leave the page they are on. */
.admin-actions {
  display: flex;
  justify-content: flex-end;
  gap: var(--space-2);
  padding: 0 12px 4px;
}

.action-tile {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  width: 84px;
  padding: 10px 6px;
  background: var(--color-white);
  border: 1px solid var(--ion-color-light-shade);
  border-radius: var(--radius-sm);
  box-shadow: var(--shadow-card);
  text-decoration: none;
  transition:
    transform 0.15s ease,
    border-color 0.15s ease;
}

.action-tile:hover {
  transform: translateY(-2px);
  border-color: var(--color-primary-ink);
}

.action-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  border-radius: var(--radius-xs);
  background: var(--tile-powder);
}

.action-icon app-icon {
  --icon-size: 17px;
  color: var(--color-primary-ink);
}

.action-label {
  font-size: 11px;
  font-weight: 700;
  color: var(--color-ink-soft);
  text-align: center;
  line-height: 1.2;
}

// ── Low Stock panel ──────────────────────────────────────
/* A single tinted container rather than a heading followed by a stack of loose
   rows. This is the one thing on the dashboard that needs acting on, so it gets
   a surface of its own instead of blending into the page. */
.low-stock-panel {
  margin: var(--space-3) 12px 0;
  background: var(--tone-warning-bg);
  /* 2px, not 1px — a thin border on an 18px curve breaks up as it rasterises.
     See .danger-group in profile.page.scss for the full explanation. Amber on
     cream is visible enough for that to show. */
  border: 2px solid var(--tone-warning-border);
  border-radius: var(--radius-md);
  overflow: hidden;
}

.low-stock-head {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-3) var(--space-3) var(--space-2);
}

.low-stock-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  flex: 0 0 auto;
  border-radius: 50%;
  background: rgb(255 255 255 / 0.7);
}

.low-stock-badge app-icon {
  --icon-size: 17px;
  color: var(--tone-warning-ink);
}

.low-stock-head-text {
  min-width: 0;
}

.low-stock-title {
  margin: 0;
  font-family: var(--font-display);
  font-size: 15px;
  font-weight: 600;
  color: var(--tone-warning-ink);
}

.low-stock-count {
  margin: 1px 0 0;
  font-size: 12px;
  color: var(--tone-warning-ink);
  opacity: 0.85;
}

.low-stock-list {
  list-style: none;
  margin: 0;
  padding: 0 var(--space-3) var(--space-2);
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.low-stock-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--color-white);
  border-radius: var(--radius-sm);
  padding: 9px 11px;
  gap: var(--space-2);
}

.low-stock-info {
  display: flex;
  flex-direction: column;
  gap: 1px;
  min-width: 0;
}
.low-stock-name {
  font-size: 13px;
  font-weight: 700;
  margin: 0;
  color: var(--color-ink);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.low-stock-set {
  font-size: 11px;
  color: var(--ion-color-medium);
  margin: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.low-stock-levels {
  display: flex;
  gap: 4px;
  flex-wrap: wrap;
  justify-content: flex-end;
}
.stock-chip-sm {
  font-size: 11px;
  height: 22px;
  margin: 0;
}

.low-stock-cta {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
  padding: 9px;
  background: var(--tone-warning-ink);
  color: var(--color-white);
  font-size: 13px;
  font-weight: 700;
  text-decoration: none;
}
.low-stock-cta app-icon {
  --icon-size: 14px;
}

// ── Admin Orders List ─────────────────────────────────────
.admin-orders-list {
  padding: 0 12px 8px;
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.admin-order-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--color-white);
  border-radius: var(--radius-sm);
  padding: 12px 14px;
  box-shadow: var(--shadow-card);
  cursor: pointer;
  gap: 8px;
}
.admin-order-left {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}
.admin-order-id {
  font-size: 13px;
  font-weight: 700;
  font-family: var(--font-mono);
  color: var(--color-ink);
}
.admin-order-email {
  font-size: 12px;
  color: var(--ion-color-medium);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.admin-order-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4px;
  flex: 0 0 auto;
}
.admin-order-total {
  font-size: 14px;
  font-weight: 700;
  color: var(--color-primary-ink);
  font-variant-numeric: tabular-nums;
}

.skeleton-card {
  border-radius: var(--radius-md);
  overflow: hidden;
  margin: 0;
}
</file>

