// src/app/app.component.scss
// Five-orites Scoop — App Shell Styles

:host {
  display: block;
}

// ── Menu Header / Branding ─────────────────────────────
.menu-header {
  background: var(--gradient-brand);
  padding: 40px 20px 24px;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
}

.menu-logo-wrap {
  width: 72px;
  height: 72px;
  /* 50%, not 20px. The logo art is a circle (transparent corners), so a
     rounded-square plate left the corners of the plate showing around it. */
  border-radius: 50%;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8px;
  border: 2px solid rgba(255, 255, 255, 0.3);
}

.menu-logo {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Plum, not white. The menu header sits on a light-to-light pastel gradient
   (--gradient-brand), where white measures 1.79:1. The translucent white
   decorations below it are fine — a logo plate and a hairline ring do not carry
   text. */
.menu-brand {
  /* Plum, not white — see the note above the block. Kept explicit rather than
     inherited: the value happens to match what <html> resolves to today, but
     this is the string that has to stay readable on the gradient, and the
     1.79:1 measurement it was chosen against is a property of THIS rule. */
  color: var(--color-ink);

  /* Fourth retro string, and the one that was least suited to it at its old
     size: this was 18px, where the shadow computes to 0.06 * 18 = 1.08px —
     too tight to read as a decal and more like a smudge behind the letters.
     24px puts the offset at 1.44px, which is where the effect actually reads.

     font-family has to be stated because this is an <h1> and was inheriting
     Fredoka from the bare `h1` rule in variables.scss.

     FIXED SIZE, NOT A clamp, and that is the point. .menu-header lives inside
     ion-menu, which is a fixed-width overlay (~280px, and nothing in this app
     overrides it), so its content box is 240px. A vw() term here measures the
     VIEWPORT, not the drawer, so a clamp would silently render the drawer
     title at 28px on a desktop and 22px on a phone — two different brand marks
     for the same string, in a container whose width never varies.

     24px was chosen from the 240px budget, not by eye: at 28px the string
     measures exactly 240px and fills the box to the pixel, so it wraps at the
     space in "Five-orites Scoop" the moment the name or the font changes by a
     hair. At 24px it measures ~206px, leaving ~34px of slack. Verified by
     measuring scrollWidth inside a real 280px drawer. */
  font-family: var(--font-display-retro);
  font-weight: 700;
  font-size: 24px;
  line-height: 1.1;
  letter-spacing: -0.3px;

  /* --space-3, matching the two hero strings rather than the --space-2 first
     written here. An earlier note on this rule claimed `margin: 0` meant "no gap
     at all" before .menu-tagline; that was wrong — .menu-header is a flex
     column with gap: 6px (see above), so the real prior clearance was 6px. The
     correction matters because the invariant to preserve is the TOTAL gap, not
     this one declaration: 12px margin + 6px flex gap = 18px against a 1.44px
     shadow. */
  margin: 0 0 var(--space-3);
  text-shadow: var(--display-sticker-shadow);
}

.menu-tagline {
  color: var(--color-ink-soft);
  font-size: 12px;
  margin: 0;
  font-weight: 600;
}

// ── Nav List ───────────────────────────────────────────
.menu-content {
  --background: #ffffff;
  display: flex;
  flex-direction: column;
}

.nav-list {
  padding: 12px 8px;

  &.admin-nav {
    border-top: 1px solid var(--ion-color-light-shade);
    margin-top: 8px;
  }
}

.nav-section-label {
  font-size: 11px;
  font-weight: 600;
  color: var(--ion-color-medium);
  letter-spacing: 0.8px;
  text-transform: uppercase;
  padding-left: 16px;
  padding-bottom: 4px;

  &.admin-label {
    // Measured 1.71:1 on the drawer cream, and only once the drawer was actually
    // OPENED - a closed drawer renders nothing, so no audit of a default page view
    // could see it. This is the heading that separates the customer menu from the
    // admin one, so it is the last thing that should be hard to find.
    color: var(--color-primary-ink);
  }
}

.nav-item {
  --border-radius: 12px;
  --padding-start: 14px;
  --padding-end: 14px;
  --min-height: 48px;
  --color: var(--ion-color-dark);
  /* Ring colour for .cart-badge — swapped on the active row so the bubble keeps
     a clean edge against the tinted background instead of showing a white halo. */
  --cart-badge-ring: var(--ion-item-background, var(--ion-background-color, #fff));
  border-radius: 12px;
  margin-bottom: 2px;
  transition: background 0.15s ease;

  /* The nav labels are DELIBERATELY not part of the retro treatment.

     This was tried at 18px Lobster Two with the gold shadow on the active row and
     then reverted. The reason it could not stay is not aesthetic:

       - the active row is distinguished from the idle rows by font-weight: 600
         against a lighter inherited weight. Lobster Two ships only 700, so every
         retro row had to be 700, and the active state lost its only weight cue.
         A single-weight face cannot express a weight-based active state.
       - the idle rows sit on WHITE, where the gold decal measures 1.58:1 — too
         faint to read as intentional and more like a rendering artefact.

     Font size and family are therefore left to inherit from the body face, and
     `font-weight: 600` on the active row below is restored exactly as it was.
     Note that .menu-brand, the drawer's own header title, IS retro — this revert
     covers the navigation rows only. */

  &.active-nav-item {
    // PLUM, not the brand hue. This row was powder (#8ECAE6) on mint (#5FD9B4),
    // which measures 1.03:1 — the label and its own background sat at the same
    // lightness, so the ACTIVE page was the one row in the drawer you could not
    // read. Measured off the live DOM, not eyeballed.
    //
    // The fill moved from full-strength mint to a deep powder (--nav-active,
    // #cfe4f2) because the idle rows are transparent over ion-menu's WHITE
    // surface, so the selected fill is judged against white rather than against
    // the cream page. Mint cleared that at 1.74:1; the obvious replacement,
    // --tile-powder, would have measured 1.15:1 and left the row looking
    // unselected. Plum on the new fill is 9.84:1, up from 7.41:1.
    //
    // --cart-badge-ring moves with it, or the count bubble would keep a mint
    // halo on a powder row.
    --background: var(--nav-active);
    --color: var(--color-ink);
    --cart-badge-ring: var(--nav-active);
    font-weight: 600;

    .nav-icon {
      // The icon carries the same label, so it takes the same ink. Powder on mint
      // is 1.03:1 for the glyph too, and a 1:1 glyph is not an affordance.
      color: var(--color-ink);
    }
  }
}

/* Positioning context for the count bubble. The wrapper rather than the ion-icon
   itself because the bubble has to be able to hang outside the glyph box, and
   ion-icon is sized 1em — a box exactly the size of the glyph, leaving nothing
   to overhang into.

   ion-item's ::slotted([slot=start]) rules (margin-inline-end: 32px) still apply
   to this element, so the gap between icon and label is unchanged. The rules
   that targeted a bare ::slotted(ion-icon) no longer match — 12px block margins
   and 1.5em — but at 20px in a 48px row neither was doing any work: the row's
   min-height already wins, and .nav-icon restates the font size. */
.nav-icon-wrap {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.nav-icon {
  --icon-size: 20px;
  color: var(--ion-color-medium);
  transition: color 0.15s ease;
}

.admin-nav-icon {
  // Measured 1.71:1 as a glyph on the drawer cream, and the 0.7 opacity made the
  // painted result dimmer still. An icon owes 3:1 under WCAG 1.4.11 and primary-ink is
  // 6.82:1, so the de-emphasis is now carried by the opacity alone - which is what it
  // was there for in the first place.
  color: var(--color-primary-ink);
  opacity: 0.7;
}

/* A plain span, deliberately not <ion-badge> — same reasoning as the toolbar
   cart button: ion-badge's :host pins its own display/font-size/padding and
   carries contain:content, so a bubble that has to overlap a glyph is far
   easier to control with a span.

   Offsets are relative to the 20px icon box and put the bubble's own centre
   almost exactly on the cart's top-right corner, with a couple of pixels of
   overhang so it reads as *on* the icon rather than tucked beside it. Both
   values stay inside ion-item's overflow:hidden — the row is 48px tall and
   vertically centres the icon, which leaves ~14px of headroom above it. */
.cart-badge {
  position: absolute;
  top: -7px;
  right: -6px;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-width: 18px;
  height: 18px;
  padding: 0 4px;
  font-size: 11px;
  font-weight: 700;
  line-height: 1;
  /* ion-item applies letter-spacing: 0.033em to slotted content. That trailing
     track lands after the glyph, so the flex-centred text sits a couple of
     pixels left of the bubble's true middle — zeroing it is what centres it. */
  letter-spacing: 0;
  color: var(--ion-color-danger-contrast, #fff);
  background: var(--ion-color-danger, #c62828);
  border-radius: 999px;
  /* Ring in the row's own background so the bubble reads as sitting on top of
     the cart stroke instead of merging into it. */
  box-shadow: 0 0 0 2px var(--cart-badge-ring);
  /* Decoration on top of the row — the whole item stays one tap target. */
  pointer-events: none;
}

// ── Spacer ─────────────────────────────────────────────
.menu-spacer {
  flex: 1;
  min-height: 20px;
}

// ── User Panel ─────────────────────────────────────────
.user-panel {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 16px;
  border-top: 1px solid var(--ion-color-light-shade);
  background: var(--ion-color-light);
  border-radius: 16px;
  margin: 8px;
}

.user-info {
  display: flex;
  align-items: center;
  gap: 10px;
  flex: 1;
  min-width: 0;
}

/* The identity block is a link to My Profile. No chevron: the avatar already says
   "me", and the drawer has a nav row that a second affordance would only echo.
   Same tokens as the nav rows and the other hover rows, so it stays on-palette. */
.user-link {
  color: inherit;
  text-decoration: none;
  border-radius: var(--radius-xs);
  cursor: pointer;
}
.user-link:hover,
.user-link:active {
  background: var(--tile-powder);
}
.user-link.active-user-link {
  background: var(--color-brand-light);
}

.user-avatar {
  width: 40px;
  height: 40px;
  flex-shrink: 0;
  background: var(--color-brand-primary);
  border-radius: 50%;
}

.avatar-initials {
  width: 40px;
  height: 40px;
  background: var(--color-brand-primary);
  /* Plum on the powder fill: 7.20:1, where white would be 1.79:1. */
  color: var(--color-ink);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  font-weight: 700;
  border-radius: 50%;
}

.user-meta {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.user-name {
  font-size: 14px;
  font-weight: 600;
  color: var(--ion-color-dark);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.user-email {
  font-size: 11px;
  color: var(--ion-color-medium);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.logout-btn {
  --color: var(--ion-color-medium);
  --padding-start: 8px;
  --padding-end: 8px;
  flex-shrink: 0;
}

.guest-panel {
  padding: 12px 16px 16px;
  border-top: 1px solid var(--ion-color-light-shade);
}

.sign-in-btn {
  --background: var(--color-brand-primary);
  /* Plum, not white. This was white on the brand hue, which measured 2.72:1
     against the old saturated pink and 1.79:1 against the new pastel. */
  --color: var(--color-ink);
  --border-radius: 12px;
  font-weight: 600;
}
</file>

