<file path="src/app/shared/components/product-card/product-card.component.scss">
// src/app/shared/components/product-card/product-card.component.scss

:host {
  display: block;
}

.product-card {
  border-radius: 16px;
  box-shadow: var(--shadow-card);
  margin: 0;
  overflow: hidden;
  cursor: pointer;
  transition:
    transform 0.15s ease,
    box-shadow 0.15s ease;

  &:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-raised);
  }
}

// ── Image ──────────────────────────────────────────────
.card-image-wrap {
  position: relative;
  width: 100%;
  padding-top: 66%;
  background: var(--color-brand-light);
  overflow: hidden;
}

.image-skeleton {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.card-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0;
  transition: opacity 0.3s ease;

  &.image-visible {
    opacity: 1;
  }
}

.set-badge {
  position: absolute;
  top: 10px;
  left: 10px;
  background: var(--color-brand-primary);
  /* Plum on the powder fill: 7.20:1, where white was 1.79:1. This badge sits on
     top of a photograph, so it also has a subtle shadow for separation. */
  color: var(--color-ink);
  font-size: 11px;
  font-weight: 600;
  padding: 3px 10px;
  border-radius: 20px;
  letter-spacing: 0.2px;
}

.wishlist-btn {
  position: absolute;
  top: 6px;
  right: 6px;
  /* Was 34px. Still above the WCAG 2.2 AA floor of 24px, but well short of the
     44px enhanced target, and this is a small floating control that people tap
     one-handed on a phone. 40px is proportionate for a card overlay while being
     a meaningfully easier target. */
  width: 40px;
  height: 40px;
  border-radius: 50%;
  border: none;
  background: rgba(255, 255, 255, 0.92);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  color: var(--ion-color-medium);
}

/* Lucide ships a single outline heart. The "saved" state is that same glyph with
   `fill: currentColor`, which inherits the danger colour — so the two ionicons
   states collapse into one icon plus one class. */
.wishlist-icon {
  --icon-size: 20px;
  transition: color 0.15s ease;
}
.wishlist-icon.wished {
  color: var(--ion-color-danger);
}
.wishlist-icon.wished svg {
  fill: currentColor;
}

// ── Card Body ──────────────────────────────────────────
.card-body {
  padding: 12px 14px 14px;
}

.variety-name {
  font-size: 15px;
  font-weight: 700;
  color: var(--ion-color-dark);
  margin: 0 0 10px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

// ── Size Segment ───────────────────────────────────────
.size-segment {
  --background: var(--ion-color-light);
  border-radius: 8px;
  margin-bottom: 10px;
  overflow: hidden;
}

.size-btn {
  --padding-top: 4px;
  --padding-bottom: 4px;
  font-size: 11px;
  // The INDICATOR keeps the brand hue - it is a background, which is what brand
  // hues are for. The LABEL takes ink: checked text measured 1.00:1 on the powder
  // indicator, i.e. invisible. The global rule in global.scss sets this too, but it
  // is repeated here because this block overrides --color-checked locally and would
  // otherwise keep the old value.
  --color-checked: var(--color-ink);
  --indicator-color: var(--color-brand-primary);
}

// ── Price + Stock ──────────────────────────────────────
.price-stock-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10px;
}

.price {
  font-size: 18px;
  font-weight: 700;
  // 18px/700 is NOT WCAG large text - that needs 24px, or 18.66px at weight 700+ -
  // so this owes the full 4.5:1, and the brand hue only offers 1.71:1 on cream.
  color: var(--color-primary-ink);
}

.stock-chip {
  font-size: 11px;
  height: 24px;
  margin: 0;
  /* Both halves declared. Ion-chip paints its label colour from its own defaults
     (rgba(0,0,0,0.87)) unless told otherwise, which on a tinted pill is what produced
     the black-on-black reading. */
  --color: var(--color-ink);

  ion-label {
    color: var(--color-ink);
  }
}

/* Tone pairs for the stock chip. These classes are applied by an [ngClass] ternary in
   the template, so a rule that is missing here shows up as a chip with no background
   at all rather than as a compile error - which is exactly how the first attempt went
   unnoticed. Ink on each of these tints is asserted in check-contrast.mjs. */
.stock-chip-ok {
  background: var(--tone-success-bg);
  border: 1px solid var(--tone-success-border);
}

.stock-chip-low {
  background: var(--tone-warning-bg);
  border: 1px solid var(--tone-warning-border);
}

.stock-chip-out {
  background: var(--tone-danger-bg);
  border: 1px solid var(--tone-danger-border);
}

// ── Add to Cart ────────────────────────────────────────
/* Plum, not white: white on the sunny accent measures 1.58:1. This button is on
   every product card, so it is the most-repeated contrast decision in the app. */
.add-to-cart-btn {
  --background: var(--color-brand-accent);
  --color: var(--color-ink);
  --border-radius: 10px;
  --padding-top: 10px;
  --padding-bottom: 10px;
  font-weight: 600;
  font-size: 14px;
  margin: 0;
}
</file>

