// src/app/admin/tracking/admin-tracking.page.scss
// Five-orites Scoop — Admin Delivery Map

/* ── Split: map left, controls right ─────────────────────────
   The map and the search panel are used together — you look at where the
   orders are and then find them in a list. Stacked vertically they were never
   on screen at the same time, so the map and the list were two separate tasks
   rather than one. Side by side from tablet up, stacked on a phone where there
   is no width to spare. */
.track-split {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-3);
  padding: var(--space-3) var(--space-4) 0;
}

@media (min-width: 900px) {
  .track-split {
    grid-template-columns: minmax(0, 1fr) minmax(300px, 380px);
    align-items: start;
  }
}

.map-col {
  min-width: 0;
}

.map-caption {
  display: flex;
  align-items: flex-start;
  gap: 6px;
  margin: var(--space-2) 0 0;
  font-size: 12px;
  line-height: 1.45;
  color: var(--ion-color-medium);
}

.map-caption app-icon {
  --icon-size: 14px;
  flex: 0 0 auto;
  margin-top: 1px;
  color: var(--color-primary-ink);
}

.panel-col {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

// ── Search & filters ──────────────────────────────────────
.search-panel {
  background: var(--color-white);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
  padding: var(--space-3);
}

.track-search {
  --border-radius: var(--radius-sm);
  --background: var(--ion-color-light);
  padding: 0;
  margin-bottom: var(--space-2);
}

.status-chips {
  display: flex;
  gap: 5px;
  flex-wrap: wrap;
}

/* Real <button>s rather than ion-chips: these are a radio group (exactly one
   status is active at a time), and a group of independently-toggleable chips
   implies several can be selected, which they cannot. */
.status-chip {
  padding: 6px 12px;
  border: 1px solid var(--ion-color-light-shade);
  border-radius: var(--radius-pill);
  background: var(--color-white);
  color: var(--color-ink-soft);
  font: inherit;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
  transition:
    background-color 0.15s ease,
    border-color 0.15s ease;
}

.status-chip.is-on {
  background: var(--color-brand-primary);
  /* An ink border, not a pastel one: on a white chip the pastel measures 1.79:1
     and the selected state would be invisible. */
  border-color: var(--color-primary-ink);
  color: var(--color-ink);
}

.status-chip:hover:not(.is-on) {
  background: var(--tile-powder);
}

.result-count {
  margin: var(--space-2) 0 0;
  font-size: 12px;
  font-weight: 600;
  color: var(--ion-color-medium);
}

.clear-btn {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  margin-top: var(--space-2);
  padding: 0;
  background: none;
  border: 0;
  font: inherit;
  font-size: 12px;
  font-weight: 700;
  color: var(--color-primary-ink);
  cursor: pointer;
}
.clear-btn app-icon {
  --icon-size: 13px;
}

// ── Selected order ────────────────────────────────────────
.selected-card {
  background: var(--tile-powder);
  border: 2px solid var(--color-primary-ink);
  border-radius: var(--radius-md);
  padding: var(--space-3);
}

.selected-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-2);
}

.selected-head > div {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  flex-wrap: wrap;
  min-width: 0;
}

.selected-id {
  font-family: var(--font-mono);
  font-size: 15px;
  font-weight: 700;
  color: var(--color-ink);
}

.selected-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 26px;
  height: 26px;
  flex: 0 0 auto;
  padding: 0;
  border: 1px solid var(--ion-color-light-shade);
  border-radius: var(--radius-xs);
  background: var(--color-white);
  color: var(--ion-color-medium);
  cursor: pointer;
}
.selected-close app-icon {
  --icon-size: 14px;
}

.selected-address {
  margin: var(--space-2) 0 0;
  font-size: 14px;
  line-height: 1.4;
  color: var(--color-ink);
}

.selected-meta {
  margin: 4px 0 0;
  font-size: 12px;
  color: var(--ion-color-medium);
}

.advance-btn {
  --background: var(--color-brand-primary);
  --color: var(--color-ink);
  --border-radius: var(--radius-sm);
  font-weight: 700;
  margin-top: var(--space-3);
  min-height: 44px;
}

// ── Table ─────────────────────────────────────────────────
.table-wrap {
  padding: var(--space-4) var(--space-4) 0;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.track-table {
  width: 100%;
  min-width: 540px;
  border-collapse: separate;
  border-spacing: 0;
  background: var(--color-white);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
  overflow: hidden;
}

.track-table thead th {
  position: sticky;
  top: 0;
  z-index: 1;
  background: var(--ion-color-light);
  padding: 10px 12px;
  text-align: left;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.4px;
  text-transform: uppercase;
  color: var(--ion-color-medium);
  white-space: nowrap;
  border-bottom: 1px solid var(--ion-color-light-shade);
}

.track-table tbody td {
  padding: 10px 12px;
  border-bottom: 1px solid var(--ion-color-light);
  vertical-align: middle;
}

.track-table tbody tr:last-child td {
  border-bottom: none;
}

.track-row:hover {
  background: var(--tile-powder);
}
.track-row.is-selected {
  background: var(--tile-powder);
}

.num {
  text-align: right;
  width: 1%;
  white-space: nowrap;
}

.action-cell {
  text-align: right;
  width: 1%;
  white-space: nowrap;
}

/* Select. The row itself has no click handler at all, so this button is the
   only way to select — which is what stops a tap on "Advance" from also
   selecting the row and re-rendering the panel above. */
.pick-btn {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 0;
  background: none;
  border: 0;
  font: inherit;
  text-align: left;
  cursor: pointer;
  color: inherit;
}

.pick-icon {
  --icon-size: 15px;
  flex: 0 0 auto;
  color: var(--color-primary-ink);
}

.pick-text {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.row-id {
  font-family: var(--font-mono);
  font-size: 13px;
  font-weight: 700;
  color: var(--color-ink);
}

.row-email {
  font-size: 11px;
  color: var(--ion-color-medium);
  max-width: 22ch;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-address {
  display: block;
  font-size: 13px;
  color: var(--color-ink-soft);
  max-width: 32ch;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-distance {
  display: block;
  font-size: 11px;
  color: var(--ion-color-medium);
  margin-top: 1px;
}

.row-items {
  font-size: 13px;
  font-weight: 700;
  color: var(--color-ink);
  font-variant-numeric: tabular-nums;
}

.row-value {
  font-size: 13px;
  font-weight: 700;
  color: var(--color-primary-ink);
  font-variant-numeric: tabular-nums;
}

.row-advance {
  --border-radius: var(--radius-pill);
  --border-color: var(--color-primary-ink);
  --color: var(--color-primary-ink);
  font-size: 12px;
  font-weight: 700;
  min-height: 32px;
}

// ── Skeleton ─────────────────────────────────────────────
.skeleton-row {
  display: grid;
  grid-template-columns: 26% 1fr 12% 18%;
  gap: 12px;
  align-items: center;
  padding: 12px;
  background: var(--color-white);
  border-bottom: 1px solid var(--ion-color-light);
}
.skeleton-row:first-child {
  border-radius: var(--radius-md) var(--radius-md) 0 0;
}
.skeleton-row:last-child {
  border-bottom: none;
  border-radius: 0 0 var(--radius-md) var(--radius-md);
}

// ── Unmapped orders ───────────────────────────────────────
.unmapped {
  margin: var(--space-5) var(--space-4) var(--space-6);
  padding: var(--space-3);
  background: var(--tone-warning-bg);
  /* 2px, not 1px — a thin border on an 18px curve breaks up as it rasterises.
     See .danger-group in profile.page.scss for the full explanation. Same amber
     tone as .low-stock-panel on the Dashboard, so both are on the same footing. */
  border: 2px solid var(--tone-warning-border);
  border-radius: var(--radius-md);
}

.unmapped-title {
  display: flex;
  align-items: center;
  gap: 6px;
  margin: 0;
  font-family: var(--font-display);
  font-size: 14px;
  font-weight: 600;
  color: var(--tone-warning-ink);
}
.unmapped-title app-icon {
  --icon-size: 15px;
}

.unmapped-note {
  margin: 5px 0 var(--space-2);
  font-size: 12px;
  line-height: 1.45;
  color: var(--tone-warning-ink);
  opacity: 0.9;
}

.unmapped-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.unmapped-item {
  display: flex;
  gap: var(--space-2);
  align-items: baseline;
  background: var(--color-white);
  border-radius: var(--radius-xs);
  padding: 7px 10px;
}

.unmapped-id {
  font-family: var(--font-mono);
  font-size: 12px;
  font-weight: 700;
  color: var(--color-ink);
  flex: 0 0 auto;
}

.unmapped-address {
  font-size: 12px;
  color: var(--ion-color-medium);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

// Available to assistive tech, invisible on screen.
.visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0 0 0 0);
  white-space: nowrap;
  border: 0;
}
</file>

