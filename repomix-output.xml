// src/app/features/about/about.page.scss
// Sizes icons via --icon-size: app-icon is inline SVG, not a font glyph.

// ── Hero ────────────────────────────────────────────────
.about-hero {
  position: relative;
  padding: var(--space-7) var(--space-5) var(--space-6);
  text-align: center;
  /* Ice cream photo under a heavy white scrim.

     The 70% is not a taste call, it is the WCAG floor for .hero-tagline. This
     photo runs from pure black to blown white inside the cropped band, and the
     tagline sits at opacity 0.85, so contrast is driven by the darkest pixel:

       50% scrim -> 2.75:1 FAIL    60% -> 3.62:1 FAIL
       65%       -> 4.10:1 FAIL    70% -> 4.61:1 PASS  <- this

     Measured at 390/768/1280/1600/1920 wide. cover crops differently at each,
     but the darkest pixel lands at 178-179 at every one, so 4.61:1 is the real
     figure and it clears AA by only 0.11. Do not lighten this without
     re-measuring. check:contrast cannot help here: it reads a hardcoded palette
     table and never looks at the stylesheets.

     Flat 70%, not an angle, so the guarantee above holds everywhere. The old
     gradient was angled to favour the logo; the photo supplies its own depth.

     Order matters twice over: the gradient is listed FIRST so it paints on top
     of the url (reversed, the photo hides it), and background-color sits under
     both so a failed image load degrades to the old flat teal, not to white. */
  background-color: var(--color-brand-primary);
  background-image:
    linear-gradient(rgb(255 255 255 / 70%), rgb(255 255 255 / 70%)),
    url('/assets/images/hero-ice-cream.jpg');
  background-size: cover;
  background-position: center;
}

.hero-logo-wrap {
  width: 88px;
  height: 88px;
  margin: 0 auto var(--space-3);
  /* 50%, not 26px - see .menu-logo-wrap. The logo is smaller than this wrap,
     so unlike the other three the plate is visible as a ring around it. */
  border-radius: 50%;
  background: rgb(255 255 255 / 0.22);
  border: 2px solid rgb(255 255 255 / 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-logo {
  width: 62px;
  height: 62px;
  // The art is a circle on a transparent square, so cover is a no-op here.
  // Kept so a future non-square logo cannot squash.
  object-fit: cover;
}

.hero-title {
  /* The one place the retro script is used at full size. See
     --font-display-retro for why this is a separate token and why it is not
     applied to any other heading on the page. */
  font-family: var(--font-display-retro);
  font-weight: 700;
  color: var(--color-ink);

  /* The 28px FLOOR is a deliberate guess, not a measurement: Lobster Two Bold
     sets noticeably wider than Fredoka, and this string is 17 characters on a
     320px phone where the hero's content box is only 272px wide (320 less the
     --space-5 gutters either side). If it wraps, drop this floor — do not
     shrink the clamp's maximum, or it stops being a display line. Verified
     visually at 320/768/1920 rather than assumed. */
  font-size: clamp(1.75rem, 5.2vw, 2.25rem); /* 28px - 36px */
  letter-spacing: -0.5px;

  /* 1.05, not the inherited 1.2. Lobster Two's ascenders and descenders are
     tall, so normal leading leaves visible slack above and below the glyphs
     and the block reads loose. */
  line-height: 1.05;

  /* The bottom margin is load-bearing and was NOT zero by accident being
     fixed. The shadow points DOWN by 0.06em — 1.7px at 28px, 2.2px at 36px —
     and the tagline sits below with only --space-1 (4px) between them, so the
     shadow was landing on it. --space-3 leaves ~10px of clean gradient between
     the text and its own shadow at any size in the clamp. */
  margin: 0 0 var(--space-3);
  text-shadow: var(--display-sticker-shadow);
}

.hero-tagline {
  font-size: 15px;
  color: var(--color-ink);
  opacity: 0.85;
  margin: var(--space-1) 0 0;
  font-style: italic;
}

.hero-cta {
  --background: var(--color-white);
  --color: var(--color-primary-ink);
  --border-radius: var(--radius-pill);
  font-weight: 800;
  margin-top: var(--space-4);
  min-height: 46px;
}

// ── Body ────────────────────────────────────────────────
/* Capped and centred. This was full-bleed at every width, so on a tablet or a
   desktop every card on the page stretched edge to edge and the paragraphs ran
   to 200 characters — while Profile on the next screen capped itself at 640px.
   --container-max is the shared answer. */
.about-body {
  max-width: var(--container-max);
  margin: 0 auto;
  padding: var(--space-5) var(--space-4) var(--space-6);
}

.section-heading {
  font-family: var(--font-display);
  font-size: 21px;
  font-weight: 600;
  color: var(--color-ink);
  margin: 0 0 var(--space-3);
}

/* Was .section-heading--center, applied only to the story heading. Removed: that
   heading spans the full .story-section width, so centring it pushed it away
   from the copy it introduces and above the image column. Left, it lands flush
   with .story-text, matching the four other .section-heading rules on this page. */

// ── Story: copy beside the shop ──────────────────────────
/* Every other section in .about-body owns the space below it (.mv-section and
   .features-section --space-6, .how-section --space-4, .tech-section
   --space-3), and .about-body is a plain block flow with no gap — so without
   this the name triptych runs straight into the Mission & Vision grid. */
.story-section {
  margin-bottom: var(--space-6);
}

/* Below 900px the aside stacks under the text. Above it, they sit side by side,
   because a founding story with the location next to it is the pairing that
   makes the section worth the space. */
.story-split {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-4);
  align-items: start;
}

@media (min-width: 900px) {
  .story-split {
    grid-template-columns: minmax(0, 1.35fr) minmax(280px, 1fr);
    gap: var(--space-5);
  }
}

.story-copy {
  min-width: 0;
}

.story-text {
  font-size: 15px;
  line-height: 1.65;
  color: var(--color-ink);
  margin: 0 0 var(--space-3);
  max-width: var(--measure-max);
}

.story-aside {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  min-width: 0;
}

.store-figure {
  margin: 0;
  background: var(--color-white);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
  overflow: hidden;
}

/* Fixed 8:5, so the artwork never letterboxes and the card keeps its height
   whatever the viewport does. The comment here used to say 3:2, which
   contradicted the rule directly beneath it - 3:2 is 1.5, this is 1.6.

   object-fit is load-bearing now that this is an <img> rather than an inline
   SVG. An SVG scales through its viewBox; an image dropped into a box with a
   different aspect-ratio gets stretched to fill it unless told to crop instead.
   The source is cropped to exactly 8:5, so cover should never actually crop -
   it is here so a future swap cannot silently squash the storefront. */
.store-art {
  display: block;
  width: 100%;
  height: auto;
  aspect-ratio: 8 / 5;
  object-fit: cover;
}

.store-caption {
  padding: 7px 10px;
  font-size: 12px;
  line-height: 1.4;
  color: var(--ion-color-medium);
  border-top: 1px solid var(--ion-color-light-shade);
}

.map-link {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  color: var(--color-primary-ink);
  font-weight: 700;
  text-decoration: none;
}
.map-link:hover {
  text-decoration: underline;
}
.map-link app-icon {
  --icon-size: 13px;
}

.store-hours {
  display: flex;
  align-items: flex-start;
  gap: 5px;
  margin: 0;
  font-size: 12px;
  line-height: 1.45;
  color: var(--ion-color-medium);
}
.store-hours app-icon {
  --icon-size: 14px;
  flex: 0 0 auto;
  margin-top: 1px;
  color: var(--color-primary-ink);
}

// ── Name triptych ───────────────────────────────────────
// The one deliberately distinctive moment on the page: three cards standing in
// for the three words of the name. Everything else stays quiet.
//
// No accent border here, nor on .mv-card or .step-card below. A one-sided
// border on a rounded box is not a straight rule: CSS draws it between the
// outer rounded outline and an inner one whose radius is reduced by the
// border's width, so the two arcs are not concentric and the stripe tapers to
// zero at each corner - 26px of taper for the 5px rule .mv-card carried. It
// read as a hook rather than as an edge. These cards separate on --shadow-card.
.name-triptych {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  gap: var(--space-3);
  margin-top: var(--space-4);
}

.name-item {
  background: var(--color-white);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
  padding: var(--space-4);
}

.name-word {
  display: block;
  font-family: var(--font-display);
  font-size: 20px;
  font-weight: 600;
  color: var(--color-primary-ink);
  margin-bottom: 4px;
}

.name-meaning {
  display: block;
  font-size: 13px;
  line-height: 1.5;
  color: var(--ion-color-medium);
}

// ── Mission & Vision ────────────────────────────────────
.mv-section {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: var(--space-3);
  margin-bottom: var(--space-6);
}

.mv-card {
  background: var(--color-white);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  padding: var(--space-5);
}

.mv-head {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  margin-bottom: var(--space-2);
}

.mv-head app-icon {
  --icon-size: 20px;
  color: var(--color-primary-ink);
  flex: 0 0 auto;
}

.mv-title {
  font-family: var(--font-display);
  font-size: 18px;
  font-weight: 600;
  margin: 0;
  color: var(--color-ink);
}

.mv-text {
  font-size: 14px;
  line-height: 1.65;
  color: var(--color-ink);
  margin: 0;
}

// ── Features ────────────────────────────────────────────
.features-section {
  margin-bottom: var(--space-6);
}

.features-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: var(--space-3);
}

.feature-card {
  background: var(--color-white);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
  padding: var(--space-4);
}

.feature-icon-wrap {
  width: 44px;
  height: 44px;
  border-radius: var(--radius-sm);
  background: var(--tile-blush);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--space-3);
}

/* The team section gets the mint treatment rather than a second identical card
   style, so the two feature groups are distinguishable at a glance. */
.team-wrap {
  background: var(--tile-mint);
}

.feature-icon {
  --icon-size: 22px;
  color: var(--color-primary-ink);
}

.team-wrap .feature-icon {
  color: var(--color-mint-ink);
}

.feature-title {
  font-family: var(--font-display);
  font-size: 15px;
  font-weight: 600;
  color: var(--color-ink);
  margin: 0 0 4px;
}

.feature-desc {
  font-size: 13px;
  line-height: 1.55;
  color: var(--ion-color-medium);
  margin: 0;
}

// ── How it works ────────────────────────────────────────
/* Tightened. This section was ~382px tall for three steps and ended in a 64px
   silent gap before "Built With" — 32px of section margin stacked on 32px of
   the next one. The three steps now share one row on a wide screen, the padding
   is tighter, and the margins no longer double up. The container is ~90px
   shorter on a phone. */
.how-section {
  margin-bottom: var(--space-4);
}

.steps-list {
  display: grid;
  gap: var(--space-2);
  grid-template-columns: 1fr;
}

@media (min-width: 900px) {
  /* Three across once there is width for it: a sequence reads left to right, and
     three numbered cards in a row say "step 1, 2, 3" faster than a stack. */
  .steps-list {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

.step-card {
  display: flex;
  align-items: flex-start;
  gap: var(--space-3);
  background: var(--color-white);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
  padding: var(--space-3);
}

/* The number is meaningful here — How It Works IS a sequence — so it is a real
   marker rather than decoration. */
/* The number sits in a soft disc rather than floating as a bare glyph: at 26px
   in sunny yellow directly on white it measured about 1.6:1, so it was the least
   legible element on the page despite being the thing that establishes the
   sequence. */
.step-number {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34px;
  height: 34px;
  flex: 0 0 auto;
  border-radius: 50%;
  background: var(--tile-lemon);
  font-family: var(--font-display);
  font-size: 17px;
  font-weight: 700;
  line-height: 1;
  color: var(--color-sunny-ink);
}

.step-content {
  min-width: 0;
}

.step-title {
  font-family: var(--font-display);
  font-size: 16px;
  font-weight: 600;
  color: var(--color-ink);
  margin: 0 0 3px;
}

.step-desc {
  font-size: 13px;
  line-height: 1.55;
  color: var(--ion-color-medium);
  margin: 0;
}

// ── Tech stack ──────────────────────────────────────────
/* margin-bottom reduced from --space-6: the CTA below already carries a 24px
   top padding and a dashed rule, so a further 32px left ~56px of nothing. */
.tech-section {
  margin-bottom: var(--space-3);
}

.tech-chips {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);

  // The chip LABELS measured #64B6DD on cream — 2.17:1. Ionic picks a chip label's
  // colour from its own tint shades, and this one landed barely darker than the
  // ground. Declaring the foreground here overrides that derivation, and ink on
  // cream is 12.34:1.
  ion-label {
    color: var(--color-ink);
  }
}

// ── CTA ─────────────────────────────────────────────────
.team-cta {
  text-align: center;
  padding: var(--space-5) 0 0;
  border-top: 2px dashed var(--color-primary-ink);
}

.team-cta-text {
  font-size: 15px;
  font-weight: 600;
  color: var(--color-ink);
  margin: 0 0 var(--space-3);
}

.team-cta-btn {
  --border-radius: var(--radius-pill);
  // Declared because an `ion-button` with `fill="outline"` otherwise inherits
  // `--ion-color-primary` — the powder brand hue — which measured 1.71:1 on this
  // page's cream ground. At 14px/800 it is NOT WCAG large text, so it needs the
  // full 4.5:1, and primary-ink clears it.
  --color: var(--color-primary-ink);
  font-weight: 800;
  min-height: 44px;
}
</file>

<file path="src/app/features/auth/auth.page.ts">
// src/app/features/auth/auth.page.ts
// Five-orites Scoop — Login / Register / Admin Register Page

import { Component, inject, signal } from '@angular/core';
import { CommonModule } from '@angular/common';
import { FormsModule } from '@angular/forms';
import { Router } from '@angular/router';
import {
  IonContent,
  IonInput,
  IonButton,
  IonText,
  IonSpinner,
  IonLabel,
} from '@ionic/angular/standalone';
import { AppIconComponent } from '../../shared/components/app-icon/app-icon.component';
import { AppFooterComponent } from '../../shared/components/app-footer/app-footer.component';
import { AlertBannerComponent } from '../../shared/components/alert-banner/alert-banner.component';
import { AuthService } from '../../core/services/auth.service';
import { takeUntilDestroyed } from '@angular/core/rxjs-interop';
import { filter } from 'rxjs/operators';

type AuthMode = 'login' | 'register';

@Component({
  selector: 'app-auth',
  standalone: true,
  imports: [
    CommonModule,
    FormsModule,
    IonContent,
    IonInput,
    IonButton,
    IonText,
    IonSpinner,
    IonLabel,
    AppIconComponent,
    AlertBannerComponent,
    AppFooterComponent,
  ],
  templateUrl: './auth.page.html',
  styleUrls: ['./auth.page.scss'],
})
export class AuthPage {
  private authService = inject(AuthService);
  private router = inject(Router);

  mode = signal<AuthMode>('login');
  email = '';
  password = '';
  displayName = '';
  showPassword = signal(false);
  isLoading = signal(false);
  errorMessage = signal('');
  /** Non-empty after a reset request. Wording never reveals account existence. */
  resetMessage = signal('');
  isSendingReset = signal(false);

  constructor() {
    this.authService.currentUser$
      .pipe(
        takeUntilDestroyed(),
        filter((user) => user !== null),
      )
      .subscribe(() => this.router.navigate(['/dashboard']));
  }

  setMode(mode: AuthMode): void {
    this.mode.set(mode);
    this.errorMessage.set('');
    this.resetMessage.set('');
  }

  togglePasswordVisibility(): void {
    this.showPassword.set(!this.showPassword());
  }

  async submit(): Promise<void> {
    this.errorMessage.set('');
    this.isLoading.set(true);

    try {
      if (this.mode() === 'login') {
        await this.authService.signInWithEmail(this.email, this.password);
      } else {
        if (!this.displayName.trim()) {
          this.errorMessage.set('Please enter your full name.');
          return;
        }
        await this.authService.registerWithEmail(this.email, this.password, this.displayName);
      }

      await this.router.navigate(['/dashboard']);
    } catch (err: unknown) {
      this.errorMessage.set(this.parseFirebaseError(err));
    } finally {
      this.isLoading.set(false);
    }
  }

  /**
   * Sends a reset email.
   *
   * The confirmation is intentionally the SAME whether or not an account exists
   * for that address. Reporting "no account" here would be an account-enumeration
   * hole, identical in shape to the one the login error messages had.
   */
  async sendResetEmail(): Promise<void> {
    this.errorMessage.set('');
    this.resetMessage.set('');
    if (!this.email.trim()) {
      this.errorMessage.set('Enter your email address first.');
      return;
    }
    this.isSendingReset.set(true);
    try {
      await this.authService.sendPasswordResetEmail(this.email);
      this.resetMessage.set(
        'If an account exists for that address, a reset link is on its way. Check your spam folder if it does not arrive.',
      );
    } catch {
      this.errorMessage.set('Could not send the reset email. Please try again later.');
    } finally {
      this.isSendingReset.set(false);
    }
  }

  async signInWithGoogle(): Promise<void> {
    this.isLoading.set(true);
    try {
      await this.authService.signInWithGoogle();
      await this.router.navigate(['/dashboard']);
    } catch {
      this.errorMessage.set('Google sign-in failed. Please try again.');
    } finally {
      this.isLoading.set(false);
    }
  }

  private parseFirebaseError(err: unknown): string {
    if (err instanceof Error) {
      const code = (err as { code?: string }).code ?? '';
      // Deliberately ONE message for every credential failure. Telling a
      // visitor "no account found with this email" but "incorrect password"
      // for the same input turns the login form into an account-enumeration
      // oracle. These two codes are what the SDK throws when Email Enumeration
      // Protection is OFF; with it on it throws invalid-credential instead.
      // One message is correct in both configurations.
      const messages: Record<string, string> = {
        'auth/user-not-found': 'Incorrect email or password.',
        'auth/wrong-password': 'Incorrect email or password.',
        'auth/invalid-credential': 'Incorrect email or password.',
        'auth/email-already-in-use': 'An account with this email already exists.',
        'auth/weak-password': 'Password must be at least 6 characters.',
        'auth/invalid-email': 'Please enter a valid email address.',
        'auth/too-many-requests': 'Too many attempts. Please try again later.',
      };
      return messages[code] ?? err.message ?? 'An unexpected error occurred.';
    }
    return 'An unexpected error occurred.';
  }
}
</file>

