}

.suggestions {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.suggestion {
  border: 1px solid var(--color-border, #dfe4ec);
  background: transparent;
  border-radius: 999px;
  padding: 3px 10px;
  font-size: 12px;
  cursor: pointer;
  color: var(--color-ink, #22252b);
}

.swatches {
  display: flex;
  gap: 8px;
}

