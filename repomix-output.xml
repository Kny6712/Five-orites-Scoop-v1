<!-- src/app/shared/components/product-card/product-card.component.html -->

<ion-card class="product-card" [routerLink]="['/products', product.id]">
  <div class="card-image-wrap">
    @if (!imageLoaded()) {
      <ion-skeleton-text animated class="image-skeleton"></ion-skeleton-text>
    }
    <img
      [src]="(product.imageUrl | cloudinary: 400) || '/assets/placeholder-scoop.svg'"
      [alt]="product.variantName"
      class="card-image"
      [class.image-visible]="imageLoaded()"
      (load)="onImageLoad()"
      (error)="onImageError($event)"
    />
    <div class="set-badge">Set {{ product.setNumber }} · {{ product.setName }}</div>
    <button
      type="button"
      class="wishlist-btn"
      (click)="toggleWishlist($event)"
      [attr.aria-label]="isWished() ? 'Remove from wishlist' : 'Save to wishlist'"
    >
      <!-- One Lucide glyph for both states; the filled look comes from
           .wished setting `fill: currentColor`, so there is no second icon. -->
      <app-icon name="heart" class="wishlist-icon" [class.wished]="isWished()" />
    </button>
  </div>

  <ion-card-content class="card-body" (click)="$event.stopPropagation()">
    <h3 class="variety-name">{{ product.variantName }}</h3>

    <ion-segment [value]="selectedSize()" (ionChange)="onSizeChange($event)" class="size-segment" mode="md">
      @for (size of sizes; track size) {
        <ion-segment-button [value]="size" class="size-btn">
          <ion-label>{{ sizeLabels[size] }}</ion-label>
        </ion-segment-button>
      }
    </ion-segment>

    <div class="price-stock-row">
      <span class="price">{{ currentPrice() | peso }}</span>
      <!--
        Explicit tone classes, NOT [color].
        Ionic's color input derives a foreground AND a background from one name with no
        relationship between them, which is why "In Stock" measured 1.12:1 - the label
        and the pill within a percent of the same lightness. color is built for tints,
        not for text contrast. Same defect already fixed on /developers.
      -->
      <ion-chip
        [ngClass]="
          currentStock() === 0
            ? 'stock-chip-out'
            : currentStock() < lowStockThreshold()
              ? 'stock-chip-low'
              : 'stock-chip-ok'
        "
        class="stock-chip"
      >
        <ion-label>
          {{ currentStock() === 0 ? 'Out of Stock' : currentStock() < lowStockThreshold() ? 'Low Stock' : 'In Stock' }}
        </ion-label>
      </ion-chip>
    </div>

    <ion-button expand="block" class="add-to-cart-btn" [disabled]="isOutOfStock() || isAdding()" (click)="addToCart()">
      <app-icon name="cart" slot="start" />
      {{ isAdding() ? 'Adding...' : isOutOfStock() ? 'Out of Stock' : 'Add to Cart' }}
    </ion-button>
  </ion-card-content>
</ion-card>
</file>

