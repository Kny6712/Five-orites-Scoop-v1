<ion-header>
  <ion-toolbar>
    <ion-buttons slot="start">
      <ion-menu-button aria-label="Open navigation menu"></ion-menu-button>
    </ion-buttons>
    <ion-title>About</ion-title>
    <ion-buttons slot="end">
      <app-cart-button />
    </ion-buttons>
  </ion-toolbar>
</ion-header>

<ion-content fullscreen>
  <!-- Hero. The wave closes the section and hands off to the page background. -->
  <section class="about-hero wave-drip">
    <div class="hero-logo-wrap">
      <!-- Decorative: hero.title on the <h1> below is the brand name. -->
      <img src="/assets/images/logo-ice_cream.png" alt="" aria-hidden="true" class="hero-logo" />
    </div>
    <h1 class="hero-title">{{ hero.title }}</h1>
    <p class="hero-tagline">{{ hero.tagline }}</p>
    <ion-button [routerLink]="'/products'" class="hero-cta" size="default">
      {{ hero.cta }}
      <app-icon name="arrow-right" slot="end" />
    </ion-button>
  </section>

  <div class="about-body">
    <!-- ── Our story ──────────────────────────────────────────────────────
      The heading is centred, and the story runs beside a photo of the shop and
      a map of where it is.

      That pairing is the point of the section. "How Our Business Started" is the
      one heading on this page that describes a place, and it was a block of
      centred-less text with no picture of anywhere — the page had exactly one
      image on it, the logo in the hero. Putting the address next to the founding
      story means the reader learns where this actually is in the same breath as
      why it exists. -->
    <section class="story-section">
      <h2 class="section-heading">{{ story.heading }}</h2>

      <div class="story-split">
        <div class="story-copy">
          @for (paragraph of story.paragraphs; track $index) {
            <p class="story-text">{{ paragraph }}</p>
          }
        </div>

        <div class="story-aside">
          <figure class="store-figure">
            <!--
              Inside the shop. A photograph rather than an illustration, so this
              one does show a real interior rather than a storefront that does
              not exist yet.

              Cropped to 8:5 to match the .store-art aspect-ratio. The source is
              3:2, so only 16px of height is dropped and it is centred. Made
              from assets/images/storefront.png at 390x244, q88 JPEG, 37 KB.

              KNOWN LIMITATION: the source is only 390px wide. This card renders
              420px, so the image upscales 1.08x at 1x DPR and 2.15x at 2x,
              which is visibly soft on a retina screen. Re-export the source at
              840px or wider and regenerate this crop rather than upscaling the
              JPEG, which would only invent pixels.
            -->
            <img
              class="store-art"
              src="/assets/images/storefront.jpg"
              alt="Ice cream shop interior with a counter of tubs and oversized cone wall decorations"
            />
            <figcaption class="store-caption">{{ shop.address }}</figcaption>
          </figure>

          <figure class="store-figure store-figure--map">
            <app-scoop-map
              [markers]="shopMarkers"
              height="200px"
              ariaLabel="Map showing the location of Five-orites Scoop in Cainta, Rizal"
            />
            <figcaption class="store-caption">
              <a [href]="shop.mapsUrl" target="_blank" rel="noopener" class="map-link">
                <app-icon name="external-link" />
                Open in Maps
              </a>
            </figcaption>
          </figure>

          <p class="store-hours">
            <app-icon name="clock" />
            <span>Weekdays {{ hours.weekdays }} &middot; Weekends {{ hours.weekends }}</span>
          </p>
          <!-- Whole row hidden while empty: `SHOP_HOURS.phone` is '' and an admin
               may never have filled the setting in, and printing an empty line
               reads as a bug rather than as absent information. -->
          @if (contactPhone()) {
            <p class="store-hours">
              <app-icon name="phone" />
              <a [href]="'tel:' + contactPhone()">{{ contactPhone() }}</a>
            </p>
          }
        </div>
      </div>

      <!--
        The name etymology, lifted out of the middle of the story paragraph. It is
        the most distinctive thing in the copy and read as a wall of text; three
        labelled beats give the page a real visual anchor.
      -->
      <div class="name-triptych">
        @for (item of story.nameMeanings; track item.word) {
          <div class="name-item">
            <span class="name-word">{{ item.word }}</span>
            <span class="name-meaning">{{ item.meaning }}</span>
          </div>
        }
      </div>
    </section>

    <!-- ── Mission & Vision ─────────────────────────────────────────────── -->
    <section class="mv-section">
      <article class="mv-card mission">
        <div class="mv-head">
          <app-icon name="navigation" />
          <h2 class="mv-title">{{ mission.heading }}</h2>
        </div>
        <p class="mv-text">{{ mission.text }}</p>
      </article>

      <article class="mv-card vision">
        <div class="mv-head">
          <app-icon name="eye" />
          <h2 class="mv-title">{{ vision.heading }}</h2>
        </div>
        <p class="mv-text">{{ vision.text }}</p>
      </article>
    </section>

    <!-- ── For customers ────────────────────────────────────────────────── -->
    <section class="features-section">
      <h2 class="section-heading">For Ice Cream Lovers</h2>
      <div class="features-grid">
        @for (feature of customerFeatures; track feature.title) {
          <div class="feature-card">
            <div class="feature-icon-wrap">
              <app-icon [name]="feature.icon" class="feature-icon" />
            </div>
            <h3 class="feature-title">{{ feature.title }}</h3>
            <p class="feature-desc">{{ feature.description }}</p>
          </div>
        }
      </div>
    </section>

    <!-- ── For the team ─────────────────────────────────────────────────── -->
    <section class="features-section">
      <h2 class="section-heading">For Our Team</h2>
      <div class="features-grid">
        @for (feature of teamFeatures; track feature.title) {
          <div class="feature-card team">
            <div class="feature-icon-wrap team-wrap">
              <app-icon [name]="feature.icon" class="feature-icon" />
            </div>
            <h3 class="feature-title">{{ feature.title }}</h3>
            <p class="feature-desc">{{ feature.description }}</p>
          </div>
        }
      </div>
    </section>

    <!-- ── How it works ─────────────────────────────────────────────────── -->
    <section class="how-section">
      <h2 class="section-heading">How It Works</h2>
      <div class="steps-list">
        @for (step of howItWorks; track step.number) {
          <div class="step-card">
            <span class="step-number">{{ step.number }}</span>
            <div class="step-content">
              <h3 class="step-title">{{ step.title }}</h3>
              <p class="step-desc">{{ step.description }}</p>
            </div>
          </div>
        }
      </div>
    </section>

    <!-- ── Built with ───────────────────────────────────────────────────── -->
    <section class="tech-section">
      <h2 class="section-heading">Built With</h2>
      <div class="tech-chips">
        @for (tech of techStack; track tech) {
          <ion-chip color="primary" outline>
            <ion-label>{{ tech }}</ion-label>
          </ion-chip>
        }
      </div>
    </section>

    <div class="team-cta">
      <p class="team-cta-text">Curious who built this?</p>
      <ion-button [routerLink]="'/developers'" fill="outline" class="team-cta-btn"> Meet the Team </ion-button>
    </div>
  </div>

  <app-footer></app-footer>
</ion-content>
