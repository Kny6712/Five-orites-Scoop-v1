// src/app/app.routes.ts
// Five-orites Scoop — Root Route Definitions
// Author: Five-orites Scoop team (see README)

import { Routes } from '@angular/router';
import { authGuard } from './core/guards/auth.guard';
import { adminGuard, capabilityGuard, teamGuard } from './core/guards/admin.guard';

export const routes: Routes = [
  {
    path: '',
    redirectTo: 'dashboard',
    pathMatch: 'full',
  },
  {
    path: 'dashboard',
    loadComponent: () => import('./features/dashboard/dashboard.page').then((m) => m.DashboardPage),
    canActivate: [authGuard],
  },
  {
    path: 'products',
    loadComponent: () => import('./features/products/products.page').then((m) => m.ProductsPage),
    canActivate: [authGuard],
  },
  {
    path: 'products/:id',
    loadComponent: () =>
      import('./features/products/product-detail/product-detail.page').then(
        (m) => m.ProductDetailPage,
      ),
    canActivate: [authGuard],
  },
  {
    path: 'cart',
    loadComponent: () => import('./features/cart/cart.page').then((m) => m.CartPage),
    canActivate: [authGuard],
  },
  {
    path: 'orders',
    loadComponent: () => import('./features/orders/orders.page').then((m) => m.OrdersPage),
    canActivate: [authGuard],
  },
  {
    path: 'orders/:id',
    loadComponent: () =>
      import('./features/orders/order-tracker/order-tracker.page').then((m) => m.OrderTrackerPage),
    canActivate: [authGuard],
  },
  {
    path: 'profile',
    loadComponent: () => import('./features/profile/profile.page').then((m) => m.ProfilePage),
    canActivate: [authGuard],
  },
  {
    // The in-app notification feed. Behind authGuard because it is derived
    // entirely from the signed-in user's own orders, so there is nothing to show
    // a guest and no document a guest could read.
    path: 'notifications',
    loadComponent: () =>
      import('./features/notifications/notifications.page').then((m) => m.NotificationsPage),
    canActivate: [authGuard],
  },
  {
    path: 'about',
    loadComponent: () => import('./features/about/about.page').then((m) => m.AboutPage),
  },
  {
    path: 'developers',
    loadComponent: () =>
      import('./features/developers/developers.page').then((m) => m.DevelopersPage),
  },
  {
    path: 'auth',
    loadComponent: () => import('./features/auth/auth.page').then((m) => m.AuthPage),
  },
  {
    path: 'settings',
    loadComponent: () => import('./features/settings/settings.page').then((m) => m.SettingsPage),
    canActivate: [authGuard],
  },
  {
    path: 'admin',
    canActivate: [authGuard, adminGuard],
    children: [
      {
        path: 'inventory',
        canActivate: [capabilityGuard('manage_inventory')],
        loadComponent: () =>
          import('./admin/inventory/inventory.page').then((m) => m.InventoryPage),
      },
      {
        path: 'orders',
        canActivate: [capabilityGuard('manage_orders')],
        loadComponent: () =>
          import('./admin/orders/admin-orders.page').then((m) => m.AdminOrdersPage),
      },
      {
        path: 'reviews',
        canActivate: [capabilityGuard('moderate_reviews')],
        loadComponent: () =>
          import('./admin/reviews/admin-reviews.page').then((m) => m.AdminReviewsPage),
      },
      {
        path: 'settings',
        canActivate: [capabilityGuard('manage_settings')],
        loadComponent: () =>
          import('./admin/settings/admin-settings.page').then((m) => m.AdminSettingsPage),
      },
      {
        path: 'analytics',
        canActivate: [capabilityGuard('view_analytics')],
        loadComponent: () =>
          import('./admin/analytics/analytics.page').then((m) => m.AnalyticsPage),
      },
      {
        path: 'vouchers',
        canActivate: [capabilityGuard('manage_vouchers')],
        loadComponent: () =>
          import('./admin/vouchers/admin-vouchers.page').then((m) => m.AdminVouchersPage),
      },
      {
        path: 'users',
        canActivate: [capabilityGuard('manage_users')],
        loadComponent: () => import('./admin/users/admin-users.page').then((m) => m.AdminUsersPage),
      },
      {
        path: 'tracking',
        canActivate: [capabilityGuard('manage_orders')],
        loadComponent: () =>
          import('./admin/tracking/admin-tracking.page').then((m) => m.AdminTrackingPage),
      },
      {
        // Manager and owner, NOT admin — `teamGuard` rather than a capabilityGuard,
        // and the reasoning is in admin.guard.ts. Editing the public credits is the
        // one page where the distinction between manager and admin matters.
        path: 'developers',
        canActivate: [teamGuard()],
        loadComponent: () =>
          import('./admin/developers/admin-developers.page').then((m) => m.AdminDevelopersPage),
      },
    ],
  },
  {
    path: '**',
    redirectTo: 'dashboard',
  },
];
</file>

<file path="SETUP_GUIDE.txt">
╔══════════════════════════════════════════════════════════════╗
║           FIVE-ORITES SCOOP — SETUP GUIDE                   ║
║           Read this before doing anything!                   ║
╚══════════════════════════════════════════════════════════════╝

WHAT IS ALREADY DONE FOR YOU ✅
────────────────────────────────
- All 73+ source code files
- angular.json
- tsconfig.json + tsconfig.app.json
- ionic.config.json
- package.json (all dependencies listed)
- src/index.html
- src/global.scss
- Firestore security rules
- Seed script for 64 products

WHAT YOU MUST DO YOURSELF (3 things) ⚠️
──────────────────────────────────────────────

THING 1 — Fill in your Firebase credentials
  File to edit: src/environments/environment.ts
  Template:    src/environments/environment.example.ts

  Start from the example file:
     cp src/environments/environment.example.ts src/environments/environment.ts
     (Windows: copy src\environments\environment.example.ts src\environments\environment.ts)

  Then replace each PASTE_YOUR_xxx_HERE with your real values.
  Get them from: Firebase Console → Project Settings → Your Apps → </>

  environment.prod.ts is swapped in automatically for production builds
  (see fileReplacements in angular.json), so fill in the same values there
  before deploying.

THING 2 — Add your Service Account Key
  File to add: scripts/serviceAccountKey.json  (git-ignored — never commit it)

  Get it from: Firebase Console → Project Settings → Service Accounts
               → Generate new private key → download the .json file
  Rename it to: serviceAccountKey.json
  Place it in:  the scripts/ folder

  Only needed for `npm run seed`. The app itself does not use it.

THING 3 — Connect Cloudinary (for Add Product images)
  File to edit: src/environments/environment.ts (and environment.prod.ts)

  1. Sign up at cloudinary.com (free plan is enough)
  2. Copy your Cloud Name from the Dashboard top
  3. Go to: Settings (gear) → Upload → Upload presets → Add upload preset
     - Signing Mode: Unsigned → Save
     - Copy the Preset name
  4. Paste both into the cloudinary block:
       cloudinary: { cloudName: 'your-name', uploadPreset: 'your-preset' }
  Until then, image upload shows a warning and products save without an image.

  Tightening the preset (optional but recommended — an unsigned preset is a
  public drop box, so anyone who learns its name can upload):
     - Max file size: ~4 MB
     - Allowed formats: jpg, png, webp
     - Folder: five-orites-scoop/products
     - Leave "Incoming moderation" OFF. Turning it on sends every product
       photo into a manual approval queue and Add Product will show broken
       images until each one is approved.

  IMAGE SIZING IS AUTOMATIC
  Uploaded files are downscaled to 1024px before upload, and the CloudinaryPipe
  (`src/app/shared/pipes/cloudinary.pipe.ts`) resizes on delivery per screen:
  grid 400px, product page 1000px, cart 200px — with f_auto/q_auto, so modern
  browsers get WebP automatically. One stored file serves every screen size, so
  there is nothing to configure and no need to re-upload existing images.

STEPS TO RUN THE APP
──────────────────────
1. Open this folder in VS Code
2. Open terminal (Ctrl + `)
3. Run: npm install
   (if peer-dependency errors appear, retry with npm install --legacy-peer-deps)
4. Run: npm run typecheck      (optional sanity check — no Firebase needed)
5. Run: npm run test:logic     (optional — 160 business-logic tests)
6. Run: npm run seed           (writes 64 products to Firestore)
7. Run: npm start              (dev server, opens in browser)
8. Open: http://localhost:4200

VERIFYING A PRODUCTION BUILD
────────────────────────────
  npm run build        → output lands in www/browser
  firebase deploy --only hosting

  Note: both firebase.json (hosting.public) and capacitor.config.ts (webDir)
  point at www/browser, because that is where Angular 17's application builder
  writes. Do not change one without the other.

FIREBASE SETUP CHECKLIST
──────────────────────────
□ Created Firebase project at console.firebase.google.com
□ Enabled Firestore Database (Build → Firestore → Create database)
□ Enabled Authentication → Email/Password + Google sign-in
□ Registered a Web App (Project Settings → </> icon)
□ Copied credentials into src/environments/environment.ts
  (and environment.prod.ts before deploying)
□ Downloaded service account key → renamed → placed in scripts/
□ Ran: npm run seed  (seeds 64 products)
□ Ran: firebase deploy --only firestore  (applies security rules + indexes)
□ Promoted your first admin:
  Sign in through the app once FIRST — that is what creates users/{uid}.
  Then:  npm run seed:admin -- <your-uid> owner

  (The security rules read the `role` field on the user document; there are no
  custom claims. Only an OWNER can promote anyone else afterwards, from
  Admin → Users.)

  The script validates the role against the same vocabulary the app and the rules
  use, and refuses anything malformed. Doing this by hand in the console is what
  produced a real incident here: a role pasted as "owner\n" matches no tier, so the
  owner lost every admin page with no error anywhere, and recovery meant another
  manual edit.

TEAM MEMBERS
──────────────
- Kenn Karlo Umadhay     (Main Lead, Full Stack, UI/UX, QA, Docs)
- Heaven Alvior           (QA, Documentation)
- Justin Curby Esguerra  (Full Stack, UI/UX, QA, Documentation)
- Renz Gabriel De la Cruz (QA, Documentation)
- Antonio Miguel Villanueva (Full Stack, UI/UX, QA, Documentation)
</file>

<file path="src/app/admin/analytics/analytics.page.html">
<!-- src/app/admin/analytics/analytics.page.html -->

<ion-header>
  <ion-toolbar color="primary">
    <ion-buttons slot="start">
      <ion-menu-button aria-label="Open navigation menu"></ion-menu-button>
    </ion-buttons>
    <ion-title>Sales Analytics</ion-title>
  </ion-toolbar>
</ion-header>

<ion-content fullscreen>
  <ion-refresher slot="fixed" (ionRefresh)="handleRefresh($event)">
    <ion-refresher-content></ion-refresher-content>
  </ion-refresher>

  @if (isLoading()) {
    <div class="analytics-body">
      @for (s of [1, 2, 3, 4]; track s) {
        <ion-card><ion-skeleton-text animated style="height: 80px"></ion-skeleton-text></ion-card>
      }
    </div>
  }

  @if (!isLoading() && loadError()) {
    <div class="analytics-body">
      <app-alert-banner tone="danger" [message]="loadError()" actionLabel="Try again" (action)="loadData()" />
    </div>
  }

  @if (!isLoading() && !loadError()) {
    <div class="analytics-body">
      <ion-segment [value]="dateRange()" (ionChange)="setDateRange($any($event).detail.value)">
        <ion-segment-button value="all"><ion-label>All</ion-label></ion-segment-button>
        <ion-segment-button value="today"><ion-label>Today</ion-label></ion-segment-button>
        <ion-segment-button value="7d"><ion-label>7d</ion-label></ion-segment-button>
        <ion-segment-button value="30d"><ion-label>30d</ion-label></ion-segment-button>
      </ion-segment>
      <!--
        Export, left-aligned and narrow.

        It was `expand="block"` — a full-width bar directly under the range
        segment, which made a secondary action the most prominent control on the
        page. It is now sized to its own label and sits on the left of the range
        selector, which is where an export belongs: at the edge, out of the way of
        the figures.
      -->
      <div class="toolbar-row">
        @if (exportError()) {
          <!--
          An export that reports success but produced no file is worse than a
          visible failure: the admin walks away believing they have a report. On a
          device the old anchor-click path did exactly that.
        -->
          <app-alert-banner tone="danger" title="Export failed" [message]="exportError()" />
        }

        <ion-button size="small" fill="outline" class="export-btn" (click)="exportCsv()">
          <app-icon name="download" slot="start" />
          Export CSV
        </ion-button>
      </div>

      @if (truncated()) {
        <!--
          The page walk hit ANALYTICS_MAX_ORDERS and stopped, so every figure below
          is a LOWER BOUND rather than a total. Saying so is the difference between
          "we did 40k this month" and "we did at least 40k this month", and only
          the second is true.

          This should now be unreachable at any realistic order volume -- the walk
          pages through until Firestore runs out. It is kept because a ceiling the
          app cannot reach is a claim, and a claim that silently stops being true
          is the bug this banner exists to prevent.
        -->
        <app-alert-banner
          tone="warning"
          title="Figures are a lower bound"
          [message]="
            'Counted ' +
            orders().length +
            ' orders and stopped there. Anything older was not included, so these totals understate real activity.'
          "
        />
      }

      <div class="kpi-grid">
        <div class="kpi-tile kpi-revenue">
          <app-icon name="banknote" class="kpi-icon" />
          <p class="kpi-label">Revenue (Delivered)</p>
          <p class="kpi-val">{{ totalRevenue() | peso }}</p>
        </div>
        <div class="kpi-tile kpi-orders">
          <app-icon name="receipt" class="kpi-icon" />
          <p class="kpi-label">Total Orders ({{ rangeLabel() }})</p>
          <p class="kpi-val">{{ totalOrders() }}</p>
        </div>
        <div class="kpi-tile kpi-delivered">
          <app-icon name="trending-up" class="kpi-icon" />
          <p class="kpi-label">Delivered ({{ rangeLabel() }})</p>
          <p class="kpi-val">{{ deliveredOrders() }}</p>
        </div>
        <div class="kpi-tile kpi-avg">
          <app-icon name="ice-cream" class="kpi-icon" />
          <p class="kpi-label">Avg. Delivered Order</p>
          <p class="kpi-val">{{ avgOrderValue() | peso }}</p>
        </div>
      </div>

      <!-- Say so out loud rather than quietly filtering: if the admin ever
           wonders why revenue looks lower than Fulfillment's order count, the
           answer is here instead of being a mystery. -->
      @if (myOrderCount() > 0) {
        <p class="analytics-note">
          Excludes your {{ myOrderCount() }} own order{{ myOrderCount() === 1 ? '' : 's' }} in {{ rangeLabel() }} — an
          owner purchase isn't revenue. They still appear in Fulfillment.
        </p>
      }

      <!--
        Charts, side by side from tablet up.

        The status donut and the size breakdown answer different questions and
        were stacked full-width, so reading the page meant a long scroll past a
        very large donut to get to the number the reader came for. A donut is
        square by nature and a bar chart is not, so capping the donut and putting
        the two in a two-column grid stops the first one dominating.
      -->
      <div class="chart-row">
        <!-- Donut: how the orders split across statuses. A donut rather than a
             full pie because the hole carries the total, which is the number
             people actually want. -->
        @if (deliveredOnly().length > 0) {
          <ion-card class="chart-card chart-card--donut">
            <ion-card-content>
              <h3 class="section-title">Order status mix</h3>
              <p class="chart-sub">Every order in {{ rangeLabel() }}, not just delivered ones.</p>
              <app-donut-chart
                [slices]="statusSlices()"
                centreLabel="Orders"
                ariaLabel="Distribution of orders by status"
              />
            </ion-card-content>
          </ion-card>
        }

        <!--
          Sales volume by size, with the leader called out.

          A bare bar chart of four numbers does not tell an owner which size to
          push, so the best performer is named above it in words as well as in
          the bar lengths.
        -->
        @if (salesBySize().length > 0) {
          <ion-card class="chart-card">
            <ion-card-content>
              <h3 class="section-title">Sales volume by size</h3>
              <p class="chart-sub">Delivered orders only, in {{ rangeLabel() }}.</p>
              @if (topSize(); as top) {
                <p class="chart-callout">
                  <strong>{{ top.label }}</strong> leads with {{ top.count }} unit{{
                    top.count === 1 ? '' : 's'
                  }}
                  &middot; {{ top.revenue | peso }}
                </p>
              }
              <app-bar-chart
                [data]="sizeBars()"
                [format]="formatUnits"
                emptyMessage="No delivered sales in this range yet."
              />
            </ion-card-content>
          </ion-card>
        }
      </div>

      <!-- Bar: units sold per flavor. Horizontal because flavor names are long. -->
      @if (topFlavors().length > 0) {
        <ion-card class="chart-card">
          <ion-card-content>
            <h3 class="section-title">Top flavors by units sold</h3>
            <p class="chart-sub">Delivered orders only, in {{ rangeLabel() }}. Top ten shown.</p>
            <app-bar-chart
              [data]="flavorBars()"
              [format]="formatUnits"
              emptyMessage="No delivered flavors in this range yet."
            />
          </ion-card-content>
        </ion-card>
      }

      <!--
        The full ranking, as data.

        The chart above can only show so many bars before the labels stop being
        readable, so it stops at ten. This table does not — it lists every flavor
        that sold in the window, ranked, with its share of all units. A count on
        its own is not comparable (40 units is good against 200 and bad against
        4,000), so the percentage is what makes the ranking mean anything.
      -->
      @if (topFlavors().length > 0) {
        <ion-card class="chart-card">
          <ion-card-content>
            <h3 class="section-title">Flavors ranked by units sold</h3>
            <p class="chart-sub">
              All {{ topFlavors().length }} flavor{{ topFlavors().length === 1 ? '' : 's' }} that sold, highest to
              lowest. Delivered orders only, in {{ rangeLabel() }}.
            </p>

            <div class="table-wrap">
              <table class="flavor-table">
                <caption class="visually-hidden">
                  Every flavor that sold in
                  {{
                    rangeLabel()
                  }}, ranked by units sold
                </caption>
                <thead>
                  <tr>
                    <th scope="col" class="num">#</th>
                    <th scope="col">Flavor</th>
                    <th scope="col">Set</th>
                    <th scope="col" class="num">Units</th>
                    <th scope="col" class="num">Share</th>
                    <th scope="col" class="num">Revenue</th>
                  </tr>
                </thead>
                <tbody>
                  @for (flavor of pagedFlavors(); track flavor.name; let i = $index) {
                    <tr>
                      <td class="num rank">{{ flavorPageOffset() + i + 1 }}</td>
                      <td class="flavor-name">{{ flavor.name }}</td>
                      <td class="flavor-set">{{ flavor.setName }}</td>
                      <td class="num">{{ flavor.count }}</td>
                      <td class="num">{{ shareLabel(flavor.name) }}</td>
                      <td class="num revenue">{{ flavor.revenue | peso }}</td>
                    </tr>
                  }
                </tbody>
              </table>
            </div>

            <app-pagination
              [page]="flavorPage()"
              [total]="topFlavors().length"
              [pageSize]="FLAVOR_PAGE_SIZE"
              itemLabel="flavors"
              (pageChange)="flavorPage.set($event)"
            />
          </ion-card-content>
        </ion-card>
      }

      <!--
        The trend. Every other figure on this page is an aggregate for the whole
        window, so nothing here could answer "is it going up or down?" — which
        is the first question an owner asks.
      -->
      <ion-card class="chart-card">
        <ion-card-content>
          <h3 class="section-title">Revenue trend</h3>
          @if (rangeDays() === null) {
            <p class="chart-sub">Pick a date range to see the trend — "All time" has no window to plot against.</p>
          } @else {
            <p class="chart-sub">
              Delivered orders only{{ rangeDays()! > 14 ? ', by week' : ', by day' }}, in {{ rangeLabel() }}.
            </p>

            <div class="trend-toggles" role="group" aria-label="Trend measure">
              <button
                type="button"
                class="trend-toggle"
                [class.is-on]="trendSeries() === 'daily'"
                [attr.aria-pressed]="trendSeries() === 'daily'"
                (click)="trendSeries.set('daily')"
              >
                Per day
              </button>
              <button
                type="button"
                class="trend-toggle"
                [class.is-on]="trendSeries() === 'cumulative'"
                [attr.aria-pressed]="trendSeries() === 'cumulative'"
                (click)="trendSeries.set('cumulative')"
              >
                Running total
              </button>
              <button
                type="button"
                class="trend-toggle"
                [class.is-on]="trendSeries() === 'orders'"
                [attr.aria-pressed]="trendSeries() === 'orders'"
                (click)="trendSeries.set('orders')"
              >
                Orders
              </button>
            </div>

            <app-line-chart
              [points]="activeTrend()"
              [format]="trendSeries() === 'orders' ? formatCount : formatPeso"
              [seriesLabel]="trendSeries() === 'orders' ? 'Delivered orders' : 'Revenue'"
              emptyMessage="No delivered orders in this range yet."
            />
          }
        </ion-card-content>
      </ion-card>

      <!-- Bar: revenue by flavor set. -->
      @if (salesBySet().length > 0) {
        <ion-card class="chart-card">
          <ion-card-content>
            <h3 class="section-title">Revenue by flavor set</h3>
            <p class="chart-sub">Delivered orders only, in {{ rangeLabel() }}.</p>
            <app-bar-chart
              [data]="setBars()"
              [format]="formatPeso"
              emptyMessage="No delivered sales in this range yet."
            />
          </ion-card-content>
        </ion-card>
      }
    </div>
  }
  <app-footer></app-footer>
</ion-content>
</file>

