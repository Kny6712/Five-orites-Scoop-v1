{
  "name": "payment-server",
  "description": "Five-orites Scoop — Xendit payment session + webhook service. Lives OUTSIDE Firebase because the project is on the Spark plan and cannot deploy Cloud Functions (see CUTOVER.md).",
  "version": "1.0.0",
  "private": true,
  "main": "lib/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "start": "npm run build && node lib/server.js",
    "dev": "npm run build && node --watch lib/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase-admin": "^12.7.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "typescript": "~5.2.0"
  }
}
