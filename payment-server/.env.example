# payment-server — environment template.
#
# Copy to `.env` and fill in. `.env` is gitignored (see the repo .gitignore);
# this file is not, and deliberately contains no real values.
#
#   cp payment-server/.env.example payment-server/.env

# ── Xendit ────────────────────────────────────────────────────────────────────
# Secret API key. Dashboard → Developers → API keys. Test keys start with
# `dance_development_`, live keys with `production_`. NEVER put this in the
# Angular app — it ships in the browser bundle and cannot be un-shipped.
XENDIT_SECRET_KEY=dance_development_xxxxxxxxxxxxxxxxxxxx

# Webhook verification token. Dashboard → Developers → Webhooks. Compared
# against the `x-callback-token` header on every webhook delivery. Required in
# BOTH modes: a permissive test mode is how a permissive production mode gets
# written.
XENDIT_WEBHOOK_TOKEN=your-webhook-verification-token

# false (default) = api.sandbox.xendit.co, true = api.xendit.co.
# Setting true with a non-production_ key is refused at boot.
XENDIT_LIVE=false

# ── Return URLs ───────────────────────────────────────────────────────────────
# Public base URL of the Angular app. Xendit redirects the customer back to
# `{APP_BASE_URL}/cart?payment=…&orderId=…` after checkout.
#
# For local testing of webhooks, Xendit cannot reach localhost — run a tunnel
# (ngrok cloudflared) and put its HTTPS URL here AND in the Xendit dashboard:
#   ngrok http 8100        → APP_BASE_URL=https://xxxx.ngrok-free.app
#   ngrok http 4242        → then point the Xendit webhook URL at /payment/webhook
APP_BASE_URL=http://localhost:8100

# Origins allowed to call POST /payment/session. Comma separated, no trailing
# slash. Add your deployed hosting origin here when you go live.
ALLOWED_ORIGINS=http://localhost:8100,http://localhost:8200

# ── Service ───────────────────────────────────────────────────────────────────
PORT=4242

# true = talk to the local Firestore/Auth emulators (used by `npm run
# dev:emulator`). No service-account key is read in this mode.
USE_EMULATOR=false

# Path to a service-account JSON key, for runs against the real project from a
# machine without application-default credentials. The PATH goes here, never
# the JSON. Leave unset on Render/Railway/Fly, which mount a key and let
# applicationDefault() find it.
# FIREBASE_SERVICE_ACCOUNT=./serviceAccountKey.json
