rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Role tiers. `myRole()` is the SINGLE source of truth for the caller's
    // role; every guard below derives from it.
    //
    // NOTE (P2-13): this file's tier SETS (isStaff / isAdmin / canRunShop /
    // canManageUsers) are NOT byte-identical to the client's `ROLE_CAPABILITIES`
    // in src/app/core/models/user.model.ts — the client uses an 11-name
    // Capability union, the rules use these four role sets. Both layers must be
    // reviewed together; see the drift lint test in tests/logic.test.ts.
    //
    // 'admin' is kept in the full-access set so every account created before
    // role tiers existed keeps working untouched. A shop that upgrades does not
    // lose its owner's access to anything.
    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Any staff tier at all — i.e. this person reaches the admin area.
    function isStaff() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && myRole() in ['staff', 'manager', 'admin', 'owner'];
    }

    // Full admin access, which is what nearly every rule below needs.
    //
    // The three sets here are the same three sets as ROLE_CAPABILITIES:
    //   staff   → queue and map
    //   manager → + catalog, analytics, reviews, stock repair
    //   admin   → + vouchers
    //   owner   → + the user directory and the shop settings
    function isAdmin() {
      return isStaff() && myRole() in ['admin', 'owner'];
    }

    // Catalog, analytics, reviews and the stock ledger.
    function canRunShop() {
      return isStaff() && myRole() in ['manager', 'admin', 'owner'];
    }

    // The user directory and role changes. Deliberately OWNER-only.
    //
    // This is the whole point of the tiers: a shift lead works the queue and
    // cannot promote themselves, and a manager can fix prices without being able
    // to hand out admin. Under the old single-role model the minimum useful
    // privilege was full control over every account.
    function canManageUsers() {
      return isStaff() && myRole() == 'owner';
    }

    // ── Last-admin protection ──────────────────────────────────────────────
    // Every other role guard in this file compares the CALLER's own document, so
    // a spoofed `role` in a write payload cannot escalate. A role DEMOTION is
    // the one place that is not enough: `allow update: if isAdmin()` would let an
    // admin write `role: 'customer'` onto the LAST admin, after which nobody is
    // an admin, `isAdmin()` is false for everyone, and `allow delete: if false`
    // means the account cannot be removed. The admin side is then unreachable
    // with no recovery path from inside the app.
    //
    // Firestore rules cannot COUNT documents in a collection, so "is this the
    // last admin" cannot be asked directly. What CAN be expressed is the part
    // that matters: an admin may not remove the LAST admin, and the honest
    // approximation is that an admin may not demote THEMSELVES. That closes the
    // accidental case (a single-admin shop demoting itself in the UI) and leaves
    // the deliberate two-admin case — A demotes B, then B demotes A — which
    // requires two coordinated writes and is a different thing entirely.
    //
    // The UI guards this too (admin-users.page.ts disables the control), but a
    // UI guard is a suggestion and this is the rule.
    function isNotChangingOwnRole(targetUid) {
      // The simplest correct form: you may not change YOUR OWN role, in either
      // direction.
      //
      // Both directions are the same danger. Writing `role: 'customer'` onto the
      // last admin strands everyone (isStaff() is then false for all of them, and
      // `allow delete: if false` means nobody can remove the account), and
      // writing `role: 'owner'` onto yourself is self-escalation into the user
      // directory. One rule closes both, and it cannot be got wrong by inverting
      // a comparison.
      //
      // `targetUid` is a PARAMETER, not the bare `uid`: a function declared
      // outside a match block cannot see that block's path variables, and reading
      // one anyway is an undefined-property error rather than a false.
      //
      // `.get(key, default)` on both sides because `resource.data.role` on a
      // document that never had a role field is an undefined-property error, and
      // a null access is a HARD reject — it would fail unrelated profile edits.
      return request.auth.uid != targetUid
        || ('role' in request.resource.data
            && request.resource.data.role
                 == resource.data.get('role', null));
    }

    // The owner may promote/demote others and edit directories, but must not be
    // allowed to silently STRIP their own role in one write: with `role: deleteField()`
    // or a non-merged setDoc, the `.get('role', ...)` fallback made the old
    // comparison pass, `isStaff()` then fails for everyone, and `allow delete: if false`
    // means no in-app recovery. Requiring `'role' in request.resource.data` plus a
    // key whitelist (see the update branch below) keeps the check present-aware.

    // The keys an `admin` (not the owner) may write on somebody else's document:
    // the profile fields, the suspension flag, and the staff note. Deliberately
    // NOT `role` — handing out privileges is the one thing an admin must not do.
    function isAdminUserEdit() {
      return isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'photoURL', 'phone', 'notificationsEnabled',
          'isSuspended', 'suspendReason', 'suspendedAt', 'adminNote'
        ]);
    }

    // Every size must remain a non-negative whole number. Split out so the
    // admin path and the narrow customer stock path enforce the same floor.
    function sizeIsSane(v) {
      // A size that IS present must be a non-negative whole number. An ABSENT
      // size is NOT a rejection — otherwise a legacy/partial `stock` map would
      // make every edit and checkout throw a PERMISSION_DENIED that reads as an
      // auth bug rather than a data problem. The next successful write
      // normalises it to a full map.
      return v == null || (v is int && v >= 0);
    }

    // Every size must remain a non-negative whole number, when present.
    function stockIsSane() {
      return request.resource.data.stock is map
        && sizeIsSane(request.resource.data.stock.cup)
        && sizeIsSane(request.resource.data.stock.pint)
        && sizeIsSane(request.resource.data.stock.halfGallon)
        && sizeIsSane(request.resource.data.stock.gallon);
    }

    // `category` is OPTIONAL and only checked when present. Every product
    // document seeded before the field existed has no `category` at all, and
    // making it mandatory here would reject each of those on their next admin
    // edit — a validation rule that fails closed on existing data is worse than
    // no rule. An absent category reads as 'flavor' client-side.
    function categoryIsValid() {
      return !('category' in request.resource.data)
        || request.resource.data.category in ['flavor', 'sundae', 'cone'];
    }

    function isWellFormedProduct() {
      return request.resource.data.setNumber is int
        && request.resource.data.setNumber >= 1
        && request.resource.data.pricing.cup is int
        && request.resource.data.pricing.pint is int
        && request.resource.data.pricing.halfGallon is int
        && request.resource.data.pricing.gallon is int
        && request.resource.data.isActive is bool
        && categoryIsValid()
        && stockIsSane();
    }

    // ── Products ─────────────────────────────────────────────────────
    // Read: any signed-in user. Write: canRunShop() (manager+) with full
    // validation, OR — TEMPORARY, PENDING THE FUNCTION DEPLOY — a customer
    // touching nothing but `stock` so the CURRENT deployed client can still
    // decrement at checkout and return stock on cancel.
    //
    // The customer branch below is the worst hole in this file and it is meant to
    // disappear: `stockIsSane()` only checks each size is a non-negative integer,
    // so any signed-in session could write `stock.cup: 999999` (oversell) or zero
    // the catalog (availability DoS). The intended fix is the `reconcileOrderStock`
    // Cloud Function (functions/src/index.ts), which reserves stock server-side.
    //
    // WHY IT IS STILL HERE: the function is written and tested but this Firebase
    // project is on the Spark (free) plan, and Cloud Functions require Blaze. Until
    // the plan is upgraded and the function is deployed AND LIVE, removing this
    // branch while the client still decrements would deny every checkout. The
    // client-side decrement and this branch are a matched pair — cut them over to
    // the function TOGETHER, never one without the other. See CUTOVER.md.
    match /products/{productId} {
      allow read: if isSignedIn();
      allow create: if canRunShop() && isWellFormedProduct();
      allow update: if (canRunShop() && isWellFormedProduct())
        || (isSignedIn()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['stock', 'updatedAt'])
            && stockIsSane());

      // Delete: admin only.
      //
      // This was `if false` — there was no way to remove a mis-seeded flavor at
      // all, from the app or the console. The Inventory page now has an explicit
      // X control for it, distinguished from the Active pill: Active takes a
      // flavor OFF SALE and is reversible, delete erases the document.
      //
      // Admin-only, and deliberately not relaxed further. A product document
      // carries its stock and its image reference, and a completed order's items
      // record `variantName` as a string rather than a product id — so deleting a
      // flavor cannot break a past order's record, but it does lose the only
      // record of what the stock levels were. That trade is the admin's to make,
      // behind the confirmation dialog, and it is why this stays behind isAdmin()
      // rather than being opened up to any signed-in user the way the stock
      // decrement branch above necessarily is.
      allow delete: if isAdmin();
    }

    // ── Orders ───────────────────────────────────────────────────────
    match /orders/{orderId} {
      // Staff OR the order's own customer (covers get + where(customerId == uid) lists).
      //
      // `isStaff()` rather than `isAdmin()`: working the queue is the WHOLE POINT
      // of the staff tier, so a `staff` account that cannot read orders cannot do
      // its job. It grants nothing beyond reading — the update clause below still
      // requires a fuller tier.
      allow read: if isStaff()
        || (isSignedIn() && resource.data.customerId == request.auth.uid);
      // Owner creates their own pending order only.
      allow create: if isSignedIn()
        && request.resource.data.customerId == request.auth.uid
        // An explicit allow-list is what stops extra fields like
        // `stockRestored: false` from being combined with a fake cancelled order
        // to launder free stock through the owner's repair panel. Without it, the
        // client's `keys()` town had no ceiling: the customer-cancel branch above
        // pins only the four legitimate fields, but create pins none.
        && request.resource.data.keys().hasOnly([
          'customerId', 'customerEmail', 'items', 'totalAmount', 'deliveryFee',
          'discountAmount', 'voucherCode', 'grandTotal', 'status', 'paymentStatus',
          'deliveryAddress', 'notes', 'cancelReason', 'createdAt', 'updatedAt',
          'statusHistory'
        ])
        && request.resource.data.items.size() > 0
        && request.resource.data.totalAmount >= 0
        && request.resource.data.grandTotal >= 0
        // The totals must be internally consistent. A forgeable client could
        // otherwise set discount == total for a ₱0 order. Per-item unitPrice
        // still cannot be verified without the Cloud Function (no loop in rules).
        && request.resource.data.grandTotal
             == request.resource.data.totalAmount
              - request.resource.data.discountAmount
              + request.resource.data.deliveryFee
        && request.resource.data.deliveryAddress is string
        && request.resource.data.status == 'pending'
        && request.resource.data.paymentStatus == 'pending'
        // A discount can never exceed the subtotal it discounts.
        && request.resource.data.discountAmount is number
        && request.resource.data.discountAmount >= 0
        && request.resource.data.discountAmount <= request.resource.data.totalAmount;
      // Admin advances status / edits freely. A customer may only cancel their
      // own order, only while it is still pending, and may only touch the four
      // fields the cancel path writes — so no price, quantity or total is
      // reachable from a customer session.
      //
      // `statusHistory` must gain exactly one entry: the cancel path appends a
      // single arrayUnion element, so a caller cannot rewrite the fulfilment
      // timeline that the tracker renders.
      allow update: if canRunShop()
        || (isSignedIn()
            && resource.data.customerId == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'cancelReason', 'updatedAt', 'statusHistory'])
            && (request.resource.data.cancelReason is string
                ? request.resource.data.cancelReason.size() <= 300
                : request.resource.data.cancelReason == null)
            && request.resource.data.statusHistory.size()
                 == resource.data.statusHistory.size() + 1);
      allow delete: if false;
    }

    // ── Users ────────────────────────────────────────────────────────
    match /users/{uid} {
      // Owner, any staff tier, or the account's own document.
      //
      // Staff can read user documents because the fulfilment queue needs to show
      // who an order belongs to. That does NOT extend to the whole directory —
      // the unfiltered LIST below is owner-only, so staff cannot enumerate every
      // account in the shop from here.
      allow get: if isOwner(uid) || isStaff();
      allow list: if canManageUsers();
      // Owner can create only their own doc, always as customer.
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role == 'customer';
      // Owner can edit profile but never change role.
      // OWNER may change anything, including roles — but never their OWN.
      //
      // An `admin` may still fix a profile, suspend an account, or annotate it,
      // but NOT a role: handing out privileges is the one thing an admin must not
      // be able to do. Under the single-role model, promoting someone and fixing
      // their phone number were the same operation.
      allow update: if (canManageUsers()
            && isNotChangingOwnRole(uid)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['uid', 'email', 'displayName', 'photoURL', 'phone',
                           'notificationsEnabled', 'role', 'isSuspended',
                           'suspendReason', 'suspendedAt', 'adminNote']))
        || isAdminUserEdit()
        || (isOwner(uid)
          && request.resource.data.role == resource.data.role
          && request.resource.data.uid == resource.data.uid
          // The owner's branch now has a key whitelist.
          //
          // It compared role and uid by value and nothing else, so a customer
          // could write ANY other field on their own document — including
          // `isSuspended`, `suspendReason` and `adminNote`. A suspended account
          // could therefore lift its own suspension, and a customer could write
          // text that the admin UI then renders as a staff note. Those keys are
          // admin-only from here on.
          //
          // `diff().affectedKeys()` rather than `keys()` so this constrains only
          // what an update actually TOUCHED: `keys()` would demand the full
          // post-write document match the list, and `setDoc` without merge would
          // then be impossible. `hasOnly` (not `hasAll`) because a partial write
          // legitimately omits fields it is not changing.
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['displayName', 'photoURL', 'phone', 'notificationsEnabled']));
      allow delete: if false;
    }

    // ── Reviews ──────────────────────────────────────────────────────
    // Any signed-in user can read. An author may create, edit and delete their
    // OWN review; admins may moderate any review.
    //
    // The document id is deterministic — `${productId}_${uid}` — so a second
    // submission for the same product updates the existing review instead of
    // adding another, and the author can withdraw it. Previously the id was
    // random (addDoc), which allowed unlimited repeats that NEITHER the author
    // nor any admin UI could remove.
    //
    // Note `request.resource.data.productId`, not a bare `productId`: inside
    // `match /reviews/{reviewId}` the only capture is `reviewId`, so a bare
    // `productId` is an undefined identifier and the whole ruleset fails to
    // deploy. That was the error in the original gap analysis.
    match /reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create, update: if (isSignedIn()
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.productId is string
            && reviewId == request.resource.data.productId + '_' + request.auth.uid
            && request.resource.data.rating is int
            && request.resource.data.rating >= 1
            && request.resource.data.rating <= 5)
        || canRunShop();
      // The author may withdraw their own review. The id check is what stops
      // this becoming a delete-anything rule.
      allow delete: if canRunShop()
        || (isSignedIn()
            && resource.data.userId == request.auth.uid
            && reviewId == resource.data.productId + '_' + request.auth.uid);
    }

    // ── Vouchers ─────────────────────────────────────────────────────
    // Readable by customers for validation; writable by admin only.
    match /vouchers/{voucherId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Stock movements ───────────────────────────────────────────────
    // The audit trail for every stock change made through
    // `StockLedgerService.record()`.
    //
    // Read: admin only. Customers have no reason to see it and it reveals order
    // ids.
    //
    // Write: admin only, and CREATE only — a ledger row that could be edited or
    // deleted is not a ledger. Note the gap this deliberately leaves: a
    // CUSTOMER's stock write (the branch above) does NOT create a row, because
    // the rules cannot call a function or write two documents atomically. That
    // is exactly what `StockLedgerService.findUnloggedChanges()` detects.
    match /stockMovements/{movementId} {
      allow read: if canRunShop();
      allow create: if canRunShop();
      allow update, delete: if false;
    }

    // ── Shop settings ─────────────────────────────────────────────────
    // A SINGLE document at shopSettings/app — the low-stock threshold, the promo
    // banner and the contact line. Readable by any signed-in user because the
    // storefront renders the banner and the threshold drives the low-stock pill
    // on the customer dashboard. Admin write only.
    match /shopSettings/{docId} {
      allow read: if isSignedIn();
      // OWNER-only — the model (`manage_settings`) and the client route agree.
      // Previously admin+owner via `isAdmin()`, which over-granted `admin` a
      // write the client and ROLE_SUMMARY deny them. create/update only:
      // `allow write` aliases create+update+delete, and deleting the single
      // shop document would blank the storefront banner / pop the low-stock
      // threshold back to the build-time default.
      allow create: if canManageUsers()
        && request.resource.data.keys().hasOnly(['lowStockThreshold', 'promoTitle', 'promoBody', 'promoActive', 'contactPhone'])
        && request.resource.data.lowStockThreshold is number
        && request.resource.data.lowStockThreshold >= 1;
      allow update: if canManageUsers()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['lowStockThreshold', 'promoTitle', 'promoBody', 'promoActive', 'contactPhone'])
        && request.resource.data.lowStockThreshold is number
        && request.resource.data.lowStockThreshold >= 1;
      allow delete: if false;
    }

    // ── Catch-all deny ────────────────────────────────────────────────
    // Firestore denies anything unmatched already, so this changes no current
    // behaviour. It is here so that behaviour is DELIBERATE rather than
    // incidental: adding a collection later denies it by an explicit rule that
    // says so, instead of by omission that nobody wrote down.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
