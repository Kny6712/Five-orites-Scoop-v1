# Five-orites Scoop — .gitignore

# ── Sensitive / Credentials ─────────────────────────────────────────────────────
scripts/serviceAccountKey.json
.env
.env.*
!.env.example

# Generated by scripts/upload-product-images.ts — regenerable, and a duplicate
# source of truth next to Firestore.
scripts/image-urls.json

# ── Dependencies ─────────────────────────────────────────────────────────────────
node_modules/
dist/
www/

# ── Angular CLI ──────────────────────────────────────────────────────────────────
.angular/cache

# Logs — emulator output (npm run test:rules / npm run emulators), and the
# npm-install.log captures that used to be tracked. All regenerable, and a
# committed log rots silently: it reads as current to everyone and never is.
*.log
.firebase/

# Playwright scratch — page snapshots and traces from ad-hoc browser
# inspection. Local debugging output, regenerable on demand.
# .playwright-cli/  = Playwright CLI
# .playwright-mcp/  = @playwright/mcp server (see opencode.json)
.playwright-cli/
.playwright-mcp/

# One-off layout prototypes from ad-hoc browser inspection: Ionic CSS inlined,
# hardcoded fixture rows, no links in or out. Throwaway.
# .playwright-mcp/ is already covered just above.
/_*-after.html
/*-preview.html

# repomix snapshot. A generated ~4.6 MB dump of the whole tree that changes
# every time it is regenerated, so tracking it guarantees a diff every run.
repomix-output.xml

# ── Agent tooling ───────────────────────────────────────────────────────────────
# .claude/ = Claude Code agents and skills.  .kilo/ = Kilo scratch plans.
# Nothing in here is project-specific: there are zero references to this
# project across all of it, and neither a settings.json nor a CLAUDE.md is
# tracked from .claude/, so this is machine-local configuration rather than
# shared repo state.
#
# WHAT IGNORING THIS COSTS: a fresh clone gets none of it, including the skill
# packs that exist only in the local copy. All are regenerable library packs,
# not project knowledge, so that trade is worth making.
.claude/
.kilo/

# ── Capacitor ────────────────────────────────────────────────────────────────────
#
# WHY `android/` IS TRACKED NOW, AND `ios/` IS NOT.
#
# This used to ignore both. That is the default from `cap init`, and it is wrong for
# a project that has a splash: the entire splash and icon configuration lives in
# `android/app/src/main/res/` and `styles.xml`, so ignoring the folder means no
# splash is reproducible for anyone but whoever generated it. Two people running
# `cap add android` get different native projects, and the branded splash silently
# reverts to Capacitor's default.
#
# `ios/` stays ignored because there is no iOS project and none can be built or
# verified from this machine (macOS + Xcode only). Un-ignore it when one exists.
#
# WHAT IS STILL EXCLUDED, and why — a tracked native folder does not mean tracked
# build output or machine-specific state:
#   android/.gradle, android/build, android/app/build
#       Build output and the Gradle cache. Large, and regenerated by every build.
#   android/local.properties
#       Contains an ABSOLUTE path to this machine's SDK. Committing it breaks every
#       other developer and every CI runner. Capacitor and Gradle regenerate it.
#   android/app/src/main/assets/public
#       The built web app, copied in by `cap sync`. It is a build artifact of
#       `npm run build`, not source.
android/*
!android/app/
!android/gradle/
!android/capacitor-cordova-android-plugins/
!android/*.gradle
!android/*.properties
!android/settings.gradle
!android/app/src/
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json
android/.idea/
android/*.iml
android/captures/

ios/

# ── IDE ──────────────────────────────────────────────────────────────────────────
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/

# ── OS ───────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
