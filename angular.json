{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "app": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "www",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "src/assets",
                "output": "assets"
              },
              // Leaflet's default marker/layer sprites. leaflet.css references
              // these by relative URL and the esbuild application builder copies
              // nothing out of node_modules unless a glob says so. Without this
              // the map renders with invisible zoom and attribution controls.
              {
                "glob": "**/*",
                "input": "node_modules/leaflet/dist/images",
                "output": "assets/leaflet"
              }
            ],
            // ORDER IS LOAD-BEARING. Leaflet must come first: the entries below it
            // define global element overrides (ion-card, ion-toolbar, ion-button)
            // that should win specificity ties against Leaflet's own component
            // styles deliberately rather than by accident. Both files land in one
            // concatenated stylesheet, so array order is the only tiebreaker.
            "styles": ["node_modules/leaflet/dist/leaflet.css", "src/theme/variables.scss", "src/global.scss"],
            "scripts": []
          },
          "configurations": {
            "production": {
              // Budget notes. `initial` was 1.7mb/2.5mb against a MEASURED baseline
              // of 1.546mb across 19 initial files — only ~150kb of headroom, which
              // the web fonts and Leaflet's CSS consumed on their own. Raised to
              // 2.2/3.2 so the build still fails loudly rather than being switched
              // off.
              //
              // `anyComponentStyle` was 5kb/8kb. src/theme/variables.scss is EXEMPT
              // from it (it is a global stylesheet, so it counts toward `initial`),
              // which means a token-heavy redesign pushes its growth onto per-
              // component styles instead. cart.page.scss and inventory.page.scss
              // were the two closest to the old 5kb warning.
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2.2mb",
                  "maximumError": "3.2mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "16kb",
                  "maximumError": "24kb"
                }
              ],
              "outputHashing": "all",
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            // The SAFE development configuration, and the one `npm start` uses.
            //
            // It exists because `development` above resolves to `environment.ts`,
            // which hard-codes the production projectId — so plain `npm start`
            // served a fully working admin app backed by the real database. Every
            // control there writes.
            //
            // Swapping in `environment.emulator.ts` is what makes the app connect to
            // the Firestore and Auth emulators that `firebase.json` has been
            // configuring all along. Reachable explicitly as `npm run serve:prod`,
            // because someone occasionally does need to look at real data, and
            // because a deliberately-requested production connection is defensible
            // in a way an accidental one is not.
            "emulator": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.emulator.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "app:build:production"
            },
            "development": {
              "buildTarget": "app:build:development"
            },
            "emulator": {
              "buildTarget": "app:build:emulator"
            },
            // Explicit opt-in to talking to the real project from a dev server.
            "prod": {
              "buildTarget": "app:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  },
  "cli": {
    "analytics": "d4b068be-2c19-4d7a-ba8b-762f814d80c7"
  }
}
